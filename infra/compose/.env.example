# Salin ke .env (di-ignore git). TIDAK ADA SECRET DI FILE INI.
# Secret berada di ../../secrets/*.txt (dev: `make secrets` = gen-secrets.sh + gen-pki.sh; host: scripts/deploy.sh).
# Daftar: scripts/secrets.list.

# ── K25-06: identitas stack (docs/runbooks/multi-env-local.md) ─────────────────────────────────────────────────────
# EFN_STACK = nama project compose + prefix network (<stack>_<network>) + filter discovery Traefik/Promtail + tag image
# lokal default (ghcr.io/<stack>/<svc>:dev). Pola ^[a-z][a-z0-9-]*[a-z0-9]$ (tanpa '_'). Default efn (stack lama).
# Gladi lokal: efn-prod | efn-stg | efn-dev, SATU worktree per stack (secrets/, .env, volume terpisah). Jangan memakai
# `docker compose -p` yang berbeda dari EFN_STACK.
EFN_STACK=efn
# Dua oktet pertama subnet semua network (<base>.0.0/24 .. <base>.12.0/24). Default 172.30. Stack EFN lain / rentang
# 172.16-31 dipakai project lain di host -> mis. 10.250 (prod lokal), 10.251 (stg), 10.252 (dev).
EFN_SUBNET_BASE=172.30
# Port host Traefik publik (default 80/443). Stack EFN kedua yang hidup bersamaan wajib port lain (runbook §6).
# EFN_HTTP_PORT=80
# EFN_HTTPS_PORT=443

TRAEFIK_DOMAIN=efn.local
ACME_EMAIL=ops@example.com

# Image (prod server: deploy.sh menulis IMAGE_<SVC>=ghcr.io/<owner>/<svc>@sha256:<digest> hasil verifikasi cosign).
# Lokal: biarkan tidak diset -> default compose ghcr.io/<EFN_STACK>/<svc>:dev (dev overlay: <EFN_STACK>/<svc>:dev), sehingga
# build di satu stack tidak menimpa image stack lain. Isi hanya untuk memaksa image tertentu (mis. digest rilis).
# IMAGE_POSTGRES=ghcr.io/efn/postgres:dev
# IMAGE_ODOO=ghcr.io/efn/odoo:dev
# IMAGE_API_GATEWAY=ghcr.io/efn/api-gateway:dev
# IMAGE_SUPERAPP_WEB=ghcr.io/efn/superapp-web:dev
# IMAGE_AI_OCR_WORKER=ghcr.io/efn/ai-ocr-worker:dev
# IMAGE_ETL=ghcr.io/efn/etl:dev
# IMAGE_TEXT2SQL=ghcr.io/efn/text2sql:dev
# IMAGE_MINIO=ghcr.io/efn/minio:dev
# IMAGE_METABASE=ghcr.io/efn/metabase:dev
# G42: dashboard Insight (profil data, docs/04 §26)
# IMAGE_INSIGHT_WEB=ghcr.io/efn/insight-web:dev
# G62: halaman masuk staf (profil core, docs/04 §29)
# IMAGE_LOGIN_GATEWAY=ghcr.io/efn/login-gateway:dev
# G41: hanya dipakai overlay docker-compose.esb.yml (belum masuk rantai rilis bertanda tangan)
# IMAGE_ESB_EXTRACT=ghcr.io/efn/esb-extract:dev
# G43: esb-migrate (overlay docker-compose.esb.yml, profil migrate; sekali jalan, tidak di rantai rilis deploy)
# IMAGE_ESB_MIGRATE=ghcr.io/efn/esb-migrate:dev

# production | staging | dev  (dev override memaksa dev). Nilai selain dev/staging diperlakukan production.
APP_ENV=production
NODE_ENV=production

# Superuser PostgreSQL (hanya socket lokal di container postgres; aplikasi memakai role per service, docs/04 §7.3)
PG_SUPERUSER=postgres
PG_DB=efn_platform
ODOO_DB=efn_odoo

RABBITMQ_ADMIN_USER=efn-admin
# MINIO_ROOT_USER: tidak lagi di .env - access key acak secret minio_root_user (SEC-48)
CLICKHOUSE_USER=efn
GRAFANA_ADMIN_USER=admin

OLLAMA_VISION_MODEL=qwen2.5vl:7b
# G37 (K25-01, docs/04 §22): gateway LLM OCR tahap 2. ollama (default, tanpa egress) | ninerouter | ninerouter_ollama.
# Selain ollama: overlay docker-compose.llm.yml, secret ninerouter_api_key, dan OCR_LLM_CROSS_BORDER_OK=true (DPO, PDP P6).
OCR_LLM_PROVIDER=ollama
OCR_LLM_CROSS_BORDER_OK=false
NINEROUTER_VISION_MODEL=cc/claude-haiku-4-5-20251001
# G38 (docs/04 §23): Tanya Data (Text-to-SQL) di Odoo. Default mati. LLM: ollama (default) | ninerouter | ninerouter_ollama
# (overlay docker-compose.llm-text2sql.yml + TEXT2SQL_CROSS_BORDER_OK=true: teks pertanyaan dikirim ke luar negeri, PDP P7).
TEXT2SQL_ENABLED=false
TEXT2SQL_LLM_PROVIDER=ollama
TEXT2SQL_CROSS_BORDER_OK=false
TEXT2SQL_OLLAMA_MODEL=qwen2.5-coder:7b
TEXT2SQL_NINEROUTER_MODEL=cc/claude-haiku-4-5-20251001
# G39 (docs/04 §24): Analisis bertahap (AI memecah pertanyaan jadi <=3 query + ringkasan). SUMMARY_PROVIDER:
# none (tanpa ringkasan, hasil tidak dikirim ke LLM) | ollama | ninerouter | ninerouter_ollama (angka hasil agregat
# dikirim ke luar negeri, PDP P8: wajib TEXT2SQL_AGENT_RESULTS_CROSS_BORDER_OK=true; production ditolak, Q-T7).
TEXT2SQL_AGENT_ENABLED=false
TEXT2SQL_AGENT_SUMMARY_PROVIDER=none
TEXT2SQL_AGENT_RESULTS_CROSS_BORDER_OK=false
# G42 (docs/04 §26, ADR-041): dashboard Insight + SSO dari Odoo (menu "Dashboard Insight"). Satu saklar untuk Odoo dan
# insight-web. false = Odoo menampilkan "Insight belum diaktifkan", insight-web menolak /sso dan semua halaman.
# Production true hanya bila Superadmin mencantumkan INSIGHT_ENABLED di EFN_ALLOW_FEATURE_ON (/etc/efn/deploy.conf;
# L-125: menunggu review security, DPO, Q-INS1/Q-INS4). Runbook: docs/runbooks/insight-web.md.
INSIGHT_ENABLED=false
# G47 (docs/04 §28.13.12): Insight supermarket per persona (token eit2). Odoo + insight-web; hanya "true" persis aktif.
# Syarat production: review security eit2 + row policy, Q-SM29, DPO Q-INS3. Butuh INSIGHT_ENABLED=true juga.
INSIGHT_SM_ENABLED=false
# Odoo: versi token SSO Insight (G52 default 3 = eit3; 2 = rollback eit2; 1 = rollback eit1).
EFN_INSIGHT_TOKEN_VERSION=3
# insight-web: terima token/sesi eit1 lama. Set false setelah semua Odoo menerbitkan eit2 (SEC-G47-02).
INSIGHT_ACCEPT_EIT1=true
# G52 (docs/04 §28.15.10): insight-web terima eit2/eis2 selama rollout; set false setelah Odoo 19.0.3.0.0 di semua env.
INSIGHT_ACCEPT_EIT2=true
# G52: persona F&B (Eksekutif/Toko/Marketing). Odoo + insight-web; hanya "true" persis aktif. Production false sampai
# pemetaan cabang dimuat (Q-INS-F2) + QA + review security G52 lulus.
INSIGHT_FNB_PERSONA_ENABLED=false

# G62 (docs/04 §29, ADR-050): allowlist tujuan redirect login-gateway (URL https absolut, bukan rahasia). Tidak diisi =
# default dari TRAEFIK_DOMAIN (base: tanpa port; dev overlay: :9443). Isi hanya untuk gladi lokal prod di port wg-https
# non-443 (mis. 9443).
# LOGIN_GATEWAY_ERP_URL=https://erp.efn.local:9443/web/login
# LOGIN_GATEWAY_INSIGHT_URL=https://insight.efn.local:9443/

# WhatsApp Cloud API resmi (docs/04 §2). false -> OTP dicetak ke console BFF (dev).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=efn_otp
# Hanya dev (docker-compose.dev.yml): nomor uji yang kode OTP login-nya tampil di aplikasi (docs/04 §3.2 v5.2). Kosong = mati.
DEV_OTP_REVEAL_MEMBERS=
# G27 (docs/04 §18): promo Super-App dari Odoo efn_promo. PROMO_COMPANIES kosong = kanal online pertama.
PROMO_ENABLED=false
PROMO_PUSH_ENABLED=false
PROMO_COMPANIES=
# G31 (docs/04 §20): engine MGM. false = /v1/me/referral 503, tanpa akrual/settle. Angka dari kebijakan Odoo efn_mgm_policy.
MGM_ENABLED=false
MGM_CLAIM_WINDOW_DAYS=30
MGM_SETTLE_INTERVAL_MS=300000

# Backup PostgreSQL (WAL-G -> s3-gateway -> object storage SILO, HTTPS, R-T08, ADR-030)
PG_ARCHIVE_MODE=on
# Dev saja: log statement PostgreSQL (ddl|mod|all). `all` mencetak nilai literal (nomor HP) ke log -> Loki (SEC-72)
PG_LOG_STATEMENT=ddl
# Access key object storage = secret acak (secrets/minio_*_access_key.txt, docs/04 §8.12), bukan env
WALG_S3_PREFIX=s3://pg-backup/efn

# SEC-03: proxy tepercaya BFF. Tidak diset = default compose <EFN_SUBNET_BASE>.1.0/24 (network `internal`, K25-06).
# Prod server: deploy.sh menulis subnet internal + rentang Cloudflare. Mengisi manual = wajib ikut EFN_SUBNET_BASE
# (dicek scripts/check-encryption.sh).
# TRUSTED_PROXIES=172.30.1.0/24

# Payment gateway (docs/04 §8.3/§8.11): mock | disabled | xendit | midtrans. Production WAJIB eksplisit dan menolak mock
# (`disabled` selama vendor belum dipilih). Contoh ini APP_ENV=production -> ganti ke disabled atau set APP_ENV=staging.
PAYMENT_PROVIDER=mock

# Teks consent aktif (docs/04 §8.9). Kosong -> grant consent 503 consent_unavailable. Nilai DRAFT ada di compose dev.
CONSENT_LOCATION_VERSION=
CONSENT_LOCATION_TEXT_SHA256=
# G27 §18.3a: persetujuan Kebijakan Privasi saat masuk/daftar (UU PDP). ENFORCED=true menolak login tanpa centang.
CONSENT_PRIVACY_VERSION=
CONSENT_PRIVACY_TEXT_SHA256=
PRIVACY_CONSENT_ENFORCED=false
CONSENT_MARKETING_VERSION=
CONSENT_MARKETING_TEXT_SHA256=
DSAR_DELETE_GRACE_DAYS=7
# W-18/W-19 (keputusan pemilik proyek 10 Okt 2026, PDP v7; kosong/dihapus = default compose). Rentang validasi deploy:
DSAR_OPEN_ORDER_MAX_DEFER_DAYS=14         # (1..14) batas tunda erasure karena pesanan online terbuka (Q-P18)
ERASURE_SUPPRESSION_DAYS=365              # (0..730) daftar tolak migrasi subjek terhapus (Q-P12; 0 = tidak disimpan)
MEMBER_MIN_AGE=17                         # (17..21) pernyataan usia minimum saat pendaftaran (Q-P3)
PRICE_HUNTER_GEO_RETENTION_DAYS=90        # (1..3650) koordinat laporan Price Hunter di-NULL-kan (Q-P8)

# Bind Traefik (ADR-023). Dev: publik 0.0.0.0:80/443, wg-https 127.0.0.1:9443.
# Prod (ditulis deploy.sh): EFN_PUBLIC_BIND=<IP publik host>, EFN_WG_BIND=10.88.0.1, EFN_WG_HTTPS_PORT=443
EFN_PUBLIC_BIND=0.0.0.0
EFN_WG_BIND=127.0.0.1
EFN_WG_HTTPS_PORT=9443
# Tambahan allowlist internal-only/internal-ops Traefik (dynamic/middlewares.yml). Kosong = 127.0.0.1/32 (base) atau
# 172.16.0.0/12 (dev overlay). Gladi lokal tanpa WireGuard dengan EFN_SUBNET_BASE di luar 172.16/12: subnet network
# edge (hanya Traefik + gateway bridge = sumber koneksi port publish), mis. 10.250.0.0/24 (runbook multi-env-local.md
# §4). JANGAN di server produksi.
# EFN_INTERNAL_EXTRA_CIDR=
# Subnet WireGuard (infra/wireguard/README; SEC-21): outlet -> erp. saja, staf -> erp./bi./ops./status.
EFN_WG_OUTLET_CIDR=10.88.0.0/16
EFN_WG_STAFF_CIDR=10.89.0.0/16
# ACME DNS-01 untuk host internal (service acme-dns, SEC-37): provider lego + nama env token (<VAR>_FILE dari secret
# acme_dns_api_token; dev: `disabled` -> acme-dns idle). ACME_SERVER kosong = LE produksi; uji: LE staging.
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_TOKEN_ENV=CF_DNS_API_TOKEN
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Retensi (docs/04 §8.4; W-19 keputusan 10 Okt 2026 untuk ClickHouse/Metabase)
MARKET_SCOUT_PHOTO_RETENTION_DAYS=90
CH_MART_RETENTION_YEARS=10                # (1..30) TTL baris mart ClickHouse
CH_PSEUDONYM_RETENTION_YEARS=5            # (1..CH_MART) TTL kolom pseudonim (user_hash/member_hash/customer_id)
CH_GEO_RETENTION_DAYS=90                  # (1..3650) TTL koordinat competitor_prices
MB_AUDIT_MAX_RETENTION_DAYS=3650          # (30..3650) riwayat query Metabase (Q-P14)

# Direktori host untuk textfile collector node-exporter (metrik backup, restore test, masa berlaku sertifikat)
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/efn/node-exporter

# R5: job ETL fact_sales_line (Odoo POS -> ClickHouse). Dev override selalu true; prod: deploy.sh otomatis setelah grant
ETL_ENABLE_ODOO=false

# G17 penjualan online Super-App (docs/04 §10.1/§10.13). Kill switch: false = cart/quote/order 503 online_unavailable.
# Production: hanya lewat config rilis bertanda tangan (deploy.yml CFG_ONLINE_*, scripts/lib/deploy-validate.sh);
# ONLINE_ENABLED=true di production butuh PAYMENT_PROVIDER xendit|midtrans + API key kanal nyata
# (secrets/odoo_api_key_online_<kanal>.txt, docs/runbooks/odoo-online-api-key.md). Dev/QA: set true di .env lokal
# (BFF dev boleh memakai stub json2 ODOO_ONLINE_MOCK=true - DITOLAK di staging/production).
ONLINE_ENABLED=false
ONLINE_CATALOG_ENABLED=false
# Kanal aktif (G20, docs/04 §12.1: kode kanal = kode PT, koma): GL,PB,BCR,BCF,WTZ (WTZ = PT Wetzel's Pretzels, G24 §16.1,
# mati default). Kode lama RTL/FNB dan kanal G19
# berhifen (RTL-GL, RTL-BACHA, FNB-PB, FNB-BACHA) DITOLAK deploy-validate. GL di-mount compose base; PB/BCR/BCF/WTZ ->
# deploy.sh menyertakan docker-compose.online-<kode huruf kecil>.yml (secret secrets/odoo_api_key_online_<kode>.txt).
# Dev: kanal selain GL butuh overlay ikut di `-f` + key nyata.
ONLINE_CHANNELS=GL
# pickup saja di pilot (delivery -> 422 fulfilment_unavailable)
ONLINE_FULFILMENTS=pickup
# Angka PLACEHOLDER pilot (Q-ON*); kosong/dihapus = default compose. Batas validasi deploy di kurung.
# G19 W-02: reservasi stok 1 jam. URUTAN: payment_timeout_minutes kanal Odoo 70 DULU, baru BFF 3600
# (docs/runbooks/online-orders.md#aktivasi-reservasi-1-jam). Odoo payment_timeout_minutes harus >= ini/60 + 10.
ONLINE_PAYMENT_TIMEOUT_SECONDS=3600       # (60..3600)
ONLINE_QUOTE_TTL_SECONDS=600              # (60..1800; BFF menolak > 1800)
ONLINE_MAX_OPEN_ORDERS_PER_MEMBER=2       # (1..20) L-32: 2 sejak reservasi aktif
ONLINE_MAX_OPEN_COUNTER_ORDERS_PER_MEMBER=1  # (1..10, <= ONLINE_MAX_OPEN_ORDERS_PER_MEMBER) G20 W-30: order "bayar di kasir" terbuka per member (§12.2)
ONLINE_PAYMENT_METHODS=qris,bank_transfer  # G26 L-95/L-103: pesanan online wajib bayar dulu; production tanpa vendor = bank_transfer (+ PAYMENT_PROVIDER=disabled). counter dibekukan (dev: ONLINE_COUNTER_LEGACY=true)
ONLINE_TRANSFER_MAX_UPLOADS=3             # (1..5) G26 §17.4: unggah bukti transfer per pesanan
ONLINE_TRANSFER_MIN_VERIFY_SECONDS=600    # (300..1800, < ONLINE_PAYMENT_TIMEOUT_SECONDS) sisa waktu verifikasi staf
ONLINE_MAX_OPEN_TRANSFER_ORDERS_PER_MEMBER=1  # (1..3) G26 §17.2: pesanan transfer terbuka per member
# G19 W-09: rate limit quote yang membawa kode promo (docs/04 §11.2 no. 6) -> 429 rate_limited
ONLINE_RL_PROMO_MEMBER_LIMIT=10           # per member per jendela
ONLINE_RL_PROMO_MEMBER_WINDOW_SECONDS=900
ONLINE_RL_PROMO_IP_LIMIT=30               # per IP (ter-HMAC) per jendela
ONLINE_RL_PROMO_IP_WINDOW_SECONDS=900
ONLINE_CATALOG_SYNC_SECONDS=300           # (60..86400)
ONLINE_PICKUP_CODE_MAX_DAYS=7             # (1..30) ciphertext kode ambil dihapus setelah ini
# Retensi (L-5; Q-P17 diputuskan 10 Okt 2026)
ONLINE_ORDER_MEMBER_LINK_DAYS=730         # (30..3650)
ONLINE_EVENT_RETENTION_DAYS=180           # (7..3650)
ONLINE_ADMIN_AUDIT_RETENTION_DAYS=3650    # (30..3650) audit CS online; W-19 keputusan Q-P19 (10 th)
# Timeout klien BFF -> odoo-rpc-gateway (1000..30000; gateway memutus di 30 s)
ODOO_RPC_TIMEOUT_MS=8000
# SEC-96 / L-16b: koneksi paralel odoo-rpc-gateway -> Odoo (1..16) = worker HTTP Odoo yang disisihkan untuk online;
# ODOO_WORKERS harus >= kebutuhan POS + nilai ini (docs/runbooks/online-orders.md#sizing-worker).
# Default: dev/base 4; PROD overlay 2 (keputusan pilot opsi B 10 Okt 2026: ODOO_WORKERS 6 = POS 4 + online 2).
ODOO_RPC_MAXCONN=4
# SEC-109 / L-19f: pool konkurensi json2 BFF per replika (1..16): jalur publik (katalog/stok/quote) dan saga.
# Wajib PUBLIC + SAGA <= ODOO_RPC_MAXCONN (deploy-validate). Default dev/base 2 + 2; PROD overlay 1 + 1.
ODOO_RPC_PUBLIC_MAX_CONCURRENCY=2
ODOO_RPC_SAGA_MAX_CONCURRENCY=2
# G18 (docs/04 §9.9 v6): poin = alat bayar
LOYALTY_EARN_EXCLUDE_POINT_PAYMENT=true   # (true|false) K-18-4: porsi bayar poin tidak menghasilkan earn (keputusan final Finance)
LOYALTY_POINT_VALUE_IDR=100               # (1..1000000) nilai 1 poin dalam Rupiah (Q-13, PLACEHOLDER Finance); dipakai BFF + ETL (harus sama)
LOYALTY_RESTORE_TOLERANCE_PCT=10         # (0..50) r11 SEC-118: selisih restore poin vs nilai redeem yang ditoleransi (%)
LOYALTY_COMMITTED_RESERVATION_RETENTION_DAYS=3650  # (3650..7300) r11 SEC-124: reservasi committed = catatan keuangan 10 th
ETL_LOYALTY_POINTS_MODE=payment           # (payment|product) SEC-114: payment = rekonsiliasi harian K-18-6; product hanya data historis (staging/dev), ditolak di production
ETL_AUDIT_EPOCH_ANCHORS=20                # (1..1000) G18: log audit terbaru yang dicek identitasnya saat deteksi restore Odoo
# ETL_AUDIT_EPOCH_AUTO hanya di docker-compose.dev.yml (true); staging/production ditolak deploy-validate
# G21/G22 job ETL opsional (services/etl/README.md; default MATI). Prasyarat (ETL gagal start bila dilanggar; deploy-validate
# menolak kombinasi yang pasti gagal): REGION & KDS butuh ETL_ENABLE_ODOO bukan false + grant terbaru (efn_region /
# efn_pos_kds terpasang); KDS_ONLINE butuh ETL_ENABLE_KDS=true (setelah efn_online_kds_bridge, E-29a); RECON_ONLINE
# butuh ETL_ENABLE_ODOO bukan false + ETL_LOYALTY_POINTS_MODE=payment + view G22.
ETL_PARTNER_REGION_ENABLED=false          # (true|false) G21 customer_region_code di fact_sales_line
ETL_LOYALTY_RECON_ONLINE_ENABLED=false    # (true|false) G22 §14.C.5 rekonsiliasi poin kanal online
ETL_ENABLE_KDS=false                      # (true|false) G22 KPI dapur fact_kds_ticket
ETL_KDS_ONLINE_ENABLED=false              # (true|false) G22 tiket KDS kanal online (efn_online_order_id)
ETL_ENABLE_WASTE=false                    # (true|false) G32 mart waste & yield CK (butuh ETL_ENABLE_ODOO + efn_ck_production)
ETL_ENABLE_FORECAST=false                 # (true|false) G44 mart forecast (butuh ETL_ENABLE_ODOO + efn_demand_forecast v2)
ETL_ENABLE_FORECAST_LEGACY=false          # (true|false) G46 histori penjualan ESB -> input forecast (butuh ETL_ENABLE_FORECAST + efn_legacy_history)
ETL_FORECAST_ACCURACY_WEEKS=2             # (1..12) G44/G51 minggu akurasi forecast dihitung ulang; demo histori as-of A6 = 8
ETL_FORECAST_ACCURACY_INTERVAL_SECONDS=86400  # (900..604800) G44 interval hitung ulang akurasi; demo A6 sementara 900
ETL_SM_FILL_RECALC_DAYS=14                # (1..120) jendela hitung ulang fill rate DC (delivery_date); demo seed G51 90 hari = 90
ETL_SM_STOCK_RECONSTRUCT_DAYS=0           # (0..400) G51 B6 rekonstruksi stok harian historis dari stock_move; 0 = mati, demo 90 (butuh ETL_ENABLE_SM)

# ── G41 (docs/04 §25, ADR-040): ekstraksi ESB Core -> ClickHouse (overlay docker-compose.esb.yml) ─────────────────────
# Runbook: docs/runbooks/esb-extract.md. Password API per brand = secrets/esb_core_password_<brand>.txt (diisi operator);
# false = service idle tanpa memanggil ESB.
ESB_ENABLED=false
ESB_BRANDS=pb                             # brand aktif, koma: pb,wtz,bacha,imd,cup (hanya yang secret-nya sudah diisi)
# SEC-180: username API ESB per brand. JANGAN diisi di file ini (repo publik; akun saat ini berhak admin, Q-ESB1).
# Isi hanya di infra/compose/.env lokal (gitignored) / config rilis. Kosong + brand ada di ESB_BRANDS = gagal start.
# Dicek scripts/check-encryption.sh (nilai di .env.example wajib kosong).
ESB_USER_PB=
ESB_USER_WTZ=
ESB_USER_BACHA=
ESB_USER_IMD=
ESB_USER_CUP=
ESB_RATE_PER_SEC=2.0                      # token bucket per brand (panggilan/detik ke API produksi ESB)
ESB_WORKERS=4                             # panggilan paralel per brand
ESB_MAX_CALLS_PER_RUN=20000               # rem darurat per run (incremental/backfill)
ESB_BACKFILL_WINDOW=22:00-05:00           # jendela backfill WIB (di luar ini backfill menunggu, kecuali --ignore-window)
ESB_INTERVAL_SECONDS=3600                 # loop incremental (master harian + H-1 + koreksi H-7)
ESB_CK_BRANCHES=pb:4|38,wtz:5|6,imd:2,cup:4|6   # cabang Central Kitchen per brand (brand:id|id,brand:id; G43)
# Override PT per cabang (kosong = default PT brand ESB_COMPANY_BACHA). G43: Bacha cabang 6 = BCR -> isi
# `bacha:6=BCR` setelah klien mengonfirmasi; cabang 10 menunggu Q-ESB10 (jangan ditebak).
ESB_BRANCH_COMPANY_OVERRIDES=
# Cabang non-toko tambahan per brand (format sama ESB_CK_BRANCHES: brand:id|id;...; kosong = hanya kata kunci nama di kode)
ESB_NON_STORE_BRANCHES=
ESB_ENTITIES=branch,master,sales,fin_sold,payment,production,delivery,transfer   # entitas yang ditarik
ESB_MAX_RETRIES=5                         # percobaan ulang 429/5xx (cap di kode)
ESB_BACKFILL_MAX_CALLS=60000              # rem darurat per proses backfill
ESB_SALES_READY_HOUR_WIB=3                # penjualan H-1 diambil setelah jam ini (WIB)
ESB_CORRECTION_DAYS=1,7                   # hari koreksi (H-1, H-7)
ESB_GAP_FILL_DAYS=7                       # jangkauan isi celah checkpoint incremental (hari, 1..31)
ESB_BACKFILL_INCLUDE_INACTIVE=true        # (true|false) backfill ikut cabang nonaktif (riwayat)
ESB_HTTP_TIMEOUT_SECONDS=60               # timeout per permintaan HTTP ke ESB
ESB_MAX_PAGES=500                         # batas halaman per endpoint/hari (anti loop paging)
ESB_COMPANY_BACHA=BCF                     # company_code default brand bacha
ESB_MAX_RESPONSE_BYTES=33554432           # SEC-187: batas body respons ESB (byte, 32 MiB)
# SEC-185: true = izinkan --ignore-window di production (hanya rentang <= 1 hari). Default false; kembalikan false setelah uji.
ESB_ALLOW_IGNORE_WINDOW=false

# ── G66 (docs/04 §30.3, ADR-051 Proposed): production planning CK di atas ESB (overlay docker-compose.prodplan.yml) ───────
# Runbook: docs/runbooks/prodplan.md. Default MATI di semua env. Tulis ke ESB PRODUCTION terkunci di kode (L-250), bukan
# di sini. Image belum di rantai rilis (deploy.sh tidak memasang overlay ini).
PRODPLAN_ENABLED=false
PRODPLAN_WRITE_ENABLED=false                # true = posting ke ESB (hanya staging sampai ADR-051 Accepted + Q-PP1)
INSIGHT_PRODPLAN_ENABLED=false              # halaman /produksi di insight-web (hanya "true" persis)
PRODPLAN_ESB_BASE_URL=https://stg7.esb.co.id/core-stg   # atau https://services.esb.co.id/core (nilai lain = exit 2)
PRODPLAN_ESB_MFG_MODE=actual                # actual | standard (Q-PP3)
PRODPLAN_BRANDS=pb                          # v1 hanya pb diuji
# SEC-180: username API ESB prodplan. JANGAN diisi di file ini; hanya di infra/compose/.env lokal / config rilis.
PRODPLAN_ESB_USER_PB=
# Sumber file secret esb_prodplan_password_pb (kosong = ../../secrets/esb_prodplan_password_pb.txt). Dev dengan ESB
# staging boleh menunjuk file password staging yang sudah ada, mis. ../../secrets/esb_core_password_stg.txt.
# PRODPLAN_ESB_PASSWORD_PB_SECRET_FILE=
PRODPLAN_CK_BRANCHES=pb:4=7                 # brand:branch=locationProduksi[|...];...
PRODPLAN_SOURCE_LOCATIONS=                  # brand:branch=loc|loc;branch=loc (Q-PP6); kosong = tanpa usulan transfer
PRODPLAN_APPLY_YIELD=false                  # Q-PP5
PRODPLAN_STOCK_MAX_AGE_MINUTES=30           # 5..240
PRODPLAN_POST_MAX_DOCS=60                   # 1..200
PRODPLAN_POST_DATE_WINDOW_DAYS=-1,7
PRODPLAN_ESB_RATE_PER_SEC=2.0               # 0.2..4 per brand
PRODPLAN_JOB_MAX_CALLS=2000
PRODPLAN_ESB_TIMEOUT_SECONDS=30
PRODPLAN_ESB_MAX_RESPONSE_BYTES=16777216
PRODPLAN_OUTBOX_POLL_SECONDS=10
PRODPLAN_RECONCILE_GRACE_SECONDS=300
PRODPLAN_RETENTION_DAYS=730                 # 400..1825
# IMAGE_PRODPLAN=ghcr.io/efn/prodplan:dev

# ── G44 (docs/04 §28.2/§28.10, ADR-046): forecast-worker (overlay docker-compose.forecast.yml) ─────────────────────────
# Runbook: docs/runbooks/forecast-worker.md. Secret: odoo_api_key_forecast_smd (dibuat di Odoo), tls_forecast_worker_*,
# clickhouse_password_forecast. false = service idle tanpa memanggil ClickHouse/Odoo (default SEMUA env, §28.10).
FORECAST_ENABLED=false
FORECAST_DAILY_CRON="30 23 * * *"         # cron 5 kolom (zona FORECAST_TZ): setelah tutup toko (ADR-046 §3.1)
FORECAST_TZ=Asia/Jakarta
FORECAST_HORIZON_DAYS=28
FORECAST_CHUNK_SIZE=500                   # <= 500 baris per panggilan RPC (§28.2)
FORECAST_ODOO_RPC_TIMEOUT_SECONDS=25      # < timeout gateway 30 s
FORECAST_MEMORY_LIMIT=1536M               # K25-06: dev/staging dengan data demo kecil boleh 768M
FORECAST_CPUS=2
# SEC-215: user ClickHouse efn_forecast_reader hanya login dari subnet ini (= ipam network forecast-ch di overlay).
# Tidak diset = default compose <EFN_SUBNET_BASE>.11.0/24 (K25-06). Mengisi manual = wajib sama dengan subnet forecast-ch
# (dicek scripts/check-encryption.sh).
# CH_FORECAST_READER_HOST_CIDR=172.30.11.0/24
# Staging/prod: diisi deploy.sh dari manifest rilis bertanda tangan (digest, SEC-42); overlay ikut otomatis bila
# FORECAST_ENABLED=true (deploy.sh). Lokal: tidak diset = ghcr.io/<EFN_STACK>/forecast-worker:dev (K25-06).
# IMAGE_FORECAST_WORKER=ghcr.io/efn/forecast-worker:dev

# ── G50 (docs/04 §28.6-§28.10; ADR-044/047/048 Proposed): kampanye supermarket ─────────────────────────────────────────
# Runbook: docs/runbooks/supermarket-campaign-channels.md. SEMUA flag default false di semua env. Production:
# BEHAVIOR_TRACKING_ENABLED / PROMO_CAMPAIGN_ENABLED / WA_UNOFFICIAL_ENABLED OFF; true ditolak deploy-validate tanpa ref
# persetujuan di bawah DAN izin Superadmin (EFN_ALLOW_FEATURE_ON di /etc/efn/deploy.conf). Ref = nomor dokumen
# persetujuan (bukan isi dokumen), pola ^[A-Za-z0-9._/-]{3,64}$.
BEHAVIOR_TRACKING_ENABLED=false
BEHAVIOR_TRACKING_DPO_APPROVAL_REF=        # DPO: dasar hukum, teks banner, DPIA, retensi (Q-SM16/17/26)
CONSENT_TRACKING_VERSION=                  # versi teks consent tracking aktif (mis. tracking@2026-11-20)
CONSENT_TRACKING_TEXT_SHA256=              # sha256 UTF-8 body teks consent tracking (hex 64)
BEHAVIOR_EVENT_RETENTION_DAYS=7            # (1..7) staging event PG (L-153)
WISHLIST_ENABLED=false
RESTOCK_ALERT_ENABLED=false
PRICE_ALERT_ENABLED=false
ALERT_WATCH_INTERVAL_SECONDS=300           # (60..86400)
PROMO_CAMPAIGN_ENABLED=false
PROMO_CAMPAIGN_APPROVAL_REF=               # DPO (profiling) + Marketing (approver) + Finance (anggaran voucher)
CAMPAIGN_FREQUENCY_CAP_ENABLED=false       # Q-SM24: default nonaktif
CAMPAIGN_BUDGET_CAP_ENABLED=false
CAMPAIGN_MAX_PER_MEMBER_PER_WEEK=2         # (1..50) bila cap frekuensi aktif
CAMPAIGN_COMPANIES=SMD                     # PT yang outbox kampanyenya diklaim BFF (secret odoo_api_key_campaign_<pt>)
CAMPAIGN_SYNC_SECONDS=60                   # (15..3600)
# Kanal email (ADR-048). Production true butuh penyedia + DPA + SPF/DKIM/DMARC (Q-SM19): deploy-validate menolak tanpa
# EMAIL_DPA_APPROVAL_REF + izin Superadmin EFN_ALLOW_FEATURE_ON (SEC-G50-10). Password SMTP = secret
# secrets/email_smtp_password.txt (host:*), bukan env. Dev: docker-compose.dev.yml mengarahkan ke Mailpit.
EMAIL_ENABLED=false
EMAIL_DPA_APPROVAL_REF=                    # nomor dokumen DPA penyedia SMTP + persetujuan DPO (bukan isi dokumen)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_TLS_MODE=implicit               # implicit|starttls (tanpa mode plaintext)
EMAIL_SMTP_USER=
EMAIL_FROM=
EMAIL_UNSUBSCRIBE_URL=                     # https://<superapp>/berhenti-langganan
EMAIL_RATE_PER_MIN=60
# WA tidak resmi (ADR-044): overlay docker-compose.wa-unofficial.yml + secret nyata (APP_ENV=dev bash scripts/gen-secrets.sh).
WA_UNOFFICIAL_ENABLED=false
WA_UNOFFICIAL_RISK_ACCEPTANCE_REF=         # WAJIB di production: penerimaan risiko tertulis pemilik proyek + Legal (Q-SM14)
# Tidak diset = ghcr.io/<EFN_STACK>/wa-unofficial:dev (K25-06)
# IMAGE_WA_UNOFFICIAL=ghcr.io/efn/wa-unofficial:dev
# ETL perilaku -> ClickHouse (efn_dwh.fact_visitor_event + agregat anonim). Butuh grant platform-behavior-grants.sql.
ETL_ENABLE_BEHAVIOR=false
# segment-worker (overlay docker-compose.segment.yml). Secret odoo_api_key_segment_smd (user teknis efn_segment_smd).
SEGMENT_ENABLED=false
SEGMENT_COMPANIES=SMD
SEGMENT_DAILY_CRON="15 2 * * *"            # setelah agregat ETL (WIB)
SEGMENT_MEMORY_LIMIT=768M
# SEC-215 pola sama (K25-06): user ClickHouse efn_segment_reader hanya login dari subnet network segment-ch.
# Tidak diset = default compose <EFN_SUBNET_BASE>.<oktet segment-ch>.0/24; mengisi manual wajib sama (dicek).
# CH_SEGMENT_READER_HOST_CIDR=
# Tidak diset = ghcr.io/<EFN_STACK>/segment-worker:dev (K25-06)
# IMAGE_SEGMENT_WORKER=ghcr.io/efn/segment-worker:dev
# ── G43 (docs/04 §27, ADR-042): migrasi ESB -> Odoo (esb-migrate profil `migrate` + overlay docker-compose.migration.yml)
# Runbook: docs/runbooks/migrasi-esb-odoo.md. Secret clickhouse_password_mig + migration_bundle_key (host:disabled di
# produksi; diisi operator hanya selama jendela migrasi). Direktori host WAJIB sudah ada (create_host_path: false), di
# disk terenkripsi, mode 0700 milik EFN_MIG_UID:EFN_MIG_GID. Isi bundel = data klien: tidak boleh di repo/tiket/chat.
MIG_EXCHANGE_DIR=/var/lib/efn/migration/exchange   # bundel .efnmig (terenkripsi) + hasil impor + laporan
MIG_MAPS_DIR=/var/lib/efn/migration/maps           # branch_map.csv, uom_map.csv, ... (disetujui klien)
# uid/gid user `odoo` di image Odoo (`docker compose exec odoo id -u` / `id -g`); kosong = 65534 (pertukaran gagal)
EFN_MIG_UID=
EFN_MIG_GID=
EFN_MIG_SALDO_BLOCKED=IMD,CUP             # PT yang langkah saldo awalnya diblokir (PT PB1 baru, docs/04 §27.1)
EFN_MIG_LEGACY_DAYS=400                   # (1..730) histori aliran harian untuk forecast
EFN_MIG_SALES_LINE_MONTHS=24              # (0..24) histori baris transaksi; 0 = tidak dimuat
EFN_MIG_SEGMENT_MAX_ROWS=500000           # (1000..5000000) segmen histori > ini dipecah per gudang
EFN_MIG_USER_LOGIN=efn_migration          # user Odoo teknis migrasi (importer odoo shell)

# ── G22 (docs/04 §14) ──────────────────────────────────────────────────────────────────────────────────────────
# W-07 QR order meja dari ponsel (§14.A.9). Kill switch: false = /v1/fnb/* 503 ordering_unavailable. Production true
# butuh FNB_QR_BASE_URL_<PT> https untuk setiap PT di FNB_QR_COMPANIES + API key user teknis QR nyata
# (secrets/odoo_api_key_qr_<pt>.txt, docs/runbooks/odoo-qr-api-key.md); deploy.sh lalu menyertakan
# docker-compose.online-qr-<pt>.yml. Dev: .env true + `-f docker-compose.online-qr-pb.yml` + key nyata.
FNB_QR_ENABLED=false
FNB_QR_COMPANIES=PB,BCF                   # (PB|BCF, koma, unik) PT F&B yang menerima QR meja
# https://<domain tenant Super-App PT> (tanpa query/fragment/port; BFF menambah /meja#t=)
FNB_QR_BASE_URL_PB=
FNB_QR_BASE_URL_BCF=
FNB_QR_POINTS_ENABLED=false               # (true|false) klaim poin QR oleh member login
FNB_TABLE_SESSION_TTL_SECONDS=14400       # (600..14400) umur token sesi meja, maks 4 jam
FNB_MAX_SUBMISSIONS_PER_SESSION=10        # (1..100)
FNB_MAX_ITEMS_PER_SESSION=150             # (1..1000) jumlah qty per sesi
FNB_MAX_LINES=30                          # (1..30) baris per kiriman (batas keras Odoo 30)
FNB_MAX_LINE_QTY=20                       # (1..20) qty per baris (batas keras Odoo 20)
FNB_CAPTCHA_MODE=off                      # off|first_submit|always (D-22-4: default off)
FNB_MENU_SYNC_SECONDS=300                 # (60..3600) sinkron overlay menu per config
FNB_SESSION_RETENTION_DAYS=180            # (7..395; SEC-176) retensi fnb_* (usulan DPO §14.E.5)
FNB_SESSION_MEMBER_LINK_DAYS=30           # (1..365) tautan member di sesi dilepas N hari setelah tutup

# ── G23 (docs/04 §15) ──────────────────────────────────────────────────────────────────────────────────────────
# W-35 reservasi meja PB & Bacha Coffee F&B (§15.3). Kill switch: false = /v1/booking/* 503 booking_unavailable.
# true butuh API key user teknis reservasi nyata per PT di BOOKING_COMPANIES (secrets/odoo_api_key_booking_<pt>.txt,
# docs/runbooks/odoo-booking-api-key.md) + pengaturan reservasi per outlet di Odoo; deploy.sh lalu menyertakan
# docker-compose.online-booking-<pt>.yml. Dev: .env true + `-f docker-compose.online-booking-pb.yml` + key nyata.
BOOKING_ENABLED=false
BOOKING_COMPANIES=PB,BCF                  # (PB|BCF, koma, unik) PT F&B yang menerima reservasi
BOOKING_MAX_ACTIVE_PER_MEMBER=2           # (1..10) reservasi aktif per member (Q-BK5)
BOOKING_MEMBER_LINK_DAYS=180              # (1..400) tautan member reservasi dilepas N hari setelah selesai
BOOKING_RETENTION_DAYS=400                # (30..3650) retensi baris table_booking
# W-36 pre-order dengan jadwal ambil (§15.4). false = /v1/catalog/slots 503 slots_unavailable dan pickup_slot diabaikan.
# Slot tetap harus diaktifkan per outlet di Odoo (efn_online_slot, field "Pre-order berjadwal").
ONLINE_SLOTS_ENABLED=false
# W-12 poin online (§14.C.1 no. 5): kill switch (prod default false) + flag kanal Odoo
ONLINE_LOYALTY_REDEEM_ENABLED=false
ONLINE_LOYALTY_EARN_ENABLED=false
# W-17 poin hangus 12 bulan tidak aktif (§14.D.8). L-73: production OFF (job & anonimisasi) sampai teks syarat program
# disetujui Legal (Q-F22-4) dan template WA disetujui Meta; true di production ditolak deploy-validate kecuali
# Superadmin mencantumkan nama variabel di EFN_ALLOW_FEATURE_ON (/etc/efn/deploy.conf). Runbook:
# docs/runbooks/loyalty-inactivity-expiry.md. D-22-18: LOYALTY_POINT_EXPIRY_DAYS DIHAPUS (diset = deploy ditolak).
LOYALTY_EXPIRY_ENABLED=false
LOYALTY_EXPIRY_DRY_RUN=true               # (true|false) true = hanya menghitung kandidat per penerbit
LOYALTY_INACTIVITY_EXPIRY_MONTHS=12       # (6..36) fallback bila kebijakan global EFN tidak memuat inactivity_expiry_months
LOYALTY_EXPIRY_NOTICE_DAYS=30             # (7..60) pemberitahuan WA sebelum hangus
LOYALTY_EXPIRY_RUN_HOUR_WIB=1             # (0..23)
LOYALTY_EXPIRY_NOTICE_HOUR_WIB=10         # (0..23)
LOYALTY_EXPIRY_BATCH_SIZE=500             # (1..5000)
LOYALTY_EXPIRY_MAX_PER_RUN=20000          # (1..1000000) kandidat > ini -> run dibatalkan + alert EfnLoyaltyExpiryAborted
# YYYY-MM-DD (go-live, D-22-15); WAJIB bila LOYALTY_EXPIRY_ENABLED=true
LOYALTY_ACTIVITY_EPOCH=
LOYALTY_POINT_MAX_AGE_DAYS=0              # (0..3650) 0 = poin baru tanpa umur maksimum (D-22-18)
LOYALTY_INACTIVE_ANONYMIZE=false          # (true|false) D-22-14 anonimisasi setelah hangus (DPO + Legal)
LOYALTY_INACTIVE_ANONYMIZE_GRACE_DAYS=0   # (0..90)
# SEC-171 (r15): true = notice hangus WA hanya ke member dengan consent `marketing` aktif (member lain tetap mendapat
# info in-app, D.6). false hanya setelah keputusan Legal (dasar hukum + kategori template Meta); production false ditolak
# deploy-validate kecuali Superadmin mencantumkan LOYALTY_EXPIRY_NOTICE_REQUIRE_CONSENT di EFN_ALLOW_FEATURE_ON.
LOYALTY_EXPIRY_NOTICE_REQUIRE_CONSENT=true   # (true|false)

# G21 AC-13 (docs/04 §13.2, ADR-036 §0): enkripsi PII Odoo di staging/production. true = deploy.sh memasang overlay
# docker-compose.pii.yml (kunci odoo_pii_* HANYA ke odoo) setelah memvalidasi ketiga kunci host (bukan placeholder,
# 32 byte, berbeda; docs/runbooks/key-custody.md §4e). Production true wajib EFN_ODOO_PII_REQUIRED=true. Default MATI
# sampai PO menyatakan aktivasi (L-59). Dev tidak memakai ini: docker-compose.dev.yml selalu me-mount kunci dev.
EFN_ODOO_PII_ENABLED=false
# (true|false) kosong = default overlay true
EFN_ODOO_PII_REQUIRED=
