# Salin ke .env (di-ignore git). TIDAK ADA SECRET DI FILE INI.
# Secret berada di ../../secrets/*.txt (dev: `make secrets` = gen-secrets.sh + gen-pki.sh; host: scripts/deploy.sh).
# Daftar: scripts/secrets.list.

TRAEFIK_DOMAIN=efn.local
ACME_EMAIL=ops@example.com

# Image (prod: deploy.sh menulis IMAGE_<SVC>=ghcr.io/<owner>/<svc>@sha256:<digest> hasil verifikasi cosign)
IMAGE_POSTGRES=ghcr.io/efn/postgres:dev
IMAGE_ODOO=ghcr.io/efn/odoo:dev
IMAGE_API_GATEWAY=ghcr.io/efn/api-gateway:dev
IMAGE_SUPERAPP_WEB=ghcr.io/efn/superapp-web:dev
IMAGE_AI_OCR_WORKER=ghcr.io/efn/ai-ocr-worker:dev
IMAGE_ETL=ghcr.io/efn/etl:dev
IMAGE_MINIO=ghcr.io/efn/minio:dev
IMAGE_METABASE=ghcr.io/efn/metabase:dev

# production | staging | dev  (dev override memaksa dev). Nilai selain dev/staging diperlakukan production.
APP_ENV=production
NODE_ENV=production

# Superuser PostgreSQL (hanya socket lokal di container postgres; aplikasi memakai role per service, docs/04 §7.3)
PG_SUPERUSER=postgres
PG_DB=efn_platform
ODOO_DB=efn_odoo

RABBITMQ_ADMIN_USER=efn-admin
# MINIO_ROOT_USER: tidak lagi di .env - access key acak secret minio_root_user (SEC-48)
CLICKHOUSE_USER=efn
GRAFANA_ADMIN_USER=admin

OLLAMA_VISION_MODEL=qwen2.5vl:7b

# WhatsApp Cloud API resmi (docs/04 §2). false -> OTP dicetak ke console BFF (dev).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=efn_otp
# Hanya dev (docker-compose.dev.yml): nomor uji yang kode OTP login-nya tampil di aplikasi (docs/04 §3.2 v5.2). Kosong = mati.
DEV_OTP_REVEAL_MEMBERS=
# G27 (docs/04 §18): promo Super-App dari Odoo efn_promo. PROMO_COMPANIES kosong = kanal online pertama.
PROMO_ENABLED=false
PROMO_PUSH_ENABLED=false
PROMO_COMPANIES=
# G31 (docs/04 §20): engine MGM. false = /v1/me/referral 503, tanpa akrual/settle. Angka dari kebijakan Odoo efn_mgm_policy.
MGM_ENABLED=false
MGM_CLAIM_WINDOW_DAYS=30
MGM_SETTLE_INTERVAL_MS=300000

# Backup PostgreSQL (WAL-G -> s3-gateway -> object storage SILO, HTTPS, R-T08, ADR-030)
PG_ARCHIVE_MODE=on
# Dev saja: log statement PostgreSQL (ddl|mod|all). `all` mencetak nilai literal (nomor HP) ke log -> Loki (SEC-72)
PG_LOG_STATEMENT=ddl
# Access key object storage = secret acak (secrets/minio_*_access_key.txt, docs/04 §8.12), bukan env
WALG_S3_PREFIX=s3://pg-backup/efn

# SEC-03: proxy tepercaya BFF. Dev: subnet network `internal` saja. Prod: deploy.sh menambah rentang Cloudflare.
TRUSTED_PROXIES=172.30.1.0/24

# Payment gateway (docs/04 §8.3/§8.11): mock | disabled | xendit | midtrans. Production WAJIB eksplisit dan menolak mock
# (`disabled` selama vendor belum dipilih). Contoh ini APP_ENV=production -> ganti ke disabled atau set APP_ENV=staging.
PAYMENT_PROVIDER=mock

# Teks consent aktif (docs/04 §8.9). Kosong -> grant consent 503 consent_unavailable. Nilai DRAFT ada di compose dev.
CONSENT_LOCATION_VERSION=
CONSENT_LOCATION_TEXT_SHA256=
# G27 §18.3a: persetujuan Kebijakan Privasi saat masuk/daftar (UU PDP). ENFORCED=true menolak login tanpa centang.
CONSENT_PRIVACY_VERSION=
CONSENT_PRIVACY_TEXT_SHA256=
PRIVACY_CONSENT_ENFORCED=false
CONSENT_MARKETING_VERSION=
CONSENT_MARKETING_TEXT_SHA256=
DSAR_DELETE_GRACE_DAYS=7
# W-18/W-19 (keputusan pemilik proyek 10 Okt 2026, PDP v7; kosong/dihapus = default compose). Rentang validasi deploy:
DSAR_OPEN_ORDER_MAX_DEFER_DAYS=14         # (1..14) batas tunda erasure karena pesanan online terbuka (Q-P18)
ERASURE_SUPPRESSION_DAYS=365              # (0..730) daftar tolak migrasi subjek terhapus (Q-P12; 0 = tidak disimpan)
MEMBER_MIN_AGE=17                         # (17..21) pernyataan usia minimum saat pendaftaran (Q-P3)
PRICE_HUNTER_GEO_RETENTION_DAYS=90        # (1..3650) koordinat laporan Price Hunter di-NULL-kan (Q-P8)

# Bind Traefik (ADR-023). Dev: publik 0.0.0.0:80/443, wg-https 127.0.0.1:9443.
# Prod (ditulis deploy.sh): EFN_PUBLIC_BIND=<IP publik host>, EFN_WG_BIND=10.88.0.1, EFN_WG_HTTPS_PORT=443
EFN_PUBLIC_BIND=0.0.0.0
EFN_WG_BIND=127.0.0.1
EFN_WG_HTTPS_PORT=9443
# Subnet WireGuard (infra/wireguard/README; SEC-21): outlet -> erp. saja, staf -> erp./bi./ops./status.
EFN_WG_OUTLET_CIDR=10.88.0.0/16
EFN_WG_STAFF_CIDR=10.89.0.0/16
# ACME DNS-01 untuk host internal (service acme-dns, SEC-37): provider lego + nama env token (<VAR>_FILE dari secret
# acme_dns_api_token; dev: `disabled` -> acme-dns idle). ACME_SERVER kosong = LE produksi; uji: LE staging.
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_TOKEN_ENV=CF_DNS_API_TOKEN
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Retensi (docs/04 §8.4; W-19 keputusan 10 Okt 2026 untuk ClickHouse/Metabase)
MARKET_SCOUT_PHOTO_RETENTION_DAYS=90
CH_MART_RETENTION_YEARS=10                # (1..30) TTL baris mart ClickHouse
CH_PSEUDONYM_RETENTION_YEARS=5            # (1..CH_MART) TTL kolom pseudonim (user_hash/member_hash/customer_id)
CH_GEO_RETENTION_DAYS=90                  # (1..3650) TTL koordinat competitor_prices
MB_AUDIT_MAX_RETENTION_DAYS=3650          # (30..3650) riwayat query Metabase (Q-P14)

# Direktori host untuk textfile collector node-exporter (metrik backup, restore test, masa berlaku sertifikat)
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/efn/node-exporter

# R5: job ETL fact_sales_line (Odoo POS -> ClickHouse). Dev override selalu true; prod: deploy.sh otomatis setelah grant
ETL_ENABLE_ODOO=false

# G17 penjualan online Super-App (docs/04 §10.1/§10.13). Kill switch: false = cart/quote/order 503 online_unavailable.
# Production: hanya lewat config rilis bertanda tangan (deploy.yml CFG_ONLINE_*, scripts/lib/deploy-validate.sh);
# ONLINE_ENABLED=true di production butuh PAYMENT_PROVIDER xendit|midtrans + API key kanal nyata
# (secrets/odoo_api_key_online_<kanal>.txt, docs/runbooks/odoo-online-api-key.md). Dev/QA: set true di .env lokal
# (BFF dev boleh memakai stub json2 ODOO_ONLINE_MOCK=true - DITOLAK di staging/production).
ONLINE_ENABLED=false
ONLINE_CATALOG_ENABLED=false
# Kanal aktif (G20, docs/04 §12.1: kode kanal = kode PT, koma): GL,PB,BCR,BCF,WTZ (WTZ = PT Wetzel's Pretzels, G24 §16.1,
# mati default). Kode lama RTL/FNB dan kanal G19
# berhifen (RTL-GL, RTL-BACHA, FNB-PB, FNB-BACHA) DITOLAK deploy-validate. GL di-mount compose base; PB/BCR/BCF/WTZ ->
# deploy.sh menyertakan docker-compose.online-<kode huruf kecil>.yml (secret secrets/odoo_api_key_online_<kode>.txt).
# Dev: kanal selain GL butuh overlay ikut di `-f` + key nyata.
ONLINE_CHANNELS=GL
# pickup saja di pilot (delivery -> 422 fulfilment_unavailable)
ONLINE_FULFILMENTS=pickup
# Angka PLACEHOLDER pilot (Q-ON*); kosong/dihapus = default compose. Batas validasi deploy di kurung.
# G19 W-02: reservasi stok 1 jam. URUTAN: payment_timeout_minutes kanal Odoo 70 DULU, baru BFF 3600
# (docs/runbooks/online-orders.md#aktivasi-reservasi-1-jam). Odoo payment_timeout_minutes harus >= ini/60 + 10.
ONLINE_PAYMENT_TIMEOUT_SECONDS=3600       # (60..3600)
ONLINE_QUOTE_TTL_SECONDS=600              # (60..1800; BFF menolak > 1800)
ONLINE_MAX_OPEN_ORDERS_PER_MEMBER=2       # (1..20) L-32: 2 sejak reservasi aktif
ONLINE_MAX_OPEN_COUNTER_ORDERS_PER_MEMBER=1  # (1..10, <= ONLINE_MAX_OPEN_ORDERS_PER_MEMBER) G20 W-30: order "bayar di kasir" terbuka per member (§12.2)
ONLINE_PAYMENT_METHODS=qris,bank_transfer  # G26 L-95/L-103: pesanan online wajib bayar dulu; production tanpa vendor = bank_transfer (+ PAYMENT_PROVIDER=disabled). counter dibekukan (dev: ONLINE_COUNTER_LEGACY=true)
ONLINE_TRANSFER_MAX_UPLOADS=3             # (1..5) G26 §17.4: unggah bukti transfer per pesanan
ONLINE_TRANSFER_MIN_VERIFY_SECONDS=600    # (300..1800, < ONLINE_PAYMENT_TIMEOUT_SECONDS) sisa waktu verifikasi staf
ONLINE_MAX_OPEN_TRANSFER_ORDERS_PER_MEMBER=1  # (1..3) G26 §17.2: pesanan transfer terbuka per member
# G19 W-09: rate limit quote yang membawa kode promo (docs/04 §11.2 no. 6) -> 429 rate_limited
ONLINE_RL_PROMO_MEMBER_LIMIT=10           # per member per jendela
ONLINE_RL_PROMO_MEMBER_WINDOW_SECONDS=900
ONLINE_RL_PROMO_IP_LIMIT=30               # per IP (ter-HMAC) per jendela
ONLINE_RL_PROMO_IP_WINDOW_SECONDS=900
ONLINE_CATALOG_SYNC_SECONDS=300           # (60..86400)
ONLINE_PICKUP_CODE_MAX_DAYS=7             # (1..30) ciphertext kode ambil dihapus setelah ini
# Retensi (L-5; Q-P17 diputuskan 10 Okt 2026)
ONLINE_ORDER_MEMBER_LINK_DAYS=730         # (30..3650)
ONLINE_EVENT_RETENTION_DAYS=180           # (7..3650)
ONLINE_ADMIN_AUDIT_RETENTION_DAYS=3650    # (30..3650) audit CS online; W-19 keputusan Q-P19 (10 th)
# Timeout klien BFF -> odoo-rpc-gateway (1000..30000; gateway memutus di 30 s)
ODOO_RPC_TIMEOUT_MS=8000
# SEC-96 / L-16b: koneksi paralel odoo-rpc-gateway -> Odoo (1..16) = worker HTTP Odoo yang disisihkan untuk online;
# ODOO_WORKERS harus >= kebutuhan POS + nilai ini (docs/runbooks/online-orders.md#sizing-worker).
# Default: dev/base 4; PROD overlay 2 (keputusan pilot opsi B 10 Okt 2026: ODOO_WORKERS 6 = POS 4 + online 2).
ODOO_RPC_MAXCONN=4
# SEC-109 / L-19f: pool konkurensi json2 BFF per replika (1..16): jalur publik (katalog/stok/quote) dan saga.
# Wajib PUBLIC + SAGA <= ODOO_RPC_MAXCONN (deploy-validate). Default dev/base 2 + 2; PROD overlay 1 + 1.
ODOO_RPC_PUBLIC_MAX_CONCURRENCY=2
ODOO_RPC_SAGA_MAX_CONCURRENCY=2
# G18 (docs/04 §9.9 v6): poin = alat bayar
LOYALTY_EARN_EXCLUDE_POINT_PAYMENT=true   # (true|false) K-18-4: porsi bayar poin tidak menghasilkan earn (keputusan final Finance)
LOYALTY_POINT_VALUE_IDR=100               # (1..1000000) nilai 1 poin dalam Rupiah (Q-13, PLACEHOLDER Finance); dipakai BFF + ETL (harus sama)
LOYALTY_RESTORE_TOLERANCE_PCT=10         # (0..50) r11 SEC-118: selisih restore poin vs nilai redeem yang ditoleransi (%)
LOYALTY_COMMITTED_RESERVATION_RETENTION_DAYS=3650  # (3650..7300) r11 SEC-124: reservasi committed = catatan keuangan 10 th
ETL_LOYALTY_POINTS_MODE=payment           # (payment|product) SEC-114: payment = rekonsiliasi harian K-18-6; product hanya data historis (staging/dev), ditolak di production
ETL_AUDIT_EPOCH_ANCHORS=20                # (1..1000) G18: log audit terbaru yang dicek identitasnya saat deteksi restore Odoo
# ETL_AUDIT_EPOCH_AUTO hanya di docker-compose.dev.yml (true); staging/production ditolak deploy-validate
# G21/G22 job ETL opsional (services/etl/README.md; default MATI). Prasyarat (ETL gagal start bila dilanggar; deploy-validate
# menolak kombinasi yang pasti gagal): REGION & KDS butuh ETL_ENABLE_ODOO bukan false + grant terbaru (efn_region /
# efn_pos_kds terpasang); KDS_ONLINE butuh ETL_ENABLE_KDS=true (setelah efn_online_kds_bridge, E-29a); RECON_ONLINE
# butuh ETL_ENABLE_ODOO bukan false + ETL_LOYALTY_POINTS_MODE=payment + view G22.
ETL_PARTNER_REGION_ENABLED=false          # (true|false) G21 customer_region_code di fact_sales_line
ETL_LOYALTY_RECON_ONLINE_ENABLED=false    # (true|false) G22 §14.C.5 rekonsiliasi poin kanal online
ETL_ENABLE_KDS=false                      # (true|false) G22 KPI dapur fact_kds_ticket
ETL_KDS_ONLINE_ENABLED=false              # (true|false) G22 tiket KDS kanal online (efn_online_order_id)

# ── G22 (docs/04 §14) ──────────────────────────────────────────────────────────────────────────────────────────
# W-07 QR order meja dari ponsel (§14.A.9). Kill switch: false = /v1/fnb/* 503 ordering_unavailable. Production true
# butuh FNB_QR_BASE_URL_<PT> https untuk setiap PT di FNB_QR_COMPANIES + API key user teknis QR nyata
# (secrets/odoo_api_key_qr_<pt>.txt, docs/runbooks/odoo-qr-api-key.md); deploy.sh lalu menyertakan
# docker-compose.online-qr-<pt>.yml. Dev: .env true + `-f docker-compose.online-qr-pb.yml` + key nyata.
FNB_QR_ENABLED=false
FNB_QR_COMPANIES=PB,BCF                   # (PB|BCF, koma, unik) PT F&B yang menerima QR meja
# https://<domain tenant Super-App PT> (tanpa query/fragment/port; BFF menambah /meja#t=)
FNB_QR_BASE_URL_PB=
FNB_QR_BASE_URL_BCF=
FNB_QR_POINTS_ENABLED=false               # (true|false) klaim poin QR oleh member login
FNB_TABLE_SESSION_TTL_SECONDS=14400       # (600..14400) umur token sesi meja, maks 4 jam
FNB_MAX_SUBMISSIONS_PER_SESSION=10        # (1..100)
FNB_MAX_ITEMS_PER_SESSION=150             # (1..1000) jumlah qty per sesi
FNB_MAX_LINES=30                          # (1..30) baris per kiriman (batas keras Odoo 30)
FNB_MAX_LINE_QTY=20                       # (1..20) qty per baris (batas keras Odoo 20)
FNB_CAPTCHA_MODE=off                      # off|first_submit|always (D-22-4: default off)
FNB_MENU_SYNC_SECONDS=300                 # (60..3600) sinkron overlay menu per config
FNB_SESSION_RETENTION_DAYS=180            # (7..395; SEC-176) retensi fnb_* (usulan DPO §14.E.5)
FNB_SESSION_MEMBER_LINK_DAYS=30           # (1..365) tautan member di sesi dilepas N hari setelah tutup

# ── G23 (docs/04 §15) ──────────────────────────────────────────────────────────────────────────────────────────
# W-35 reservasi meja PB & Bacha Coffee F&B (§15.3). Kill switch: false = /v1/booking/* 503 booking_unavailable.
# true butuh API key user teknis reservasi nyata per PT di BOOKING_COMPANIES (secrets/odoo_api_key_booking_<pt>.txt,
# docs/runbooks/odoo-booking-api-key.md) + pengaturan reservasi per outlet di Odoo; deploy.sh lalu menyertakan
# docker-compose.online-booking-<pt>.yml. Dev: .env true + `-f docker-compose.online-booking-pb.yml` + key nyata.
BOOKING_ENABLED=false
BOOKING_COMPANIES=PB,BCF                  # (PB|BCF, koma, unik) PT F&B yang menerima reservasi
BOOKING_MAX_ACTIVE_PER_MEMBER=2           # (1..10) reservasi aktif per member (Q-BK5)
BOOKING_MEMBER_LINK_DAYS=180              # (1..400) tautan member reservasi dilepas N hari setelah selesai
BOOKING_RETENTION_DAYS=400                # (30..3650) retensi baris table_booking
# W-36 pre-order dengan jadwal ambil (§15.4). false = /v1/catalog/slots 503 slots_unavailable dan pickup_slot diabaikan.
# Slot tetap harus diaktifkan per outlet di Odoo (efn_online_slot, field "Pre-order berjadwal").
ONLINE_SLOTS_ENABLED=false
# W-12 poin online (§14.C.1 no. 5): kill switch (prod default false) + flag kanal Odoo
ONLINE_LOYALTY_REDEEM_ENABLED=false
ONLINE_LOYALTY_EARN_ENABLED=false
# W-17 poin hangus 12 bulan tidak aktif (§14.D.8). L-73: production OFF (job & anonimisasi) sampai teks syarat program
# disetujui Legal (Q-F22-4) dan template WA disetujui Meta; true di production ditolak deploy-validate kecuali
# Superadmin mencantumkan nama variabel di EFN_ALLOW_FEATURE_ON (/etc/efn/deploy.conf). Runbook:
# docs/runbooks/loyalty-inactivity-expiry.md. D-22-18: LOYALTY_POINT_EXPIRY_DAYS DIHAPUS (diset = deploy ditolak).
LOYALTY_EXPIRY_ENABLED=false
LOYALTY_EXPIRY_DRY_RUN=true               # (true|false) true = hanya menghitung kandidat per penerbit
LOYALTY_INACTIVITY_EXPIRY_MONTHS=12       # (6..36) fallback bila kebijakan global EFN tidak memuat inactivity_expiry_months
LOYALTY_EXPIRY_NOTICE_DAYS=30             # (7..60) pemberitahuan WA sebelum hangus
LOYALTY_EXPIRY_RUN_HOUR_WIB=1             # (0..23)
LOYALTY_EXPIRY_NOTICE_HOUR_WIB=10         # (0..23)
LOYALTY_EXPIRY_BATCH_SIZE=500             # (1..5000)
LOYALTY_EXPIRY_MAX_PER_RUN=20000          # (1..1000000) kandidat > ini -> run dibatalkan + alert EfnLoyaltyExpiryAborted
# YYYY-MM-DD (go-live, D-22-15); WAJIB bila LOYALTY_EXPIRY_ENABLED=true
LOYALTY_ACTIVITY_EPOCH=
LOYALTY_POINT_MAX_AGE_DAYS=0              # (0..3650) 0 = poin baru tanpa umur maksimum (D-22-18)
LOYALTY_INACTIVE_ANONYMIZE=false          # (true|false) D-22-14 anonimisasi setelah hangus (DPO + Legal)
LOYALTY_INACTIVE_ANONYMIZE_GRACE_DAYS=0   # (0..90)
# SEC-171 (r15): true = notice hangus WA hanya ke member dengan consent `marketing` aktif (member lain tetap mendapat
# info in-app, D.6). false hanya setelah keputusan Legal (dasar hukum + kategori template Meta); production false ditolak
# deploy-validate kecuali Superadmin mencantumkan LOYALTY_EXPIRY_NOTICE_REQUIRE_CONSENT di EFN_ALLOW_FEATURE_ON.
LOYALTY_EXPIRY_NOTICE_REQUIRE_CONSENT=true   # (true|false)

# G21 AC-13 (docs/04 §13.2, ADR-036 §0): enkripsi PII Odoo di staging/production. true = deploy.sh memasang overlay
# docker-compose.pii.yml (kunci odoo_pii_* HANYA ke odoo) setelah memvalidasi ketiga kunci host (bukan placeholder,
# 32 byte, berbeda; docs/runbooks/key-custody.md §4e). Production true wajib EFN_ODOO_PII_REQUIRED=true. Default MATI
# sampai PO menyatakan aktivasi (L-59). Dev tidak memakai ini: docker-compose.dev.yml selalu me-mount kunci dev.
EFN_ODOO_PII_ENABLED=false
# (true|false) kosong = default overlay true
EFN_ODOO_PII_REQUIRED=
