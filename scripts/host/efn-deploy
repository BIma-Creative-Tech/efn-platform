#!/usr/bin/env bash
# efn-deploy - wrapper deploy milik ROOT di host (SEC-36 r3, gelombang 9; SEC-42 r4, gelombang 11; SEC-50 r5, gelombang 13).
#
# DIPASANG MANUAL oleh Superadmin (bukan oleh pipeline) - salinan di repo hanya referensi/sumber review:
#   install -o root -g root -m 0755 scripts/host/efn-deploy /usr/local/sbin/efn-deploy
#   sha256sum /usr/local/sbin/efn-deploy   # bandingkan dengan sha256 di PR yang di-review (runbook key-custody §4a)
# Konfigurasi root-only /etc/efn/deploy.conf (0644/0600 root:root). Semua kunci WAJIB kecuali ditandai opsional:
#   COSIGN_BIN=/usr/local/bin/cosign
#   EFN_SIGNER_IDENTITY_REGEXP='^https://github\.com/<org>/<repo>/\.github/workflows/deploy\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$'
#                                (staging: ...deploy\.yml@refs/heads/main$)
#   EFN_SIGNER_ISSUER=https://token.actions.githubusercontent.com
#   EFN_APP_ENV=production                      (atau staging; harus sama dengan manifest rilis dan APP_ENV)
#   EFN_GITHUB_REPO=<org>/<repo>                (identitas build-push.yml untuk `cosign verify` image di host)
#   EFN_IMAGE_PREFIX=ghcr.io/<org>/             (hanya image dari prefix ini yang diterima; huruf kecil)
#   EFN_PKI_ROOT_SHA256=<64 hex>                (sidik jari SHA-256 root CA, register kunci Superadmin)
#   EFN_PKI_EXTRA_TRUST_SHA256='<hex> <hex>'    (opsional; hanya selama rotasi root CA)
#   SEC-50 - topologi host DIPIN di sini (TIDAK diterima dari stdin; divalidasi scripts/lib/deploy-validate.sh):
#   TRAEFIK_DOMAIN=efn.example                  (wajib)
#   EFN_PUBLIC_BIND=<IPv4 host untuk 80/443>    (wajib; bukan 0.0.0.0/loopback/subnet WG)
#   EFN_WG_BIND=10.88.0.1                       (opsional; IP wg0 di 10.88.0.0/16|10.89.0.0/16; deploy.sh cek wg0)
#   EFN_WG_HTTPS_PORT=443  EFN_WG_OUTLET_CIDR=10.88.0.0/16  EFN_WG_STAFF_CIDR=10.89.0.0/16   (opsional; CIDR di
#                                                dalam 10.88.0.0/15, prefix >= /16)
#   COMPOSE_PROFILES=core,data,ai,observability,ops  (opsional; production wajib memuat core,data,observability)
#   EFN_ALLOW_CONTROL_OFF=''                    (opsional, darurat Superadmin: nama kontrol yang boleh `false` di
#                                                production: RABBITMQ_STRICT_PERMISSIONS ETL_AUDIT_COPY_ENABLED)
# Production saja (SEC-92): /etc/efn/approved-release (root; 0644/0600/0444/0400) baris `<X.Y.Z> <git_sha>` per rilis
#   yang disetujui Superadmin SETELAH memeriksa bahwa commit tag ada di `main` dan CI/Security hijau
#   (docs/runbooks/key-custody.md §4d). Tanda tangan CI saja tidak cukup untuk production.
# sudoers : deploy ALL=(root) NOPASSWD: /usr/local/sbin/efn-deploy        (TANPA argumen, TANPA bash -s)
# authorized_keys user deploy (kunci CI):
#   restrict,command="sudo -n /usr/local/sbin/efn-deploy" ssh-ed25519 AAAA... efn-ci
# User deploy BUKAN anggota grup docker dan tidak bisa menulis /opt/efn (milik root).
#
# Protokol stdin (dibuat .github/workflows/deploy.yml): arsip tar berisi TEPAT tiga file biasa
#   release.tar.gz          infra/ + scripts/ + services/etl/sql/ + efn-release.json dari commit yang di-deploy
#   release.sigstore.json   bundle cosign keyless (sign-blob) atas release.tar.gz oleh workflow deploy.yml
#   env.b64                 baris NAME=<base64 nilai>; NAME hanya GHCR_USER, GHCR_TOKEN, EFN_PKI_* dan secret di
#                           scripts/secrets.list (allowed_names). Nilai tanpa karakter kontrol (PEM: newline saja).
# efn-release.json (manifest, DI DALAM arsip bertanda tangan -> terikat tanda tangan, SEC-42/SEC-50):
#   {"schema":2,"app_env":"production","version":"1.2.3","seq":<github.run_number>,"git_sha":"<40 hex>",
#    "signer_ref":"refs/tags/v1.2.3","images":{"IMAGE_POSTGRES":"ghcr.io/<org>/postgres@sha256:<hex>",...8},
#    "pki":{"root_sha256":"<hex>","extra_trust_sha256":["<hex>",...]},
#    "config":{"PAYMENT_PROVIDER":"disabled","ETL_AUDIT_COPY_ENABLED":"",...}}   (EFN_RELEASE_CONFIG_VARS; "" = default)
#
# Langkah: batasi ukuran -> ekstrak ke tmpfs root 0700 -> cosign verify-blob (identitas dari /etc/efn/deploy.conf,
# BUKAN dari input) -> ekstrak rilis ke direktori sementara milik root -> validasi manifest (app_env, anti-downgrade/
# anti-replay terhadap /var/lib/efn/last-release) -> env tervalidasi (IMAGE_* DITOLAK dari env; diambil dari
# manifest) -> trust anchor PKI dari env dicocokkan dengan sidik jari yang dipin di deploy.conf -> `cosign verify`
# setiap image di host (identitas build-push.yml @ signer_ref manifest) -> baru kemudian sinkron ke /opt/efn,
# catat rilis, exec deploy.sh dari salinan root. Tidak ada yang ditulis ke /opt/efn sebelum SEMUA cek lolos.
#
# Yang dijaga: pemegang kunci SSH deploy saja tidak bisa (a) menjalankan kode selain rilis bertanda tangan,
# (b) mengganti image (registry/digest) di luar manifest bertanda tangan, (c) memasang trust anchor PKI lain,
# (d) memutar ulang rilis lama bertanda tangan (downgrade), (e) mengubah topologi jaringan / mematikan kontrol
# keamanan lewat env non-rahasia (SEC-50: topologi dari deploy.conf, konfigurasi dari manifest). Risiko residu: nilai SECRET dari env tetap tidak
# bertanda tangan (tidak mungkin ditandatangani tanpa membocorkannya ke log transparansi) -> docs/runbooks/key-custody.md.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

MAX_BYTES=$((64 * 1024 * 1024))
BASE=/opt/efn
CONF=/etc/efn/deploy.conf
STATE_DIR=/var/lib/efn
STATE="$STATE_DIR/last-release"
ALLOW_DOWNGRADE=/etc/efn/allow-downgrade
# SEC-92 (r9): persetujuan rilis production out-of-band oleh Superadmin (root, tidak bisa ditulis group/other).
# Satu baris per rilis yang disetujui: `<X.Y.Z> <git_sha 40 hex>`; '#' = komentar. Tidak dihapus setelah dipakai
# (deploy ulang/rollback rilis yang sama tetap boleh). Tanpa file / tanpa baris cocok -> production DITOLAK.
APPROVED_RELEASE=/etc/efn/approved-release
IMAGE_VARS=(IMAGE_POSTGRES IMAGE_ODOO IMAGE_API_GATEWAY IMAGE_SUPERAPP_WEB IMAGE_AI_OCR_WORKER IMAGE_ETL IMAGE_MINIO IMAGE_METABASE)
log() { logger -t efn-deploy -- "$*" 2> /dev/null || true; echo "efn-deploy: $*" >&2; }
die() { log "GAGAL: $*"; exit 1; }

[[ "${EUID}" -eq 0 ]] || die "harus root (sudo -n /usr/local/sbin/efn-deploy)"
for c in jq openssl rsync sha256sum base64 tar sort; do command -v "$c" > /dev/null || die "$c tidak ada di host"; done
[[ -f "$CONF" && ! -L "$CONF" ]] || die "$CONF tidak ada"
[[ "$(stat -c '%u:%a' "$CONF")" =~ ^0:(6[04]4|600|640)$ ]] || die "$CONF harus milik root dan tidak bisa ditulis group/other"
COSIGN_BIN="" EFN_SIGNER_IDENTITY_REGEXP="" EFN_SIGNER_ISSUER="" EFN_APP_ENV="" EFN_GITHUB_REPO="" EFN_IMAGE_PREFIX=""
EFN_PKI_ROOT_SHA256="" EFN_PKI_EXTRA_TRUST_SHA256=""
# SEC-50: topologi host dipin di deploy.conf; nilai dari lingkungan pemanggil dibuang (sudo env_reset juga membuangnya)
unset TRAEFIK_DOMAIN EFN_PUBLIC_BIND EFN_WG_BIND EFN_WG_HTTPS_PORT EFN_WG_OUTLET_CIDR EFN_WG_STAFF_CIDR COMPOSE_PROFILES \
  EFN_ALLOW_CONTROL_OFF
while IFS='=' read -r k v; do
  [[ "$k$v" != *[[:cntrl:]]* ]] || die "karakter kontrol di $CONF"
  case "$k" in
    COSIGN_BIN|EFN_SIGNER_IDENTITY_REGEXP|EFN_SIGNER_ISSUER|EFN_APP_ENV|EFN_GITHUB_REPO|EFN_IMAGE_PREFIX|EFN_PKI_ROOT_SHA256|EFN_PKI_EXTRA_TRUST_SHA256)
      v="${v#\'}"; v="${v%\'}"; printf -v "$k" '%s' "$v" ;;
    TRAEFIK_DOMAIN|EFN_PUBLIC_BIND|EFN_WG_BIND|EFN_WG_HTTPS_PORT|EFN_WG_OUTLET_CIDR|EFN_WG_STAFF_CIDR|COMPOSE_PROFILES|EFN_ALLOW_CONTROL_OFF)
      v="${v#\'}"; v="${v%\'}"; printf -v "$k" '%s' "$v"; export "${k?}" ;;
    ''|\#*) ;;
    *) die "kunci tidak dikenal di $CONF: $k" ;;
  esac
done < "$CONF"
[[ -x "$COSIGN_BIN" && "$(stat -c '%u' "$COSIGN_BIN")" == "0" ]] || die "COSIGN_BIN tidak ada / bukan milik root"
[[ -n "$EFN_SIGNER_IDENTITY_REGEXP" && -n "$EFN_SIGNER_ISSUER" ]] || die "identitas penanda tangan belum dikonfigurasi"
[[ "$EFN_APP_ENV" =~ ^(production|staging)$ ]] || die "EFN_APP_ENV di $CONF harus production|staging"
[[ "$EFN_GITHUB_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "EFN_GITHUB_REPO di $CONF tidak valid"
[[ "$EFN_IMAGE_PREFIX" =~ ^[a-z0-9.-]+(:[0-9]+)?/([a-z0-9._-]+/)+$ ]] || die "EFN_IMAGE_PREFIX di $CONF tidak valid (contoh ghcr.io/org/)"
EFN_PKI_ROOT_SHA256="${EFN_PKI_ROOT_SHA256,,}"; EFN_PKI_EXTRA_TRUST_SHA256="${EFN_PKI_EXTRA_TRUST_SHA256,,}"
[[ "$EFN_PKI_ROOT_SHA256" =~ ^[0-9a-f]{64}$ ]] || die "EFN_PKI_ROOT_SHA256 di $CONF wajib (64 hex)"
[[ "$EFN_PKI_EXTRA_TRUST_SHA256" =~ ^([0-9a-f]{64}( |$))*$ ]] || die "EFN_PKI_EXTRA_TRUST_SHA256 di $CONF tidak valid"

WORK=$(mktemp -d /run/efn-deploy.XXXXXX)
REL_TMP=""
cleanup() { rm -rf "$WORK"; [[ -n "$REL_TMP" ]] && rm -rf "$REL_TMP"; return 0; }
trap cleanup EXIT

# ── 1. Terima stdin (dibatasi ukuran) dan periksa isi arsip luar ─────────────────────────────────────────────
head -c "$((MAX_BYTES + 1))" > "$WORK/in.tar"
(( $(stat -c %s "$WORK/in.tar") <= MAX_BYTES )) || die "input > ${MAX_BYTES} byte"
mapfile -t entries < <(tar -tvf "$WORK/in.tar")
[[ ${#entries[@]} -eq 3 ]] || die "arsip harus berisi tepat 3 file"
for e in "${entries[@]}"; do
  [[ "$e" == -* ]] || die "entri bukan file biasa: $e"
done
names=$(tar -tf "$WORK/in.tar" | sort | paste -sd' ')
[[ "$names" == "env.b64 release.sigstore.json release.tar.gz" ]] || die "nama entri tidak sesuai: $names"
mkdir "$WORK/in"
tar -xf "$WORK/in.tar" -C "$WORK/in" --no-same-owner --no-same-permissions

# ── 2. Verifikasi tanda tangan rilis (keyless; identitas dari konfigurasi root) ──────────────────────────────
"$COSIGN_BIN" verify-blob \
  --bundle "$WORK/in/release.sigstore.json" \
  --certificate-identity-regexp "$EFN_SIGNER_IDENTITY_REGEXP" \
  --certificate-oidc-issuer "$EFN_SIGNER_ISSUER" \
  "$WORK/in/release.tar.gz" > /dev/null 2>&1 || die "tanda tangan rilis TIDAK valid (identitas/ref tidak diizinkan)"
SUM=$(sha256sum "$WORK/in/release.tar.gz" | cut -d' ' -f1)
log "rilis terverifikasi sha256=${SUM}"

# ── 3. Ekstrak rilis ke direktori sementara milik root, tolak path aneh ───────────────────────────────────────
while IFS= read -r p; do
  [[ "$p" =~ ^(infra|scripts|services/etl/sql)(/[A-Za-z0-9._@+-]+)*/?$ || "$p" == "efn-release.json" ]] \
    || die "path tidak diizinkan di rilis: $p"
done < <(tar -tzf "$WORK/in/release.tar.gz")
if tar -tvzf "$WORK/in/release.tar.gz" | grep -qvE '^[-d]'; then die "rilis memuat symlink/device"; fi
REL="$BASE/releases/$SUM"
# File konfigurasi di-bind-mount ke container non-root (haproxy, loki, prometheus, ...) -> harus world-readable
# (bukan secret; secret ada di /opt/efn/secrets yang tidak disentuh di sini). Tulis hanya root.
umask 022
install -d -o root -g root -m 0755 "$BASE/releases"
REL_TMP="$REL.tmp"
rm -rf "$REL_TMP"; install -d -o root -g root -m 0755 "$REL_TMP"
tar -xzf "$WORK/in/release.tar.gz" -C "$REL_TMP" --no-same-owner --no-same-permissions
chown -R root:root "$REL_TMP"; chmod -R go-w "$REL_TMP"
umask 077
# SEC-50: aturan validasi konfigurasi dari rilis TERVERIFIKASI (sama dengan yang dipakai deploy.sh)
VALIDATE_LIB="$REL_TMP/scripts/lib/deploy-validate.sh"
[[ -f "$VALIDATE_LIB" && ! -L "$VALIDATE_LIB" ]] || die "rilis tanpa scripts/lib/deploy-validate.sh"
# shellcheck source=scripts/lib/deploy-validate.sh
source "$VALIDATE_LIB"

# ── 4. Manifest rilis bertanda tangan (SEC-42): lingkungan, versi, anti-downgrade ─────────────────────────────
MAN="$REL_TMP/efn-release.json"
[[ -f "$MAN" && ! -L "$MAN" ]] || die "manifest efn-release.json tidak ada di rilis bertanda tangan"
CFG_KEYS_JSON=$(printf '%s\n' "${EFN_RELEASE_CONFIG_VARS[@]}" | jq -R . | jq -sc .)
jq -e --argjson n "${#IMAGE_VARS[@]}" --argjson cfgkeys "$CFG_KEYS_JSON" '
  (.schema == 2) and (.app_env | type == "string") and (.version | type == "string")
  and (.seq | type == "number" and . >= 1 and . == floor) and (.git_sha | test("^[0-9a-f]{40}$"))
  and (.signer_ref | type == "string") and (.images | type == "object" and length == $n)
  and (.pki.root_sha256 | test("^[0-9a-f]{64}$"))
  and (.pki.extra_trust_sha256 | type == "array" and all(test("^[0-9a-f]{64}$")))
  and (.config | type == "object" and ((keys - $cfgkeys) | length == 0)
       and all(.[]; type == "string" and (test("[[:cntrl:]]") | not)))' "$MAN" > /dev/null \
  || die "manifest rilis tidak valid (skema)"
M_ENV=$(jq -r .app_env "$MAN"); M_VER=$(jq -r .version "$MAN"); M_SEQ=$(jq -r .seq "$MAN")
M_REF=$(jq -r .signer_ref "$MAN"); M_GIT=$(jq -r .git_sha "$MAN"); M_ROOT=$(jq -r .pki.root_sha256 "$MAN")
M_EXTRA=$(jq -r '.pki.extra_trust_sha256 | join(" ")' "$MAN")
[[ "$M_ENV" == "$EFN_APP_ENV" ]] || die "manifest untuk ${M_ENV}, host ini ${EFN_APP_ENV}"
[[ "$M_SEQ" =~ ^[0-9]{1,12}$ ]] || die "seq manifest tidak valid"
if [[ "$EFN_APP_ENV" == "production" ]]; then
  [[ "$M_VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$M_REF" == "refs/tags/v${M_VER}" ]] \
    || die "production hanya menerima rilis X.Y.Z dari tag v${M_VER} (dapat ${M_VER} @ ${M_REF})"
else
  [[ ( "$M_VER" =~ ^sha-[0-9a-f]{7}$ && "$M_REF" == "refs/heads/main" ) \
     || ( "$M_VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$M_REF" == "refs/tags/v${M_VER}" ) ]] \
    || die "versi/ref manifest staging tidak valid (${M_VER} @ ${M_REF})"
fi
# Anti-replay/downgrade: seq (github.run_number deploy.yml) monoton naik; rilis yang sama persis (sha256 sama)
# boleh di-deploy ulang. Production: versi semver juga tidak boleh turun. Pengecualian sekali pakai oleh
# Superadmin: /etc/efn/allow-downgrade (root, 0600) berisi sha256 release.tar.gz yang diizinkan; dihapus setelah dipakai.
L_SEQ=0 L_VER="" L_SUM=""
if [[ -f "$STATE" ]]; then
  [[ "$(stat -c '%u' "$STATE")" == 0 ]] || die "$STATE bukan milik root"
  while IFS='=' read -r k v; do
    case "$k" in seq) L_SEQ="$v" ;; version) L_VER="$v" ;; sha256) L_SUM="$v" ;; esac
  done < "$STATE"
  [[ "$L_SEQ" =~ ^[0-9]{1,12}$ ]] || die "$STATE rusak (seq); periksa manual"
fi
downgrade=""
if (( M_SEQ < L_SEQ )); then downgrade="seq ${M_SEQ} < terakhir ${L_SEQ} (replay rilis lama)"
elif (( M_SEQ == L_SEQ )) && [[ -n "$L_SUM" && "$SUM" != "$L_SUM" ]]; then downgrade="seq ${M_SEQ} sama dengan rilis lain"
elif [[ "$EFN_APP_ENV" == "production" && -n "$L_VER" && "$L_VER" != "$M_VER" ]] \
     && [[ "$(printf '%s\n%s\n' "$L_VER" "$M_VER" | sort -V | tail -n1)" == "$L_VER" ]]; then
  downgrade="versi ${M_VER} < terakhir ${L_VER}"
fi
ALLOW_USED=""
if [[ -n "$downgrade" ]]; then
  if [[ -f "$ALLOW_DOWNGRADE" && ! -L "$ALLOW_DOWNGRADE" && "$(stat -c '%u:%a' "$ALLOW_DOWNGRADE")" =~ ^0:(600|400)$ ]] \
     && [[ "$(tr -d ' \r\n' < "$ALLOW_DOWNGRADE")" == "$SUM" ]]; then
    log "PERINGATAN: downgrade diizinkan Superadmin (${ALLOW_DOWNGRADE}): ${downgrade}"
    ALLOW_USED=1
  else
    die "rilis ditolak (anti-downgrade): ${downgrade}"
  fi
fi
# SEC-92: production hanya untuk (versi, SHA commit) yang disetujui Superadmin out-of-band. Menutup tag `v*` dari
# commit di luar `main` yang membawa workflow tanpa gerbang (identitas tanda tangan tetap sah dalam kasus itu).
if [[ "$EFN_APP_ENV" == "production" ]]; then
  [[ -f "$APPROVED_RELEASE" && ! -L "$APPROVED_RELEASE" ]] \
    || die "persetujuan rilis production tidak ada ($APPROVED_RELEASE; Superadmin: key-custody.md §4d)"
  [[ "$(stat -c '%u:%a' "$APPROVED_RELEASE")" =~ ^0:(6[04]4|600|4[04]4|400)$ ]] \
    || die "$APPROVED_RELEASE harus milik root dan tidak bisa ditulis group/other"
  approved=""
  while read -r a_ver a_sha _; do
    [[ -z "$a_ver" || "$a_ver" == \#* ]] && continue
    if [[ "$a_ver" == "$M_VER" && "${a_sha,,}" == "$M_GIT" ]]; then approved=1; break; fi
  done < "$APPROVED_RELEASE"
  [[ -n "$approved" ]] || die "persetujuan rilis production tidak cocok: ${M_VER} @ ${M_GIT} tidak ada di $APPROVED_RELEASE"
  log "rilis ${M_VER} @ ${M_GIT:0:12} disetujui Superadmin ($APPROVED_RELEASE)"
fi

# ── 5. Env tervalidasi (allowlist dari rilis TERVERIFIKASI, bukan dari input) ─────────────────────────────────
# IMAGE_* TIDAK ada di allowlist: image hanya dari manifest bertanda tangan (SEC-42).
# SEC-50: stdin hanya membawa SECRET (+ kredensial pull GHCR dan PKI). APP_ENV, topologi (deploy.conf) dan konfigurasi
# non-rahasia (manifest `config`) DITOLAK dari stdin.
allowed_names() {
  printf '%s\n' GHCR_USER GHCR_TOKEN EFN_PKI_INTERMEDIATE_KEY EFN_PKI_INTERMEDIATE_CRT EFN_PKI_ROOT_CRT EFN_PKI_EXTRA_TRUST
  awk '!/^[[:space:]]*#/ && NF && $2 != "pki" && $2 !~ /^derived:/ { print toupper($1) }' "$REL_TMP/scripts/secrets.list"
}
mapfile -t ALLOWED < <(allowed_names)
declare -A OK=()
for n in "${ALLOWED[@]}"; do [[ "$n" == IMAGE_* ]] || OK["$n"]=1; done
count=0
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" ]] && continue
  [[ "$line" =~ ^([A-Z][A-Z0-9_]{0,63})=([A-Za-z0-9+/]*={0,2})$ ]] || die "baris env tidak valid (#$((count + 1)))"
  name="${BASH_REMATCH[1]}"; b64="${BASH_REMATCH[2]}"
  if [[ "$name" == APP_ENV ]] || efn_list_has "$name" "${EFN_HOST_PINNED_VARS[@]}" "${EFN_RELEASE_CONFIG_VARS[@]}"; then
    die "variabel tidak diizinkan: $name (SEC-50: dipin di $CONF / manifest rilis bertanda tangan, bukan dari stdin)"
  fi
  [[ -n "${OK[$name]:-}" ]] || die "variabel tidak diizinkan: $name"
  val=$(printf '%s' "$b64" | base64 -d) || die "base64 tidak valid: $name"
  # SEC-50b: tanpa karakter kontrol; PEM (EFN_PKI_*) hanya boleh newline. Newline di ujung sudah dibuang $(...).
  if [[ "$name" == EFN_PKI_* ]]; then chk="${val//$'\n'/}"; else chk="$val"; fi
  [[ "$chk" != *[[:cntrl:]]* ]] || die "nilai $name memuat karakter kontrol/multi-baris (ditolak)"
  export "$name=$val"
  count=$((count + 1))
done < "$WORK/in/env.b64"
# APP_ENV = deploy.conf (sudah == manifest app_env, langkah 4)
export APP_ENV="$EFN_APP_ENV"

# ── 5b. Konfigurasi non-rahasia (SEC-50): topologi dari deploy.conf, konfigurasi dari manifest bertanda tangan ──
unset "${EFN_RELEASE_CONFIG_VARS[@]}"
while IFS=$'\t' read -r k v; do
  efn_list_has "$k" "${EFN_RELEASE_CONFIG_VARS[@]}" || die "kunci config manifest tidak dikenal: $k"
  export "$k=$v"
done < <(jq -r '.config | to_entries[] | select(.value != "") | "\(.key)\t\(.value)"' "$MAN")
efn_validate_topology "$EFN_APP_ENV" || die "topologi di $CONF tidak valid (SEC-50)"
efn_validate_config "$EFN_APP_ENV" || die "config manifest rilis tidak valid (SEC-50)"
export EFN_WG_BIND EFN_WG_HTTPS_PORT EFN_WG_OUTLET_CIDR EFN_WG_STAFF_CIDR COMPOSE_PROFILES EFN_ALLOW_CONTROL_OFF
log "topologi (deploy.conf) & config manifest valid: wg ${EFN_WG_BIND}:${EFN_WG_HTTPS_PORT}, profil ${COMPOSE_PROFILES}"

# ── 6. Trust anchor PKI: root & EXTRA_TRUST harus cocok dengan sidik jari yang dipin di deploy.conf ───────────
fp_dir="$WORK/pki"; mkdir -m 0700 "$fp_dir"
split_pem() { # stdin PEM -> file <dir>/<n>.pem; cetak jumlah sertifikat
  awk -v d="$1" '/-----BEGIN CERTIFICATE-----/{n++; f=d "/" n ".pem"} n && f {print > f} /-----END CERTIFICATE-----/{close(f); f=""} END{print n+0}'
}
fp_of() { openssl x509 -in "$1" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':\r\n' | tr 'A-F' 'a-f'; }
mkdir "$fp_dir/root" "$fp_dir/extra"
n=$(printf '%s\n' "${EFN_PKI_ROOT_CRT:-}" | split_pem "$fp_dir/root")
[[ "$n" == 1 ]] || die "EFN_PKI_ROOT_CRT harus berisi tepat 1 sertifikat (dapat ${n})"
ROOT_FP=$(fp_of "$fp_dir/root/1.pem") || die "EFN_PKI_ROOT_CRT bukan sertifikat X.509"
[[ "$ROOT_FP" == "$EFN_PKI_ROOT_SHA256" ]] || die "root CA dari env (${ROOT_FP:0:16}..) != sidik jari dipin di $CONF"
[[ "$M_ROOT" == "$EFN_PKI_ROOT_SHA256" ]] || die "root CA di manifest rilis != sidik jari dipin di $CONF"
printf '%s\n' "${EFN_PKI_INTERMEDIATE_CRT:-}" > "$fp_dir/int.pem"
openssl verify -x509_strict -CAfile "$fp_dir/root/1.pem" "$fp_dir/int.pem" > /dev/null 2>&1 \
  || die "EFN_PKI_INTERMEDIATE_CRT tidak diterbitkan root CA yang dipin"
openssl x509 -in "$fp_dir/int.pem" -noout -ext basicConstraints 2> /dev/null | grep -q 'CA:TRUE' \
  || die "EFN_PKI_INTERMEDIATE_CRT bukan sertifikat CA"
n=$(printf '%s\n' "${EFN_PKI_EXTRA_TRUST:-}" | split_pem "$fp_dir/extra")
if (( n > 0 )); then
  for f in "$fp_dir"/extra/*.pem; do
    fp=$(fp_of "$f") || die "EFN_PKI_EXTRA_TRUST memuat blok bukan sertifikat"
    [[ " $EFN_PKI_EXTRA_TRUST_SHA256 " == *" $fp "* ]] || die "EFN_PKI_EXTRA_TRUST ${fp:0:16}.. tidak dipin di $CONF"
    [[ " $M_EXTRA " == *" $fp "* ]] || die "EFN_PKI_EXTRA_TRUST ${fp:0:16}.. tidak ada di manifest rilis"
  done
elif [[ -n "$(printf '%s' "${EFN_PKI_EXTRA_TRUST:-}" | tr -d '[:space:]')" ]]; then
  die "EFN_PKI_EXTRA_TRUST berisi data bukan PEM sertifikat"
fi
log "trust anchor PKI cocok dengan pin (root ${ROOT_FP:0:16}.., extra ${n})"

# ── 7. Image: hanya dari manifest, prefix registry dikunci, `cosign verify` di host ────────────────────────────
reg_host="${EFN_IMAGE_PREFIX%%/*}"
install -d -m 0700 "$WORK/docker"
if [[ -n "${GHCR_USER:-}" && -n "${GHCR_TOKEN:-}" ]]; then
  # Kredensial pull hanya di tmpfs root (dihapus saat keluar), tidak lewat argv
  printf '{"auths":{"%s":{"auth":"%s"}}}\n' "$reg_host" "$(printf '%s:%s' "$GHCR_USER" "$GHCR_TOKEN" | base64 -w0)" \
    > "$WORK/docker/config.json"
fi
img_identity="https://github.com/${EFN_GITHUB_REPO}/.github/workflows/build-push.yml@${M_REF}"
for v in "${IMAGE_VARS[@]}"; do
  svc="${v#IMAGE_}"; svc="${svc,,}"; svc="${svc//_/-}"
  img=$(jq -r --arg k "$v" '.images[$k] // empty' "$MAN")
  [[ "$img" == "${EFN_IMAGE_PREFIX}${svc}@sha256:"* && "${img#"${EFN_IMAGE_PREFIX}${svc}@"}" =~ ^sha256:[a-f0-9]{64}$ ]] \
    || die "$v di manifest tidak sesuai ${EFN_IMAGE_PREFIX}${svc}@sha256:<64 hex>"
  # SEC-91: image juga diikat ke SHA commit manifest + repo (ekstensi Fulcio GitHub Workflow SHA/Repository).
  DOCKER_CONFIG="$WORK/docker" "$COSIGN_BIN" verify \
    --certificate-identity "$img_identity" \
    --certificate-oidc-issuer "$EFN_SIGNER_ISSUER" \
    --certificate-github-workflow-sha "$M_GIT" \
    --certificate-github-workflow-repository "$EFN_GITHUB_REPO" \
    "$img" > /dev/null 2>&1 || die "cosign verify GAGAL untuk $v (${svc}; identitas build-push.yml@${M_REF}, commit ${M_GIT:0:12})"
  export "$v=$img"
done
log "${#IMAGE_VARS[@]} image terverifikasi cosign di host (build-push.yml@${M_REF})"

# ── 8. Semua cek lolos: pasang rilis, sinkron ke /opt/efn, catat rilis terakhir ────────────────────────────────
umask 022
rm -rf "$REL"; mv "$REL_TMP" "$REL"; REL_TMP=""
# Sinkron ke layout /opt/efn (milik root). File milik host tidak disentuh.
rsync -a --delete --exclude=/secrets/ --exclude=/scripts/ --exclude=/pki-ca/ --exclude=/releases/ \
  --exclude=/etl-sql/ --exclude=/compose/.env --exclude=/compose/docker-compose.host.yml \
  "$REL/infra/" "$BASE/"
rsync -a --delete "$REL/scripts/" "$BASE/scripts/"
if [[ -d "$REL/services/etl/sql" ]]; then rsync -a --delete "$REL/services/etl/sql/" "$BASE/etl-sql/"; fi
chown -R root:root "$BASE/scripts" "$BASE/compose"
# Simpan 5 rilis terakhir
find "$BASE/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | tail -n +6 | cut -d' ' -f2- \
  | xargs -r rm -rf
umask 077
install -d -o root -g root -m 0755 "$STATE_DIR"
printf 'seq=%s\nversion=%s\nsha256=%s\ngit_sha=%s\n' "$M_SEQ" "$M_VER" "$SUM" "$M_GIT" > "$STATE.tmp"
chmod 0600 "$STATE.tmp"; mv -f "$STATE.tmp" "$STATE"
if [[ -n "$ALLOW_USED" ]]; then rm -f "$ALLOW_DOWNGRADE"; fi
export EFN_RELEASE_VERSION="$M_VER" EFN_RELEASE_SEQ="$M_SEQ" EFN_RELEASE_GIT_SHA="$M_GIT" EFN_PKI_ROOT_SHA256
log "env diterima: ${count} variabel; rilis ${M_VER} seq=${M_SEQ} git=${M_GIT:0:12} sha256=${SUM:0:12}; menjalankan deploy.sh"

# ── 9. Jalankan deploy.sh dari salinan milik root ────────────────────────────────────────────────────────────
rm -rf "$WORK"; trap - EXIT
exec /bin/bash "$BASE/scripts/deploy.sh"
