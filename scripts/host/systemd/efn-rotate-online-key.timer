# G19: cek harian semua kanal; skrip hanya merotasi kanal yang sisa masa berlaku key-nya < ROTATE_BEFORE_DAYS (default
# 10 dari 30 hari) -> kegagalan dicoba ulang setiap hari sebelum alert EfnOnlineApiKeyExpiringSoon (< 7 hari).
# Jam 03:15 WIB: di luar jam operasional; recreate BFF singkat per kanal yang dirotasi (checkout bisa 503 beberapa detik).
[Unit]
Description=Jadwal harian rotasi API key Odoo semua kanal online

[Timer]
OnCalendar=*-*-* 03:15:00 Asia/Jakarta
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
