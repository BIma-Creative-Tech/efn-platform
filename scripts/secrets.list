# Daftar tunggal Docker secrets EFN. Dibaca oleh scripts/gen-secrets.sh + scripts/gen-pki.sh (dev/CI),
# scripts/deploy.sh (host) dan .github/workflows/deploy.yml. Tambah secret baru = tambah baris di sini +
# `secrets:` di infra/compose/docker-compose.yml + GitHub Environment secret (nama UPPERCASE).
# CI job `infra` gagal bila daftar ini != secrets top-level compose.
#
# Format: <nama_secret> <generator_dev>
#   random          : openssl rand -base64 36 (password/HMAC key, 48 karakter)
#   hex32           : openssl rand -hex 32 (API key, aman di header; juga password RabbitMQ/Redis/MinIO tanpa simbol)
#   b64key32        : 32 byte acak base64 (kunci libsodium WAL-G, kunci AES-256-GCM PII)
#   akid            : access key ID object storage: 20 karakter [0-9A-F] acak (80 bit; docs/04 §8.12, ADR-030).
#                     Bukan nama mudah ditebak (efn-bff/pgbackup): CVE-2026-41145/40344 cukup butuh access key ID.
#   minio_kms       : "<nama-kunci>:<32 byte base64>" untuk MINIO_KMS_SECRET_KEY_FILE (SSE-S3)
#   literal:<nilai> : nilai placeholder dev (BUKAN rahasia; integrasi dimatikan di dev)
#   pki             : dibuat oleh scripts/gen-pki.sh (bundle CA + sertifikat leaf per service), BUKAN gen-secrets.sh.
#                     Staging/prod: DITERBITKAN DI HOST oleh deploy.sh dari kunci intermediate (GitHub Environment
#                     EFN_PKI_INTERMEDIATE_KEY/_CRT + EFN_PKI_ROOT_CRT) -> TIDAK ada di GitHub Environment.
#   derived:<nama>  : diturunkan scripts/derive-secrets.sh dari secret lain -> TIDAK ada di GitHub Environment.
#   host:<awal>     : DIKELOLA DI HOST (W-11): staging/prod ditulis root di host (efn-rotate-online-key), TIDAK ada di
#                     GitHub Environment dan TIDAK dikirim deploy.yml / diterima efn-deploy; deploy.sh tidak menimpanya
#                     (file belum ada -> diisi <awal>). Dev/CI: gen-secrets.sh menulis <awal> seperti literal.
#
# Pemegang kunci (docs/04 §8.6, docs/runbooks/key-custody.md): baris bertanda [SA] hanya dikelola Superadmin.
#
# ── Superuser / admin (hanya entrypoint, init, ops) ──────────────────────────────
pg_password             random
odoo_admin_password     random
rabbitmq_password       hex32
minio_root_password     random
minio_root_user         akid
clickhouse_password     random
grafana_admin_password  random
# ── Kredensial per service (docs/04 §7.3, SEC-02) ───────────────────────────────
pg_password_odoo        random
pg_password_bff         random
pg_password_ocr         random
pg_password_etl         random
pg_password_metabase    random
pg_password_exporter    random
rabbitmq_password_bff   hex32
rabbitmq_password_ocr   hex32
rabbitmq_password_etl   hex32
redis_password_bff      hex32
redis_password_exporter hex32
minio_bff_secret        hex32
minio_ocr_secret        hex32
minio_prometheus_secret hex32
minio_bff_access_key        akid
minio_ocr_access_key        akid
minio_prometheus_access_key akid
clickhouse_password_etl      random
clickhouse_password_text2sql random
clickhouse_password_metabase random
# ── Kunci aplikasi (docs/04 §2, §7.2) ───────────────────────────────────────────
jwt_secret              random
otp_pepper              random      [SA]
discount_token_secret   random
odoo_bff_api_key        hex32
whatsapp_token          literal:disabled
webhook_payment_secret  random
pii_encryption_key      b64key32    [SA]
altcha_hmac_key         random
# G13: HMAC per baris sink audit Odoo (SEC-51; di-mount odoo + etl saja, >= 32 byte)
efn_audit_sink_key      random      [SA]
# G13: admin Metabase (infra/metabase/provision.py; setup awal otomatis saat deploy)
metabase_admin_password random
# G16b: kunci enkripsi at rest DB aplikasi Metabase (MB_ENCRYPTION_SECRET_KEY, detail koneksi DB; hanya service
# metabase, fail-closed di infra/metabase/efn-entrypoint.sh). Hilang = koneksi ClickHouse harus dibuat ulang (provision).
metabase_encryption_key b64key32    [SA]
# G13 (K-7): endpoint migrasi BFF /internal/v1/migration/* (berbeda dari odoo_bff_api_key; MIGRATION_ENABLED default false)
migration_api_key       hex32
# G17 penjualan online (docs/04 §10.4/§10.5/§10.10): API key Odoo per kanal (user teknis efn_online_<kode>).
# Nilai DIBUAT DI ODOO (res.users.apikeys, 30 hari, W-11) oleh timer host efn-rotate-online-key: dev/CI = placeholder
# `disabled` (BFF memperlakukannya sebagai kanal tidak dikonfigurasi). Pembuatan & rotasi: docs/runbooks/odoo-online-api-key.md
# (R-T15).
# G20 (docs/04 §12.1, L-48): kode kanal = kode PT -> GL (Grand Lucky), PB (Paris Baguette), BCR (Bacha Coffee Retail),
# BCF (Bacha Coffee F&B). Nama = odoo_api_key_online_<kode huruf kecil>, user teknis efn_online_<sama>, env BFF
# ODOO_API_KEY_ONLINE_<KODE>_FILE. `_gl` di-mount compose base (kanal default); pb/bcr/bcf HANYA lewat overlay
# infra/compose/docker-compose.online-<kode>.yml bila kanal ada di ONLINE_CHANNELS (deploy.sh). Kode G17/G19
# (rtl, fnb, rtl_gl, rtl_bacha, fnb_pb, fnb_bacha) DIHAPUS. Kanal baru = baris di sini + compose top-level + overlay +
# allowlist EFN_ONLINE_CHANNEL_CODES (scripts/lib/deploy-validate.sh) + ALLOWED_CHANNELS (scripts/host/efn-rotate-online-key).
odoo_api_key_online_gl  host:disabled
odoo_api_key_online_pb  host:disabled
odoo_api_key_online_bcr host:disabled
odoo_api_key_online_bcf host:disabled
# G17 (L-2): HMAC event Odoo -> BFF (X-EFN-Signature, replay window 300 s); di-mount odoo + api-gateway saja.
odoo_online_event_hmac  random
# G21 (docs/04 §13.1 no. 3, L-61): HMAC publikasi kebijakan poin Odoo -> BFF (PUT /v1/pos/loyalty/policies/..., header
# X-EFN-Signature t=,v1=, replay window 300 s). Di-mount odoo + api-gateway saja (check-encryption.sh). Env:
# Odoo EFN_LOYALTY_POLICY_SIGNING_KEY_FILE, BFF LOYALTY_POLICY_SIGNING_KEY_FILE. Rotasi: docs/runbooks/key-custody.md.
loyalty_policy_signing_key random
# G22 (docs/04 §14.A.2/§14.A.9/§14.E.4, W-07 QR order meja):
#   fnb_table_token_key  : IKM HKDF token sesi meja `fts1.` (HMAC-SHA256). HANYA api-gateway (check-encryption.sh). Env BFF
#                          FNB_TABLE_TOKEN_KEY_FILE. Rotasi: docs/runbooks/fnb-table-token-key.md (token lama mati).
#   odoo_fnb_event_hmac  : HMAC event outbox Odoo -> BFF POST /v1/pos/fnb/events (X-EFN-Signature, replay 300 s). HANYA
#                          odoo + api-gateway. Env Odoo EFN_FNB_EVENT_HMAC_FILE, BFF ODOO_FNB_EVENT_HMAC_FILE.
#   odoo_api_key_qr_<pt> : API key Odoo user teknis QR per PT F&B (efn_qr_pb / efn_qr_bcf, grup
#                          efn_pos_bff_order.group_qr_bff). Pola W-11: DIBUAT DI ODOO oleh efn-rotate-online-key
#                          --channel=QR-<PT> (host:*), mount HANYA lewat overlay docker-compose.online-qr-<pt>.yml saat
#                          FNB_QR_ENABLED=true (deploy.sh). Env BFF ODOO_API_KEY_QR_<PT>_FILE. Runbook odoo-qr-api-key.md.
fnb_table_token_key     random
odoo_fnb_event_hmac     random
odoo_api_key_qr_pb      host:disabled
odoo_api_key_qr_bcf     host:disabled
# G23 (docs/04 §15.3/§15.5, W-35 reservasi meja):
#   odoo_booking_event_hmac : HMAC event outbox reservasi Odoo -> BFF POST /v1/pos/booking/events (X-EFN-Signature,
#                             replay 300 s). HANYA odoo + api-gateway. Env Odoo EFN_BOOKING_EVENT_HMAC_FILE, BFF
#                             ODOO_BOOKING_EVENT_HMAC_FILE. Wajib berbeda dari HMAC online/QR (BFF menolak start).
#   odoo_api_key_booking_<pt> : API key Odoo user teknis reservasi per PT F&B (efn_booking_pb / efn_booking_bcf, grup
#                             efn_table_booking.group_booking_bff, api_key_duration 35 hari). Pola W-11: DIBUAT DI ODOO
#                             oleh efn-rotate-online-key --channel=BOOKING-<PT> (host:*), mount HANYA lewat overlay
#                             docker-compose.online-booking-<pt>.yml saat BOOKING_ENABLED=true (deploy.sh). Env BFF
#                             ODOO_API_KEY_BOOKING_<PT>_FILE. Runbook odoo-booking-api-key.md.
odoo_booking_event_hmac  random
odoo_api_key_booking_pb  host:disabled
odoo_api_key_booking_bcf host:disabled
# G21 E-38a/E-38b (docs/04 §13.2 AC-13, ADR-036 §0): kunci PII Odoo PRODUKSI. host:* = DIBUAT & DISIMPAN DI HOST oleh
# Superadmin (docs/runbooks/key-custody.md §4e, salinan tersegel di brankas Direksi), TIDAK pernah lewat GitHub
# Environment / stdin efn-deploy; deploy.sh tidak menimpanya (belum ada -> `disabled`). Di-mount HANYA ke odoo oleh
# overlay infra/compose/docker-compose.pii.yml saat EFN_ODOO_PII_ENABLED=true (deploy.sh; deploy-validate menolak
# placeholder/kunci tidak valid). Dev/CI: gen-secrets.sh menulis 32 byte acak (bukan `disabled`).
odoo_pii_key_v1         host:disabled   [SA]
odoo_pii_bidx_key       host:disabled   [SA]
odoo_pii_name_key       host:disabled   [SA]
# Hanya di-mount ke api-gateway bila PAYMENT_PROVIDER = xendit|midtrans (docker-compose.payment.yml, docs/04 §8.3);
# GitHub Environment tetap wajib berisi nilai (placeholder `disabled` selama mock/disabled).
payment_provider_api_key literal:disabled
# Token DNS API untuk ACME DNS-01 entrypoint wg-https (ADR-023). SEC-37: token HANYA untuk zona delegasi
# _acme-challenge (DNS:Edit + Zone:Read, IP filtering) - docs/runbooks/acme-dns-token.md.
acme_dns_api_token      literal:disabled
# ── Turunan (scripts/derive-secrets.sh; tidak ada di GitHub Environment) ───────────
member_hash_pepper      derived:member_hash_pepper   [SA]
minio_prometheus_token  derived:minio_prometheus_token
# ── Backup & at-rest (R-T08, §7.2) ──────────────────────────────────────────────
minio_backup_password   random
minio_backup_access_key akid
walg_libsodium_key      b64key32    [SA]
minio_kms_key           minio_kms   [SA]
clickhouse_disk_key     hex32       [SA]
alertmanager_webhook_url literal:http://127.0.0.1:9/disabled
# ── PKI internal (docs/04 §7.1) - scripts/gen-pki.sh ─────────────────────────────
efn_ca_crt                   pki
tls_postgres_crt             pki
tls_postgres_key             pki
tls_redis_crt                pki
tls_redis_key                pki
tls_rabbitmq_crt             pki
tls_rabbitmq_key             pki
tls_minio_crt                pki
tls_minio_key                pki
tls_s3_gateway_crt           pki
tls_s3_gateway_key           pki
tls_clickhouse_crt           pki
tls_clickhouse_key           pki
tls_api_gateway_crt          pki
tls_api_gateway_key          pki
tls_odoo_crt                 pki
tls_odoo_key                 pki
tls_odoo_rpc_gateway_crt     pki
tls_odoo_rpc_gateway_key     pki
tls_superapp_web_crt         pki
tls_superapp_web_key         pki
tls_ollama_crt               pki
tls_ollama_key               pki
tls_metabase_crt             pki
tls_metabase_key             pki
tls_traefik_crt              pki
tls_traefik_key              pki
tls_prometheus_crt           pki
tls_prometheus_key           pki
tls_alertmanager_crt         pki
tls_alertmanager_key         pki
tls_grafana_crt              pki
tls_grafana_key              pki
tls_loki_crt                 pki
tls_loki_key                 pki
tls_promtail_crt             pki
tls_promtail_key             pki
tls_etl_crt                  pki
tls_etl_key                  pki
tls_metabase_provision_crt   pki
tls_metabase_provision_key   pki
tls_uptime_kuma_crt          pki
tls_uptime_kuma_key          pki
tls_node_exporter_crt        pki
tls_node_exporter_key        pki
tls_postgres_exporter_crt    pki
tls_postgres_exporter_key    pki
tls_redis_exporter_crt       pki
tls_redis_exporter_key       pki
tls_blackbox_exporter_crt    pki
tls_blackbox_exporter_key    pki
tls_ocr_worker_crt           pki
tls_ocr_worker_key           pki
tls_cadvisor_crt             pki
tls_cadvisor_key             pki
tls_docker_socket_proxy_crt  pki
tls_docker_socket_proxy_key  pki
