{
  "name": "@efn/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "EFN BFF / API orchestrator (auth, OTP, cart, MGM, price hunter, connectors)",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "amqplib": "^0.10.5",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/amqplib": "^0.10.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "moduleFileExtensions": ["js", "json", "ts"],
    "testEnvironment": "node",
    "clearMocks": true
  },
  "overrides": {
    "@nestjs/platform-fastify": { "fastify": "$fastify" }
  }
}
