<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_efn_online" model="ir.ui.view">
        <field name="name">sale.order.form.efn.online</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="efn_online_order_id" invisible="not efn_online_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
