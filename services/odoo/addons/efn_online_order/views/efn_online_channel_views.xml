<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_online_channel_view_list" model="ir.ui.view">
        <field name="name">efn.online.channel.list</field>
        <field name="model">efn.online.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="brand_code" optional="show"/>
                <field name="pricelist_id"/>
                <field name="stock_check"/>
                <field name="stock_hold_mode" optional="show"/>
                <field name="payment_modes" optional="show"/>
                <field name="payment_timeout_minutes"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="efn_online_channel_view_form" model="ir.ui.view">
        <field name="name">efn.online.channel.form</field>
        <field name="model">efn.online.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Kanal">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="brand_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="pricelist_id"/>
                            <field name="partner_id"/>
                            <field name="team_id"/>
                        </group>
                        <group string="Pembayaran &amp; faktur">
                            <!-- G20 E-45: qris | counter (dipisah koma). -->
                            <field name="payment_modes" placeholder="qris,counter"/>
                            <field name="cash_rounding_id"/>
                            <field name="invoice_on_paid"/>
                            <field name="journal_titipan_id"/>
                            <field name="payment_timeout_minutes"/>
                            <field name="quote_validity_minutes"/>
                            <field name="max_order_amount" required="stock_hold_mode == 'confirm'"/>
                            <!-- G22 W-12 (docs/04 §14.C.1 no. 5): kill switch Poin EFN per kanal. -->
                            <field name="loyalty_earn"/>
                            <field name="loyalty_redeem"/>
                        </group>
                        <group string="Stok">
                            <field name="stock_check"/>
                            <field name="stock_buffer"/>
                            <field name="stock_low_threshold"/>
                            <field name="stock_expose_qty"/>
                            <field name="stock_hold_mode"/>
                        </group>
                        <group string="Pemenuhan &amp; batas">
                            <field name="fulfilment_pickup"/>
                            <field name="fulfilment_delivery"/>
                            <field name="require_outlet_fiscal_position"/>
                            <field name="max_lines"/>
                            <field name="max_qty_per_line"/>
                            <field name="max_line_qty" invisible="stock_hold_mode != 'confirm'"/>
                            <!-- G20 W-33 / E-35b (docs/04 §12.3): batas berat pesanan (0 = mati). -->
                            <field name="max_order_weight_kg"/>
                            <field name="weight_missing_policy" invisible="max_order_weight_kg &lt;= 0"/>
                            <field name="pickup_reminder_hours"/>
                            <field name="pickup_max_attempts"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outlet" name="outlets">
                            <field name="outlet_ids" context="{'active_test': False}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="public_name"/>
                                    <field name="warehouse_id"/>
                                    <field name="fiscal_position_id"/>
                                    <field name="pickup_enabled"/>
                                    <field name="prep_minutes"/>
                                    <field name="resource_calendar_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="User teknis" name="users" groups="base.group_system">
                            <field name="user_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_efn_online_channel" model="ir.actions.act_window">
        <field name="name">Kanal online</field>
        <field name="res_model">efn.online.channel</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
