<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_efn_ic" model="ir.ui.view">
        <field name="name">purchase.order.form.efn.ic</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="efn_ic_company_id" invisible="not efn_ic_company_id"/>
                <field name="efn_ic_sale_name" invisible="not efn_ic_sale_name"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_efn_ic" model="ir.ui.view">
        <field name="name">sale.order.form.efn.ic</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="efn_ic_purchase_name" invisible="not efn_ic_purchase_id" string="PO antar-PT"/>
                <field name="efn_ic_purchase_id" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_efn_ic" model="ir.ui.view">
        <field name="name">account.move.form.efn.ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="efn_ic_source_move_id" invisible="not efn_ic_source_move_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
