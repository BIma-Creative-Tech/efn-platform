<?xml version="1.0" encoding="utf-8"?>
<!-- efn_intercompany (G28): grup user teknis antar-PT. Satu user per PT (Settings > Companies > Antar-PT EFN), hanya
     satu company. Hak: membuat SO (PT penjual) & tagihan vendor (PT pembeli) lewat ACL standar grup yang di-imply. -->
<odoo>
    <record id="res_groups_privilege_efn_ic" model="res.groups.privilege">
        <field name="name">EFN Antar-PT</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_ic_technical" model="res.groups">
        <field name="name">User teknis antar-PT</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_ic"/>
        <field name="comment">Pembuat dokumen lawan antar-PT (SO dari PO, tagihan dari faktur). Bukan untuk orang.</field>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads')),
                                          Command.link(ref('purchase.group_purchase_user')),
                                          Command.link(ref('account.group_account_invoice')),
                                          Command.link(ref('stock.group_stock_user'))]"/>
    </record>
    <data noupdate="1">
        <record id="efn_ic_transfer_price_rule_company" model="ir.rule">
            <field name="name">EFN harga transfer: PT penjual atau pembeli</field>
            <field name="model_id" ref="model_efn_ic_transfer_price"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('buyer_company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
