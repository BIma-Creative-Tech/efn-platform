<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- G36: penyesuaian konsolidasi terlihat bila user punya akses ke salah satu PT-nya; posting/ubah dicek di
             server terhadap SEMUA PT (_efn_check_manager). -->
        <record id="rule_efn_consolidation_adjustment_company" model="ir.rule">
            <field name="name">EFN penyesuaian konsolidasi: PT user</field>
            <field name="model_id" ref="model_efn_consolidation_adjustment"/>
            <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
        </record>
        <record id="rule_efn_consolidation_adjustment_line_company" model="ir.rule">
            <field name="name">EFN baris penyesuaian konsolidasi: PT user</field>
            <field name="model_id" ref="model_efn_consolidation_adjustment_line"/>
            <field name="domain_force">[('adjustment_id.company_ids', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
