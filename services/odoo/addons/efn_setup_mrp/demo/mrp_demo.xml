<?xml version="1.0" encoding="utf-8"?>
<!-- DEMO — memakai produk & company demo efn_kitting (PT EFN F&B Demo Central Kitchen).
     Angka min/max dan umur simpan adalah PLACEHOLDER: menunggu Q-34 (FEFO/expiry/waste) dan
     Q-35 (kapasitas CK, produksi forecast vs pesanan outlet). -->
<odoo>
    <!-- Paket CK: dilacak per lot + tanggal kedaluwarsa, kategori FEFO. -->
    <record id="efn_kitting.product_paket_ayam_geprek" model="product.product">
        <field name="tracking">lot</field>
        <field name="use_expiration_date" eval="True"/>
        <field name="expiration_time">3</field>
        <field name="use_time">2</field>
        <field name="removal_time">1</field>
        <field name="alert_time">1</field>
        <field name="categ_id" ref="product_category_perishable_fefo"/>
    </record>
    <record id="efn_kitting.product_paket_nasi_putih" model="product.product">
        <field name="tracking">lot</field>
        <field name="use_expiration_date" eval="True"/>
        <field name="expiration_time">1</field>
        <field name="use_time">1</field>
        <field name="removal_time">0</field>
        <field name="alert_time">0</field>
        <field name="categ_id" ref="product_category_perishable_fefo"/>
    </record>

    <!-- Reorder rule di gudang CK: stok paket < 20 Porsi -> MO (BoM Manufacture) hingga 100 Porsi.
         Odoo 19: route "Manufacture" (mrp.route_warehouse0_manufacture) adalah route GUDANG
         (product_selectable=False, warehouse_selectable=True); aktif bila warehouse
         manufacture_to_resupply=True (default True). Tidak perlu (dan tidak bisa) dipasang di
         form produk. warehouse_id/location_id dihitung otomatis (precompute) dari company.
         route_id SENGAJA dikosongkan (QA gelombang 4): xmlid route_warehouse0_manufacture terikat ke
         warehouse/company utama, sedangkan orderpoint ini milik company PB -> risiko _check_company.
         Dengan route kosong, Odoo memakai route manufacture gudang company PB (produk punya BoM normal).
         G20 W-32 (docs/04 §12.1): CK tetap di PT Paris Baguette (kode PB, xmlid company_fnb). CK Bacha Coffee F&B
         hanya bila ada (gudang + rute per company BCF; tidak dibuat di demo). -->
    <!-- G17 (load DB with-demo): company PB dari efn_setup_company dibuat SEBELUM stock terpasang,
         sehingga belum punya gudang (stock hanya membuat gudang untuk company pertama,
         res.company.create_missing_warehouse 19.0) -> orderpoint gagal (warehouse_id NOT NULL).
         Gudang Central Kitchen demo dibuat eksplisit dan dipakai orderpoint. Company gudang &amp; orderpoint =
         company produk paket efn_kitting (efn_kitting tidak bergantung efn_setup_company, sehingga
         produknya bisa jatuh ke base.main_company) -> tidak ada crossover company. -->
    <record id="warehouse_ck_demo" model="stock.warehouse">
        <field name="name">Central Kitchen (DEMO)</field>
        <field name="code">CK01</field>
        <field name="company_id" model="product.product"
               eval="obj(ref('efn_kitting.product_paket_ayam_geprek')).company_id.id or ref('base.main_company')"/>
    </record>

    <record id="orderpoint_paket_ayam_geprek_ck" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="efn_kitting.product_paket_ayam_geprek"/>
        <field name="warehouse_id" ref="warehouse_ck_demo"/>
        <field name="company_id" model="product.product"
               eval="obj(ref('efn_kitting.product_paket_ayam_geprek')).company_id.id or ref('base.main_company')"/>
        <field name="product_min_qty">20</field>
        <field name="product_max_qty">100</field>
        <field name="trigger">auto</field>
    </record>
    <record id="orderpoint_paket_nasi_putih_ck" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="efn_kitting.product_paket_nasi_putih"/>
        <field name="warehouse_id" ref="warehouse_ck_demo"/>
        <field name="company_id" model="product.product"
               eval="obj(ref('efn_kitting.product_paket_ayam_geprek')).company_id.id or ref('base.main_company')"/>
        <field name="product_min_qty">20</field>
        <field name="product_max_qty">100</field>
        <field name="trigger">manual</field>
    </record>
</odoo>
