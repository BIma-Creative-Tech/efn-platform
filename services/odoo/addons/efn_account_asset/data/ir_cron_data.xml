<?xml version="1.0" encoding="utf-8"?>
<!-- G57 §1.6 (asal cron_post_depreciation): harian, OdooBot. Posting ke periode terkunci digeser CE ke periode
     terbuka berikutnya -> SOP tutup buku: jalankan posting penyusutan sebelum lock date. -->
<odoo noupdate="1">
    <record id="ir_cron_efn_asset_post_depreciation" model="ir.cron">
        <field name="name">EFN Aset: posting penyusutan jatuh tempo</field>
        <field name="model_id" ref="model_efn_account_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_due_depreciation()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
