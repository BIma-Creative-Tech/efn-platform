<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_asset_group_list" model="ir.ui.view">
        <field name="name">efn.account.asset.group.list</field>
        <field name="model">efn.account.asset.group</field>
        <field name="arch" type="xml">
            <list string="Kelompok Aset">
                <header>
                    <button name="action_efn_reseed" type="object" string="Pasang ulang kategori G61"
                            display="always" groups="efn_account_asset.group_asset_manager"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="default_useful_life_months"/>
                <field name="default_asset_account_id"/>
                <field name="default_depreciation_account_id"/>
                <field name="default_expense_account_id"/>
                <field name="categ_ids" widget="many2many_tags" optional="show"/>
                <field name="auto_create" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_efn_asset_group_form" model="ir.ui.view">
        <field name="name">efn.account.asset.group.form</field>
        <field name="model">efn.account.asset.group</field>
        <field name="arch" type="xml">
            <form string="Kelompok Aset">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="default_useful_life_months"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="default_asset_account_id"/>
                            <field name="default_depreciation_account_id"/>
                            <field name="default_expense_account_id"/>
                            <field name="default_journal_id"/>
                        </group>
                    </group>
                    <group string="Tagihan Vendor -> Draf Aset (G61)">
                        <field name="auto_create"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Default Revaluasi (PSAK 16)">
                        <group>
                            <field name="default_revaluation_surplus_account_id"/>
                            <field name="default_revaluation_income_account_id"/>
                        </group>
                        <group>
                            <field name="default_revaluation_loss_account_id"/>
                            <field name="default_retained_earnings_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_efn_asset_group" model="ir.actions.act_window">
        <field name="name">Kelompok Aset</field>
        <field name="res_model">efn.account.asset.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
