<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_asset_disposal_wizard_form" model="ir.ui.view">
        <field name="name">efn.account.asset.disposal.wizard.form</field>
        <field name="model">efn.account.asset.disposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Disposal Aset">
                <group>
                    <field name="asset_id"/>
                    <field name="net_book_value"/>
                    <field name="disposal_date"/>
                    <field name="disposal_value"/>
                    <field name="gain_loss"/>
                    <field name="surplus_balance" invisible="surplus_balance == 0"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <group string="Jurnal">
                    <field name="create_journal_entry"/>
                    <field name="receivable_account_id" invisible="not create_journal_entry"/>
                    <field name="gain_account_id" invisible="not create_journal_entry"/>
                    <field name="loss_account_id" invisible="not create_journal_entry"/>
                    <field name="surplus_account_id" invisible="not create_journal_entry or surplus_balance == 0"/>
                    <field name="retained_earnings_account_id"
                           invisible="not create_journal_entry or surplus_balance == 0"/>
                </group>
                <group>
                    <field name="note" nolabel="1" colspan="2" placeholder="Catatan disposal..."/>
                </group>
                <footer>
                    <button name="action_dispose" type="object" string="Lepas Aset" class="btn-primary"/>
                    <button special="cancel" string="Batal" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
