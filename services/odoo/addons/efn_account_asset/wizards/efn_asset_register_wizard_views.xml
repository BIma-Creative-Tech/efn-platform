<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_asset_register_wizard_form" model="ir.ui.view">
        <field name="name">efn.account.asset.register.wizard.form</field>
        <field name="model">efn.account.asset.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Daftar Aset">
                <group>
                    <group>
                        <field name="year" options="{'format': false}"/>
                        <field name="asset_states"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="location_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="Cetak PDF" name="action_pdf" type="object" class="btn-primary"/>
                    <button string="Ekspor Excel" name="action_xlsx" type="object" class="btn-secondary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_efn_asset_register_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Daftar Aset</field>
        <field name="res_model">efn.account.asset.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
