<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_asset_post_wizard_form" model="ir.ui.view">
        <field name="name">efn.account.asset.post.wizard.form</field>
        <field name="model">efn.account.asset.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Posting Penyusutan">
                <group>
                    <field name="cutoff_date"/>
                    <field name="group_id"/>
                    <field name="location_id"/>
                    <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_post" type="object" string="Posting Penyusutan" class="btn-primary"/>
                    <button special="cancel" string="Batal" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_efn_asset_post_wizard" model="ir.actions.act_window">
        <field name="name">Posting Penyusutan</field>
        <field name="res_model">efn.account.asset.post.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
