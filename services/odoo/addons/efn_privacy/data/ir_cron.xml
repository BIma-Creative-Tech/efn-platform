<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- docs/04 §8.4: Odoo MENARIK permintaan erasure dari BFF (tidak ada endpoint masuk ke
         Odoo dari luar, SEC-01). Interval 15 menit; user OdooBot (base.user_root). -->
    <record id="ir_cron_efn_privacy_pull_erasures" model="ir.cron">
        <field name="name">EFN Privacy: proses permintaan hapus data (UU PDP)</field>
        <field name="model_id" ref="model_efn_privacy_erasure"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_erasures()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
