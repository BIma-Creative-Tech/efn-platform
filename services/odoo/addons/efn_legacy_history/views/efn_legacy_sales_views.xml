<?xml version="1.0" encoding="utf-8"?>
<!-- G43 (Q-ESB20, docs/04 §27.8 v19.1): histori penjualan ESB read-only. BUKAN pos.order (tidak muncul di laporan
     POS/akuntansi standar). Tanpa tombol tulis. -->
<odoo>
    <!-- ======================================================== penjualan harian per menu -->
    <record id="efn_legacy_sales_daily_view_list" model="ir.ui.view">
        <field name="name">efn.legacy.sales.daily.list</field>
        <field name="model">efn.legacy.sales.daily</field>
        <field name="arch" type="xml">
            <list string="Arsip sistem lama ESB - penjualan harian (bukan transaksi Odoo)" create="0" edit="0" delete="0">
                <field name="day"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="warehouse_id"/>
                <field name="pos_config_id" optional="hide"/>
                <field name="esb_brand" optional="hide"/>
                <field name="esb_menu_code"/>
                <field name="menu_name"/>
                <field name="product_id" optional="hide"/>
                <field name="menu_category" optional="hide"/>
                <field name="is_takeaway" optional="show"/>
                <field name="qty" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="gross" sum="Total" optional="show"/>
                <field name="discount" sum="Total" optional="show"/>
                <field name="net" sum="Total"/>
                <field name="cogs" sum="Total" optional="hide"/>
                <field name="trx_count" sum="Total" optional="show"/>
                <field name="run_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="efn_legacy_sales_daily_view_form" model="ir.ui.view">
        <field name="name">efn.legacy.sales.daily.form</field>
        <field name="model">efn.legacy.sales.daily</field>
        <field name="arch" type="xml">
            <form string="Arsip sistem lama ESB - penjualan harian" create="0" edit="0" delete="0">
                <div class="alert alert-warning mb-0" role="alert">
                    Arsip sistem lama ESB - bukan transaksi Odoo. Tidak memengaruhi stok, pajak, jurnal, atau laporan POS
                    standar. Angka resmi histori = gudang data (Dashboard Insight).
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="day"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="pos_config_id"/>
                            <field name="esb_menu_code"/>
                            <field name="menu_name"/>
                            <field name="menu_category"/>
                            <field name="product_id"/>
                            <field name="is_takeaway"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="qty"/>
                            <field name="gross"/>
                            <field name="discount"/>
                            <field name="net"/>
                            <field name="cogs"/>
                            <field name="trx_count"/>
                            <field name="esb_brand"/>
                            <field name="esb_branch_id"/>
                            <field name="run_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_legacy_sales_daily_view_pivot" model="ir.ui.view">
        <field name="name">efn.legacy.sales.daily.pivot</field>
        <field name="model">efn.legacy.sales.daily</field>
        <field name="arch" type="xml">
            <pivot string="Arsip sistem lama ESB - penjualan harian (bukan transaksi Odoo)" sample="1">
                <field name="warehouse_id" type="row"/>
                <field name="day" interval="month" type="col"/>
                <field name="net" type="measure"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="efn_legacy_sales_daily_view_graph" model="ir.ui.view">
        <field name="name">efn.legacy.sales.daily.graph</field>
        <field name="model">efn.legacy.sales.daily</field>
        <field name="arch" type="xml">
            <graph string="Arsip sistem lama ESB - penjualan harian (bukan transaksi Odoo)" type="bar" sample="1">
                <field name="day" interval="month"/>
                <field name="net" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="efn_legacy_sales_daily_view_search" model="ir.ui.view">
        <field name="name">efn.legacy.sales.daily.search</field>
        <field name="model">efn.legacy.sales.daily</field>
        <field name="arch" type="xml">
            <search>
                <field name="esb_menu_code"/>
                <field name="menu_name"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="esb_brand"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="last_3_months" string="3 bulan terakhir"
                        domain="[('day', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_day" string="Tanggal" date="day"/>
                <separator/>
                <filter name="takeaway" string="Takeaway" domain="[('is_takeaway', '=', True)]"/>
                <filter name="unmapped" string="Belum terpetakan ke produk Odoo" domain="[('product_id', '=', False)]"/>
                <group>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="by_warehouse" string="Outlet" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="by_brand" string="Brand ESB" context="{'group_by': 'esb_brand'}"/>
                    <filter name="by_category" string="Kategori menu" context="{'group_by': 'menu_category'}"/>
                    <filter name="by_menu" string="Menu" context="{'group_by': 'esb_menu_code'}"/>
                    <filter name="by_month" string="Bulan" context="{'group_by': 'day:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_legacy_sales_daily_action" model="ir.actions.act_window">
        <field name="name">Penjualan harian per menu (arsip ESB)</field>
        <field name="res_model">efn.legacy.sales.daily</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_last_3_months': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Belum ada histori penjualan ESB.</p>
            <p>Arsip sistem lama ESB - bukan transaksi Odoo. Diisi skrip migrasi (ADR-042); read-only.</p>
        </field>
    </record>

    <!-- ======================================================== baris penjualan (volume besar) -->
    <record id="efn_legacy_sales_line_view_list" model="ir.ui.view">
        <field name="name">efn.legacy.sales.line.list</field>
        <field name="model">efn.legacy.sales.line</field>
        <field name="arch" type="xml">
            <list string="Arsip sistem lama ESB - baris penjualan (bukan transaksi Odoo)" create="0" edit="0" delete="0"
                  limit="80">
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="warehouse_id"/>
                <field name="sales_num"/>
                <field name="line_no" optional="hide"/>
                <field name="esb_menu_code"/>
                <field name="product_id" optional="show"/>
                <field name="row_type" optional="show"/>
                <field name="is_takeaway" optional="hide"/>
                <field name="qty" sum="Total"/>
                <field name="price" optional="show"/>
                <field name="total" sum="Total"/>
                <field name="discount" sum="Total" optional="show"/>
                <field name="cogs" sum="Total" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="efn_legacy_sales_line_view_form" model="ir.ui.view">
        <field name="name">efn.legacy.sales.line.form</field>
        <field name="model">efn.legacy.sales.line</field>
        <field name="arch" type="xml">
            <form string="Arsip sistem lama ESB - baris penjualan" create="0" edit="0" delete="0">
                <div class="alert alert-warning mb-0" role="alert">
                    Arsip sistem lama ESB - bukan transaksi Odoo. Tidak memengaruhi stok, pajak, jurnal, atau laporan POS
                    standar. Angka resmi histori = gudang data (Dashboard Insight).
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="sales_num"/>
                            <field name="line_no"/>
                            <field name="row_type"/>
                            <field name="is_takeaway"/>
                        </group>
                        <group>
                            <field name="esb_menu_code"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price"/>
                            <field name="total"/>
                            <field name="discount"/>
                            <field name="cogs"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_legacy_sales_line_view_pivot" model="ir.ui.view">
        <field name="name">efn.legacy.sales.line.pivot</field>
        <field name="model">efn.legacy.sales.line</field>
        <field name="arch" type="xml">
            <pivot string="Arsip sistem lama ESB - baris penjualan (bukan transaksi Odoo)">
                <field name="warehouse_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph tersedia tetapi BUKAN default (volume, docs/04 §27.8). -->
    <record id="efn_legacy_sales_line_view_graph" model="ir.ui.view">
        <field name="name">efn.legacy.sales.line.graph</field>
        <field name="model">efn.legacy.sales.line</field>
        <field name="arch" type="xml">
            <graph string="Arsip sistem lama ESB - baris penjualan (bukan transaksi Odoo)" type="bar">
                <field name="date" interval="day"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="efn_legacy_sales_line_view_search" model="ir.ui.view">
        <field name="name">efn.legacy.sales.line.search</field>
        <field name="model">efn.legacy.sales.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="sales_num"/>
                <field name="esb_menu_code"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="last_month" string="Bulan terakhir"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_date" string="Tanggal" date="date"/>
                <separator/>
                <filter name="takeaway" string="Takeaway" domain="[('is_takeaway', '=', True)]"/>
                <filter name="package" string="Paket"
                        domain="[('row_type', 'in', ('PACKAGE_HEADER', 'PACKAGE_COMPONENT'))]"/>
                <filter name="unmapped" string="Belum terpetakan ke produk Odoo" domain="[('product_id', '=', False)]"/>
                <group>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="by_warehouse" string="Outlet" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="by_row_type" string="Jenis baris" context="{'group_by': 'row_type'}"/>
                    <filter name="by_day" string="Hari" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_legacy_sales_line_action" model="ir.actions.act_window">
        <field name="name">Baris penjualan (arsip ESB)</field>
        <field name="res_model">efn.legacy.sales.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_last_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Belum ada baris penjualan ESB.</p>
            <p>Arsip sistem lama ESB - bukan transaksi Odoo. Rentang diatur parameter efn_mig_esb.sales_line_months
                (0 = nonaktif); read-only. Cari per nomor transaksi bersama filter tanggal/outlet.</p>
        </field>
    </record>
</odoo>
