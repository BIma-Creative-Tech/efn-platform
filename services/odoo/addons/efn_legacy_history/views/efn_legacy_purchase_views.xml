<?xml version="1.0" encoding="utf-8"?>
<!-- G65 (docs/04 §27.13.6, fit-gap G65 §1.2): histori baris pembelian ESB read-only. BUKAN purchase.order (tidak
     muncul di purchase.report / laporan pembelian standar, tidak membuat stok/jurnal). Tanpa tombol tulis. -->
<odoo>
    <record id="efn_legacy_purchase_line_view_list" model="ir.ui.view">
        <field name="name">efn.legacy.purchase.line.list</field>
        <field name="model">efn.legacy.purchase.line</field>
        <field name="arch" type="xml">
            <list string="Arsip sistem lama ESB - baris pembelian (bukan transaksi Odoo)" create="0" edit="0" delete="0"
                  limit="80">
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="purchase_num"/>
                <field name="line_no" optional="hide"/>
                <field name="branch_name"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="supplier_name"/>
                <field name="supplier_id" optional="hide"/>
                <field name="esb_product_code"/>
                <field name="product_name"/>
                <field name="product_id" optional="hide"/>
                <field name="category_name" optional="hide"/>
                <field name="uom_name"/>
                <field name="qty" sum="Total"/>
                <field name="receipt_qty" sum="Total" optional="show"/>
                <field name="price_unit"/>
                <field name="discount" optional="hide"/>
                <field name="vat_value" sum="Total" optional="hide"/>
                <field name="total" sum="Total"/>
                <field name="status" optional="show"/>
                <field name="map_source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="efn_legacy_purchase_line_view_form" model="ir.ui.view">
        <field name="name">efn.legacy.purchase.line.form</field>
        <field name="model">efn.legacy.purchase.line</field>
        <field name="arch" type="xml">
            <form string="Arsip sistem lama ESB - baris pembelian" create="0" edit="0" delete="0">
                <div class="alert alert-warning mb-0" role="alert">
                    Arsip sistem lama ESB - bukan transaksi Odoo. Tidak memengaruhi stok, pajak, jurnal, atau laporan
                    pembelian standar. Arti kolom diskon (nominal/persen) belum dikonfirmasi Finance.
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="date_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="purchase_num"/>
                            <field name="line_no"/>
                            <field name="status"/>
                            <field name="branch_name"/>
                            <field name="warehouse_id"/>
                            <field name="supplier_name"/>
                            <field name="supplier_id"/>
                            <field name="map_source"/>
                        </group>
                        <group>
                            <field name="esb_product_code"/>
                            <field name="product_name"/>
                            <field name="product_id"/>
                            <field name="category_name"/>
                            <field name="sub_category_name"/>
                            <field name="uom_name"/>
                            <field name="qty"/>
                            <field name="receipt_qty"/>
                            <field name="pricelist_price"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="vat_value"/>
                            <field name="total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_legacy_purchase_line_view_pivot" model="ir.ui.view">
        <field name="name">efn.legacy.purchase.line.pivot</field>
        <field name="model">efn.legacy.purchase.line</field>
        <field name="arch" type="xml">
            <pivot string="Arsip sistem lama ESB - baris pembelian (bukan transaksi Odoo)" sample="1">
                <field name="supplier_name" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="total" type="measure"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="efn_legacy_purchase_line_view_graph" model="ir.ui.view">
        <field name="name">efn.legacy.purchase.line.graph</field>
        <field name="model">efn.legacy.purchase.line</field>
        <field name="arch" type="xml">
            <graph string="Arsip sistem lama ESB - baris pembelian (bukan transaksi Odoo)" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="efn_legacy_purchase_line_view_search" model="ir.ui.view">
        <field name="name">efn.legacy.purchase.line.search</field>
        <field name="model">efn.legacy.purchase.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_num"/>
                <field name="esb_product_code"/>
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="supplier_name"/>
                <field name="supplier_id"/>
                <field name="branch_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="last_3_months" string="3 bulan terakhir"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_date" string="Tanggal PO" date="date"/>
                <separator/>
                <filter name="unmapped_product" string="Produk belum terpetakan" domain="[('product_id', '=', False)]"/>
                <filter name="unmapped_supplier" string="Supplier belum terpetakan"
                        domain="[('supplier_id', '=', False)]"/>
                <filter name="mapped_by_name" string="Dipetakan lewat nama" domain="[('map_source', '!=', 'header')]"/>
                <group>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="by_supplier" string="Supplier" context="{'group_by': 'supplier_name'}"/>
                    <filter name="by_product" string="Produk" context="{'group_by': 'esb_product_code'}"/>
                    <filter name="by_branch" string="Cabang" context="{'group_by': 'branch_name'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="by_month" string="Bulan" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_legacy_purchase_line_action" model="ir.actions.act_window">
        <field name="name">Histori pembelian (arsip ESB)</field>
        <field name="res_model">efn.legacy.purchase.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_last_3_months': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Belum ada histori pembelian ESB.</p>
            <p>Arsip sistem lama ESB - bukan transaksi Odoo (bukan Purchase Order). Diisi skrip migrasi (ADR-042 §0b);
                read-only. Harga beli aktif ada di tab Pembelian produk (supplierinfo).</p>
        </field>
    </record>
</odoo>
