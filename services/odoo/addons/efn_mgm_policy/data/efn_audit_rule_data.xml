<?xml version="1.0" encoding="utf-8"?>
<!-- K25-10: kebijakan MGM teraudit efn_audit (nilai lama/baru semua field, termasuk state & penyetuju). -->
<odoo>
    <record id="audit_rule_efn_mgm_policy" model="efn.audit.rule">
        <field name="name">EFN - Kebijakan MGM per PT</field>
        <field name="model_id" ref="model_efn_mgm_policy"/>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="capture_unlink_values" eval="True"/>
    </record>
</odoo>
