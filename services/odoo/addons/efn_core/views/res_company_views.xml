<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_efn_core" model="ir.ui.view">
        <field name="name">res.company.form.inherit.efn.core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="EFN" name="efn_platform">
                    <group>
                        <group>
                            <field name="efn_brand_code"/>
                            <field name="efn_business_type" readonly="1"/>
                            <field name="efn_is_merchant_of_record"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
