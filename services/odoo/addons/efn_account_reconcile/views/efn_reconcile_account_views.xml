<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ringkasan: akun reconcilable dengan item terbuka, per company -->
    <record id="view_efn_reconcile_account_list" model="ir.ui.view">
        <field name="name">efn.reconcile.account.list</field>
        <field name="model">efn.reconcile.account</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false" default_order="residual desc">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="account_id"/>
                <field name="oldest_date"/>
                <field name="line_count" sum="Total"/>
                <field name="debit" sum="Total"/>
                <field name="credit" sum="Total"/>
                <field name="residual" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_open_lines" type="object" string="Rekonsiliasi"
                        class="btn btn-primary" icon="fa-play" groups="account.group_account_user"/>
            </list>
        </field>
    </record>

    <record id="view_efn_reconcile_account_search" model="ir.ui.view">
        <field name="name">efn.reconcile.account.search</field>
        <field name="model">efn.reconcile.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="with_residual" string="Sisa ≠ 0" domain="[('residual', '!=', 0)]"/>
                <filter name="netted" string="Saling Meniadakan (tinggal cocokkan)" domain="[('residual', '=', 0)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_efn_reconcile_overview" model="ir.actions.act_window">
        <field name="name">Rekonsiliasi Akun</field>
        <field name="res_model">efn.reconcile.account</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_efn_reconcile_account_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tidak ada yang perlu direkonsiliasi</p>
            <p>Semua akun reconcilable sudah cocok. Item terbuka di akun kliring/suspense akan muncul di sini.</p>
        </field>
    </record>

    <!-- Wizard rekonsiliasi item jurnal -->
    <record id="view_efn_account_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">efn.account.reconcile.wizard.form</field>
        <field name="model">efn.account.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Rekonsiliasi">
                <group>
                    <group>
                        <field name="account_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="is_balanced" invisible="1"/>
                    </group>
                    <group>
                        <field name="debit"/>
                        <field name="credit"/>
                        <field name="residual"/>
                    </group>
                </group>
                <group invisible="is_balanced">
                    <field name="mode" widget="radio"/>
                    <group invisible="mode != 'writeoff'">
                        <field name="writeoff_account_id" required="mode == 'writeoff'"/>
                        <field name="writeoff_journal_id" required="mode == 'writeoff'"/>
                        <field name="writeoff_date"/>
                        <field name="writeoff_label"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="date"/>
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="name"/>
                        <field name="debit"/>
                        <field name="credit"/>
                        <field name="amount_residual"/>
                    </list>
                </field>
                <footer>
                    <button name="action_reconcile" type="object" string="Rekonsiliasi" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Batal" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- "Rekonsiliasi" di menu Action list Item Jurnal -->
    <record id="action_efn_reconcile_lines" model="ir.actions.act_window">
        <field name="name">Rekonsiliasi</field>
        <field name="res_model">efn.account.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
