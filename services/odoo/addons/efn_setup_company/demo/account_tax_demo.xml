<?xml version="1.0" encoding="utf-8"?>
<!-- DEMO / ILUSTRASI — hanya dimuat pada database dengan data demo. JANGAN dipakai sebagai
     konfigurasi produksi. Bergantung keputusan klien & konsultan pajak (R-L03, Q-22, Q-2,
     ADR-019). PB1 default (grup + pajak + default PT F&B) kini di data/account_tax_pb1_data.xml;
     SC 5% + fiscal position dine-in/non-dine-in kota default di data/account_tax_fnb_service_data.xml (G19 W-14).

     Ilustrasi pola "PB1 per kota tanpa developer" (lihat README):
     - pajak "PB1 Kota Contoh Non-Dine-in 0% (DEMO)" dengan Replaces (original_tax_ids) = PB1 default;
     - fiscal position "Outlet Kota Contoh (DEMO)" (= non-dine-in kota contoh) berisi pajak tersebut (tax_ids);
     - dine-in kota contoh: "PB1 Kota Contoh Dine-in 5% (DEMO)" + FP "Outlet Kota Contoh Dine-in (DEMO)";
     - pos.config outlet di kota itu memakai Default Fiscal Position = FP dine-in kota (diisi lewat UI,
       pos.config tidak dibuat via XML — lihat efn_setup_pos).
     Tarif 5% hanyalah angka ilustrasi, BUKAN tarif Perda mana pun. Non-dine-in 0 % = keputusan 18-1. -->
<odoo>
    <!-- G20 (18-1): xmlid tetap, tetapi pajak ini = NON-DINE-IN kota contoh -> 0 % (PB1 hanya dine-in). Kota yang
         memungut PBJT bawa pulang: admin mengubah Amount (tanpa kode). -->
    <record id="tax_pb1_kota_contoh_fnb" model="account.tax">
        <field name="name">PB1 Kota Contoh Non-Dine-in 0% (DEMO)</field>
        <field name="invoice_label">PB1</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">0.0</field>
        <field name="sequence">10</field>
        <field name="company_id" ref="company_fnb"/>
        <field name="tax_group_id" ref="tax_group_pb1_fnb"/>
        <field name="original_tax_ids" eval="[(6, 0, [ref('tax_pb1_10_fnb')])]"/>
    </record>

    <record id="fiscal_position_kota_contoh_fnb" model="account.fiscal.position">
        <field name="name">Outlet Kota Contoh (DEMO)</field>
        <field name="company_id" ref="company_fnb"/>
        <field name="sequence">10</field>
        <!-- auto_apply False: dipilih per outlet (pos.config.default_fiscal_position_id),
             bukan dari alamat pelanggan. -->
        <field name="auto_apply" eval="False"/>
        <field name="tax_ids" eval="[(6, 0, [ref('tax_pb1_kota_contoh_fnb')])]"/>
        <field name="note">&lt;p&gt;DEMO: non-dine-in kota contoh, memetakan PB1 default ke PB1 kota contoh non-dine-in (0 %, 18-1).&lt;/p&gt;</field>
    </record>

    <!-- G19 W-14: fiscal position "Outlet Kota Contoh (DEMO)" di atas bermakna NON-DINE-IN kota contoh (tanpa SC;
         dipakai preset bungkus demo efn_setup_pos & outlet online FNB demo efn_setup_online). Pasangan dine-in kota
         contoh di bawah: PB1 default -> [SC 5% (data), PB1 Kota Contoh Dine-in]. Pajak tujuan dine-in kota harus pajak
         TERPISAH dari pajak non-dine-in kota: tax_map dihitung dari original_tax_ids pajak tujuan, jadi satu pajak
         kota yang dipakai di dua fiscal position akan memetakan sumber yang sama di keduanya.
         Service charge (grup + pajak) kini di data/account_tax_fnb_service_data.xml (keputusan #15). -->
    <record id="tax_pb1_kota_contoh_dine_in_fnb" model="account.tax">
        <field name="name">PB1 Kota Contoh Dine-in 5% (DEMO)</field>
        <field name="invoice_label">PB1</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">5.0</field>
        <field name="sequence">10</field>
        <field name="company_id" ref="company_fnb"/>
        <field name="tax_group_id" ref="tax_group_pb1_fnb"/>
        <field name="original_tax_ids" eval="[(6, 0, [ref('tax_pb1_10_fnb')])]"/>
    </record>
    <record id="fiscal_position_kota_contoh_dine_in_fnb" model="account.fiscal.position">
        <field name="name">Outlet Kota Contoh Dine-in (DEMO)</field>
        <field name="company_id" ref="company_fnb"/>
        <field name="sequence">11</field>
        <field name="auto_apply" eval="False"/>
        <field name="tax_ids" eval="[(6, 0, [ref('tax_service_charge_5_fnb'), ref('tax_pb1_kota_contoh_dine_in_fnb')])]"/>
        <field name="note">&lt;p&gt;DEMO: dine-in kota contoh = PB1 kota contoh + SC 5%.&lt;/p&gt;</field>
    </record>

    <!-- Harga rak retail lazimnya sudah termasuk PPN (Q-9/Q-28) — placeholder. -->
    <record id="company_rtl" model="res.company">
        <field name="account_price_include">tax_included</field>
    </record>

    <!-- ADR-019 (Proposed): Holding = pemegang akun gateway / agen penagih (Q-1). -->
    <record id="company_efn" model="res.company">
        <field name="efn_is_merchant_of_record" eval="True"/>
    </record>
</odoo>
