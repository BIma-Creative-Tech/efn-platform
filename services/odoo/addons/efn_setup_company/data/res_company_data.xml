<?xml version="1.0" encoding="utf-8"?>
<!-- EFN Setup Company (ADR-001). noupdate="1": dimuat sekali saat install; perubahan
     pengguna (nama legal, NPWP, alamat) tidak ditimpa saat upgrade modul.
     Nama company adalah PLACEHOLDER sampai klien menjawab Q-1 (daftar PT & nama legal).
     Kode company mengikuti kontrak docs/04_SERVICE_CONTRACTS.md §1 (field efn_core).
     efn_business_type TIDAK diisi: sejak efn_core 19.0.1.2.0 field itu compute stored dari
     efn_brand_code (temuan QA U6, Gelombang 5). -->
<odoo noupdate="1">

    <!-- Rupiah aktif (base.IDR nonaktif di database baru).
         W-03 / Q-ON6 (keputusan pemilik proyek 10 Okt 2026): presisi IDR GLOBAL Rp1 diatur di
         hooks.py pre_init_hook (SEBELUM data ini & CoA), bukan di sini: Odoo menolak menaikkan rounding bila
         sudah ada jurnal IDR (DB demo l10n_id) -> hook melewati dengan WARNING agar DB demo tetap bisa dibuat.
         Hanya saat install pertama: upgrade TIDAK mengubah DB yang sudah ada (dev efn_odoo tetap 0.01 sampai
         dibuat ulang). Bukti PoC & dampak: docs/08_ODOO_FIT_GAP.md §9.1. -->
    <record id="base.IDR" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <!-- 6 entitas = 6 company terpisah (badan hukum berbeda), SEMUA ROOT. JANGAN memakai parent_id
         (fitur "Branches" Odoo): cabang berbagi CoA/pajak induk, tidak cocok untuk PT berbeda, dan hierarki tidak
         bisa diubah setelah dibuat (docs/04 §12.1).
         G20 W-32/E-43 (keputusan pemilik proyek 18-27 + kontrak docs/04 §12.1, L-48; ADR-001 revisi 18 Okt):
         company_rtl = PT Grand Lucky (GL, ritel PPN), company_fnb = PT Paris Baguette (PB, F&B PB1 + CK),
         company_bcr = Bacha Coffee Retail (BCR, ritel PPN), company_bcf = Bacha Coffee F&B (BCF, F&B PB1 + SC).
         xmlid company_rtl/company_fnb SENGAJA dipertahankan (L-48: mengurangi perubahan); kode lama RTL/FNB dihapus.
         Tidak ada migrasi data: DB dev/CI dibuat ulang (noupdate: DB lama TIDAK diperbarui otomatis).
         Nama = PLACEHOLDER nama legal (ubah lewat UI). -->
    <record id="company_efn" model="res.company">
        <field name="name">Holding EFN (PLACEHOLDER nama legal)</field>
        <field name="sequence">1</field>
        <field name="efn_brand_code">EFN</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <record id="company_rtl" model="res.company">
        <field name="name">PT Grand Lucky (PLACEHOLDER nama legal)</field>
        <field name="sequence">2</field>
        <field name="efn_brand_code">GL</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <record id="company_fnb" model="res.company">
        <field name="name">PT Paris Baguette (PLACEHOLDER nama legal)</field>
        <field name="sequence">3</field>
        <field name="efn_brand_code">PB</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <!-- G20 W-32: dua PT Bacha Coffee (ritel butik & kafe). Transfer pricing cost-plus hanya BCR <-> BCF (W-15). -->
    <record id="company_bcr" model="res.company">
        <field name="name">Bacha Coffee Retail (PLACEHOLDER nama legal)</field>
        <field name="sequence">4</field>
        <field name="efn_brand_code">BCR</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <record id="company_bcf" model="res.company">
        <field name="name">Bacha Coffee F&amp;B (PLACEHOLDER nama legal)</field>
        <field name="sequence">5</field>
        <field name="efn_brand_code">BCF</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <record id="company_farm" model="res.company">
        <field name="name">FARM (PLACEHOLDER nama legal)</field>
        <field name="sequence">6</field>
        <field name="efn_brand_code">FARM</field>
        <field name="country_id" ref="base.id"/>
        <field name="currency_id" ref="base.IDR"/>
        <!-- R3: validasi VIES (EU) tidak relevan untuk NPWP dan butuh egress internet. -->
        <field name="vat_check_vies" eval="False"/>
    </record>

    <!-- Admin boleh berpindah ke keenam company (user lain diatur per peran). -->
    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('company_efn')), (4, ref('company_rtl')), (4, ref('company_fnb')), (4, ref('company_bcr')), (4, ref('company_bcf')), (4, ref('company_farm'))]"/>
    </record>

    <!-- Fiscal localization Indonesia (template 'id' dari l10n_id) per company.
         account.chart.template.try_loading(template_code, company) BUKAN @api.model,
         sehingga argumen pertama adalah ids kosong. Di blok noupdate, <function> hanya
         dijalankan saat install (tidak saat upgrade).
         Template memberi PPN (tax_ST4 "12% (Non-Luxury Good)" = 12% x DPP 11/12, efektif 11%)
         sebagai pajak penjualan default; PB1 TIDAK ada di template (lihat
         data/account_tax_pb1_data.xml, dimuat SETELAH file ini karena pajak butuh fiscal
         country yang di-set try_loading).
         Gelombang 9: company dikirim sebagai RECORDSET (bukan int). try_loading 19.0 mencetak
         warning `company.name` SEBELUM mengubah int menjadi recordset bila registry belum
         loaded (install modul ini ke DB yang sudah ada) -> AttributeError dan install gagal. -->

    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_efn'))]"/>
    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_rtl'))]"/>
    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_fnb'))]"/>
    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_bcr'))]"/>
    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_bcf'))]"/>
    <function model="account.chart.template" name="try_loading" eval="[[], 'id', obj().env['res.company'].browse(ref('company_farm'))]"/>
</odoo>
