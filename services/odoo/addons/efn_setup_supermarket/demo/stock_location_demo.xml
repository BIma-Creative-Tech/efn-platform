    <!-- Putaway per kategori di Stock outlet: Fresh -> Zona Fresh; Dairy & Chilled -> Chiller; Frozen -> Freezer;
         kategori ambient -> Dry. Rule per kategori daun/induk eksplisit (bukan satu rule di root) agar urutan tidak
         bergantung tie-break sequence. SMD05 tanpa rule Frozen (barang frozen memang tidak dikirim, assortment).
         Python 3.12: comprehension di safe_eval (pola stock_warehouse_demo.xml). -->
    <function model="stock.putaway.rule" name="create"
              eval="[[{
                  'location_in_id': obj().env.ref('efn_setup_supermarket.warehouse_' + w).lot_stock_id.id,
                  'location_out_id': ref('location_' + w + '_' + z),
                  'category_id': ref('product_category_smd_' + c),
                  'company_id': ref('company_smd'),
                  'sequence': 10,
              }
              for w in ('smd01', 'smd02', 'smd03', 'smd04', 'smd05')
              for c, z in (
                  ('fresh', 'fresh'), ('dairy_chilled', 'chiller'), ('frozen', 'freezer'),
                  ('dry_grocery', 'dry'), ('beverage', 'dry'), ('snack', 'dry'), ('personal_care', 'dry'),
                  ('household', 'dry'), ('alcohol', 'dry'), ('imported_premium', 'dry'),
              )
              if not (w == 'smd05' and z == 'freezer')]]"/>

    <!-- Stock DC: hitung siklus 30 hari (PLACEHOLDER Q-SM10). Zona DC (rak/chiller/freezer) = keputusan Q-SM2. -->
    <function model="stock.location" name="write"
              eval="[[obj().env.ref('efn_setup_supermarket.warehouse_smd_dc').lot_stock_id.id], {'cyclic_inventory_frequency': 30}]"/>
