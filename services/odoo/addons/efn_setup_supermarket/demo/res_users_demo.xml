<?xml version="1.0" encoding="utf-8"?>
<!-- DEMO tahap B — user per persona PT Supermarket Demo (docs/04 §28.4, §28.5, §28.5a, §28.11; ADR-045/046, Proposed).
     Pola user demo efn_setup_online: login placeholder, TANPA password (user tidak bisa login sampai admin menetapkan
     password lewat UI dan user mengaktifkan 2FA auth_totp, prinsip CLAUDE.md). Tidak ada email/nomor HP (PDP: data
     pribadi minimal). Satu company (SMD) per user.

       Persona                          | Grup                                                          | Cakupan outlet
       Kepala toko SMD01..SMD05         | Replenishment: kepala toko                                    | outlet itu saja
       Buyer DC                         | Replenishment: buyer DC + Purchase User                       | (semua, lewat grup)
       Markdown manager (category mgr)  | efn_expiry_monitor.group_markdown_manager                     | -
       Supervisor Ops                   | efn_expiry_monitor.group_expiry_override + Assortment Manager | -

     SoD (docs/04 §28.4): kepala toko tidak mendapat grup Purchase/buyer; buyer tidak mendapat grup kepala toko; override
     sisa umur / assortment dipegang supervisor, bukan kepala toko yang menerima barang. Pemetaan nyata = Q-SM29 (persona
     Insight & outlet kepala toko) dan Q-SM4 (siapa boleh markdown). efn_outlet_warehouse_ids juga sumber klaim `wids`
     Insight persona store (§28.11). noupdate="1". -->
<odoo noupdate="1">
    <record id="user_smd01_store_head" model="res.users">
        <field name="name">Kepala Toko SMD01 (DEMO)</field>
        <field name="login">efn_demo_smd01_kepala_toko</field>
        <field name="company_id" ref="company_smd"/>
        <field name="company_ids" eval="[Command.set([ref('company_smd')])]"/>
        <field name="tz">Asia/Jakarta</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('efn_replenishment.group_replenishment_store')])]"/>
        <field name="efn_outlet_warehouse_ids" eval="[Command.set([ref('warehouse_smd01')])]"/>
    </record>
