<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- E-45: tombol "Bayar pesanan online" di menu tombol lain (hanya bila POS menerima bayar di kasir). -->
    <t t-name="efn_online_pos_counter.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="efnShowCounterPay" t-att-class="buttonClass" class="efn-counter-pay"
                    t-att-disabled="efnCounterPayDisabled" t-on-click="() => this.efnPayOnlineOrder()">
                <i class="fa fa-qrcode me-2" role="img" aria-label="Bayar pesanan online" title="Bayar pesanan online"/>Bayar pesanan online
            </button>
        </xpath>
    </t>
</templates>
