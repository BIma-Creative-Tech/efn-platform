<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_batch_payment_format_list" model="ir.ui.view">
        <field name="name">efn.account.batch.payment.format.list</field>
        <field name="model">efn.account.batch.payment.format</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="bank_label"/>
                <field name="verified"/>
                <field name="file_extension"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_efn_batch_payment_format_form" model="ir.ui.view">
        <field name="name">efn.account.batch.payment.format.form</field>
        <field name="model">efn.account.batch.payment.format</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="bank_label"/>
                            <field name="verified"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="encoding"/>
                            <field name="delimiter"/>
                            <field name="date_format"/>
                            <field name="file_extension"/>
                            <field name="include_header"/>
                            <field name="name_max_length"/>
                            <field name="memo_max_length"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Catatan tata letak / hasil uji unggah portal bank…"/>
                    <separator string="Konfigurasi per company / jurnal"/>
                    <field name="company_config_ids">
                        <list editable="bottom">
                            <field name="company_id"/>
                            <field name="journal_id"/>
                            <field name="corporate_id"/>
                            <field name="debit_account"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_efn_batch_payment_format" model="ir.actions.act_window">
        <field name="name">Format File Transfer Bank</field>
        <field name="res_model">efn.account.batch.payment.format</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
