<?xml version="1.0" encoding="utf-8"?>
<!-- G66b (ADR-051 A1 Proposed, docs/04 §30.17.11): grup user teknis provisioning + record rule multi-company.
     Grup provisioner SENGAJA tanpa ACL (bahkan baca): efn_esb_provision memeriksa pemanggil lalu menulis lewat sudo
     dengan nilai yang dikunci kode, sehingga API key provisioner tidak bisa membaca daftar username ESB lewat
     /json/2 search_read. Grup ini ada di efn_role TECHNICAL_GROUP_XMLIDS (tidak bisa menjadi/menerima peran). -->
<odoo>
    <record id="res_groups_privilege_esb_identity" model="res.groups.privilege">
        <field name="name">EFN Identitas ESB</field>
        <field name="category_id" ref="efn_insight.module_category_efn_insight"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_esb_provisioner" model="res.groups">
        <field name="name">Identitas ESB: provisioning (user teknis prodplan)</field>
        <field name="comment">User teknis prodplan untuk /json/2 efn.esb.identity/efn_esb_provision lewat odoo-rpc-gateway. Hanya Internal User + grup ini, satu company, tanpa grup lain (grup tambahan = RPC ditolak). Tanpa akses dokumen langsung.</field>
        <field name="privilege_id" ref="res_groups_privilege_esb_identity"/>
    </record>

    <data noupdate="1">
        <record id="efn_esb_identity_rule_company" model="ir.rule">
            <field name="name">EFN identitas ESB: multi-company</field>
            <field name="model_id" ref="model_efn_esb_identity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
