<?xml version="1.0" encoding="utf-8"?>
<!-- E-44: parameter operasional (bukan nilai poin; nilai poin = efn.loyalty.policy). PLACEHOLDER configurable. -->
<odoo noupdate="1">
    <!-- Hari ke belakang yang dikejar cron akrual bila BFF sempat mati (1..31). -->
    <record id="param_accrual_lookback_days" model="ir.config_parameter">
        <field name="key">efn.loyalty.accrual_lookback_days</field>
        <field name="value">3</field>
    </record>
    <!-- Umur maksimum outbox publikasi sebelum gagal final (jam). Tanpa kunci tanda tangan tidak dihitung. -->
    <record id="param_policy_outbox_max_hours" model="ir.config_parameter">
        <field name="key">efn.loyalty.policy_outbox_max_hours</field>
        <field name="value">72</field>
    </record>
    <!-- r14 L-67 (SEC-160): breakage & forfeit selalu dijurnal; parameter efn.loyalty.breakage_journal_enabled dihapus
         (bila masih ada di DB lama: diabaikan kode). -->
</odoo>
