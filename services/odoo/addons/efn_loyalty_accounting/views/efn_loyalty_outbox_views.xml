<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_loyalty_policy_outbox_view_list" model="ir.ui.view">
        <field name="name">efn.loyalty.policy.outbox.list</field>
        <field name="model">efn.loyalty.policy.outbox</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'failed'" decoration-warning="state == 'pending' and last_error">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="idempotency_key"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="last_status"/>
                <field name="last_error"/>
                <field name="done_at"/>
            </list>
        </field>
    </record>

    <record id="efn_loyalty_policy_outbox_view_form" model="ir.ui.view">
        <field name="name">efn.loyalty.policy.outbox.form</field>
        <field name="model">efn.loyalty.policy.outbox</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_efn_retry" type="object" string="Kirim ulang" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="policy_id"/>
                            <field name="idempotency_key"/>
                            <field name="body_sha256"/>
                        </group>
                        <group>
                            <field name="attempt_count"/>
                            <field name="next_attempt_at"/>
                            <field name="last_status"/>
                            <field name="last_error"/>
                            <field name="done_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_efn_loyalty_policy_outbox" model="ir.actions.act_window">
        <field name="name">Publikasi Kebijakan ke BFF</field>
        <field name="res_model">efn.loyalty.policy.outbox</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
