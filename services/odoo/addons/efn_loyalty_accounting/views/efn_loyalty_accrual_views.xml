<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_loyalty_accrual_view_list" model="ir.ui.view">
        <field name="name">efn.loyalty.accrual.list</field>
        <field name="model">efn.loyalty.accrual</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state in ('missing_config', 'conflict', 'error') or recon_status == 'mismatch'">
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="ref"/>
                <field name="state" widget="badge"/>
                <field name="earned_value_idr" sum="Total"/>
                <field name="earn_reversed_value_idr" sum="Total"/>
                <field name="redeemed_cross_value_idr" sum="Total"/>
                <field name="closing_liability_idr"/>
                <field name="ledger_liability_idr"/>
                <field name="recon_diff_idr"/>
                <field name="recon_status" widget="badge"/>
                <field name="move_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="efn_loyalty_accrual_view_form" model="ir.ui.view">
        <field name="name">efn.loyalty.accrual.form</field>
        <field name="model">efn.loyalty.accrual</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_efn_retry" type="object" string="Proses ulang"
                            invisible="state not in ('missing_config', 'conflict', 'error', 'pending')"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Akrual">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date"/>
                            <field name="ref"/>
                            <field name="move_id"/>
                            <field name="generated_at"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                        <group string="Rekonsiliasi">
                            <field name="closing_liability_idr"/>
                            <field name="ledger_liability_idr"/>
                            <field name="recon_diff_idr"/>
                            <field name="recon_status"/>
                        </group>
                    </group>
                    <group string="Komponen BFF (Rp)">
                        <group>
                            <field name="earned_value_idr"/>
                            <field name="earn_reversed_value_idr"/>
                            <field name="restored_value_idr"/>
                            <field name="restored_cross_value_idr"/>
                            <field name="restored_by_issuer"/>
                            <field name="expired_value_idr"/>
                            <field name="forfeited_value_idr"/>
                        </group>
                        <group>
                            <field name="redeemed_same_value_idr"/>
                            <field name="redeemed_cross_value_idr"/>
                            <field name="redeemed_by_issuer"/>
                            <field name="issuer_redeemed_value_idr"/>
                            <field name="issuer_restored_value_idr"/>
                            <field name="issuer_by_redeemer"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="efn_loyalty_accrual_view_search" model="ir.ui.view">
        <field name="name">efn.loyalty.accrual.search</field>
        <field name="model">efn.loyalty.accrual</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="date"/>
                <filter name="filter_problem" string="Perlu tindakan" domain="['|', ('state', 'in', ('missing_config', 'conflict', 'error')), ('recon_status', '=', 'mismatch')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_efn_loyalty_accrual" model="ir.actions.act_window">
        <field name="name">Akrual Poin EFN Harian</field>
        <field name="res_model">efn.loyalty.accrual</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
