<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_loyalty_settlement_view_list" model="ir.ui.view">
        <field name="name">efn.loyalty.settlement.list</field>
        <field name="model">efn.loyalty.settlement</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="state == 'cancelled'" decoration-success="state == 'approved'">
                <field name="period"/>
                <field name="issuer_company_id"/>
                <field name="redeemer_company_id"/>
                <field name="amount_idr" sum="Total"/>
                <field name="prepared_by_id" optional="show"/>
                <field name="approved_by_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="efn_loyalty_settlement_view_form" model="ir.ui.view">
        <field name="name">efn.loyalty.settlement.form</field>
        <field name="model">efn.loyalty.settlement</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Setujui &amp; jurnal" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Jurnal settlement dibuat di kedua PT. Pastikan transfer bank sudah dieksekusi."/>
                    <button name="action_recompute" type="object" string="Hitung ulang" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Batalkan" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="ref"/></h1></div>
                    <group>
                        <group string="Pasangan PT">
                            <field name="period"/>
                            <field name="issuer_company_id"/>
                            <field name="redeemer_company_id"/>
                            <field name="accrual_days"/>
                        </group>
                        <group string="Nilai">
                            <field name="redeemed_value_idr"/>
                            <field name="restored_value_idr"/>
                            <field name="amount_idr"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pembayaran">
                            <field name="payment_ref" readonly="state != 'draft'"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="issuer_journal_id" readonly="state != 'draft'"
                                   domain="[('type', '=', 'bank'), ('company_id', '=', issuer_company_id)]"/>
                            <field name="redeemer_journal_id" readonly="state != 'draft'"
                                   domain="[('type', '=', 'bank'), ('company_id', '=', redeemer_company_id)]"/>
                        </group>
                        <group string="Empat mata">
                            <field name="prepared_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="approved_at"/>
                            <field name="issuer_move_id"/>
                            <field name="redeemer_move_id"/>
                        </group>
                    </group>
                    <group string="Rincian per tanggal (Rp ditukar, Rp dikembalikan)">
                        <field name="breakdown" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="efn_loyalty_settlement_view_search" model="ir.ui.view">
        <field name="name">efn.loyalty.settlement.search</field>
        <field name="model">efn.loyalty.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="period"/>
                <field name="issuer_company_id"/>
                <field name="redeemer_company_id"/>
                <filter name="draft" string="Menunggu persetujuan" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="by_period" string="Periode" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_efn_loyalty_settlement" model="ir.actions.act_window">
        <field name="name">Settlement Poin Antar-PT</field>
        <field name="res_model">efn.loyalty.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada settlement</p>
            <p>Gunakan <b>Siapkan settlement</b> setelah akrual harian satu bulan selesai.</p>
        </field>
    </record>

    <record id="efn_loyalty_settlement_wizard_form" model="ir.ui.view">
        <field name="name">efn.loyalty.settlement.wizard.form</field>
        <field name="model">efn.loyalty.settlement.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="period" placeholder="2026-10"/>
                    <field name="issuer_company_id"/>
                    <field name="redeemer_company_id"/>
                </group>
                <p class="text-muted">Kosongkan PT untuk menyiapkan semua pasangan yang punya nilai.</p>
                <footer>
                    <button name="action_prepare" type="object" string="Siapkan" class="btn-primary"/>
                    <button special="cancel" string="Batal"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_efn_loyalty_settlement_wizard" model="ir.actions.act_window">
        <field name="name">Siapkan settlement</field>
        <field name="res_model">efn.loyalty.settlement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
