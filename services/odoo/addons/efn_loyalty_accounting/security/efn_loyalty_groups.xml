<?xml version="1.0" encoding="utf-8"?>
<!-- E-44 (docs/04 §13.1 no. 2): grup pembuat kebijakan poin. Penyetuju = account.group_account_manager (CE).
     Pemisahan tugas Loyalty Manager ⟂ Accounting Manager per user ditegakkan efn_role (§13.3, E-47); di modul ini
     empat mata ditegakkan per record (pembuat/penyunting != penyetuju). Tidak diberikan otomatis ke siapa pun. -->
<odoo>
    <record id="module_category_efn_loyalty" model="ir.module.category">
        <field name="name">EFN Loyalty</field>
        <field name="sequence">91</field>
    </record>

    <record id="res_groups_privilege_efn_loyalty" model="res.groups.privilege">
        <field name="name">EFN Loyalty</field>
        <field name="category_id" ref="module_category_efn_loyalty"/>
    </record>

    <record id="group_loyalty_manager" model="res.groups">
        <field name="name">Loyalty Manager</field>
        <field name="comment">EFN / Loyalty Manager: membuat dan menyunting draft kebijakan Poin EFN per PT. Persetujuan oleh Accounting / Manager company yang sama (empat mata).</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_loyalty"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
</odoo>
