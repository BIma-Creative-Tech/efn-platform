<?xml version="1.0" encoding="utf-8"?>
<!-- E-29a: sumber tiket pesanan online di daftar/form tiket KDS (manager POS dengan grup baca pesanan online) +
     override POS dapur per outlet online. -->
<odoo>
    <record id="efn_kds_ticket_view_list_online" model="ir.ui.view">
        <field name="name">efn.kds.ticket.list.online</field>
        <field name="model">efn.kds.ticket</field>
        <field name="inherit_id" ref="efn_pos_kds.efn_kds_ticket_view_list"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="efn_online_order_id" optional="show"
                       groups="sales_team.group_sale_salesman,stock.group_stock_user,account.group_account_invoice"/>
            </field>
        </field>
    </record>

    <record id="efn_kds_ticket_view_form_online" model="ir.ui.view">
        <field name="name">efn.kds.ticket.form.online</field>
        <field name="model">efn.kds.ticket</field>
        <field name="inherit_id" ref="efn_pos_kds.efn_kds_ticket_view_form"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="efn_online_order_id"
                       groups="sales_team.group_sale_salesman,stock.group_stock_user,account.group_account_invoice"/>
            </field>
        </field>
    </record>

    <record id="efn_online_channel_view_form_kds" model="ir.ui.view">
        <field name="name">efn.online.channel.form.kds</field>
        <field name="model">efn.online.channel</field>
        <field name="inherit_id" ref="efn_online_order.efn_online_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='outlet_ids']/list/field[@name='fiscal_position_id']" position="after">
                <field name="kds_config_id" optional="hide" groups="point_of_sale.group_pos_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
