<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_demand_forecast_view_list" model="ir.ui.view">
        <field name="name">efn.demand.forecast.list</field>
        <field name="model">efn.demand.forecast</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('superseded', 'rejected')" decoration-success="state == 'applied'">
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="forecast_daily"/>
                <field name="season_factor"/>
                <field name="current_min"/>
                <field name="current_max"/>
                <field name="proposed_min"/>
                <field name="proposed_max"/>
                <field name="approved_min"/>
                <field name="approved_max"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="efn_demand_forecast_view_form" model="ir.ui.view">
        <field name="name">efn.demand.forecast.form</field>
        <field name="model">efn.demand.forecast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_efn_apply" type="object" string="Setujui &amp; Terapkan" class="btn-primary"
                            invisible="state != 'draft'" groups="stock.group_stock_manager"/>
                    <button name="action_efn_reject" type="object" string="Tolak"
                            invisible="state != 'draft'" groups="stock.group_stock_manager"/>
                    <button name="action_efn_recompute" type="object" string="Hitung ulang" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                </header>
                <sheet>
                    <group>
                        <group string="Objek">
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Parameter">
                            <field name="history_days" readonly="state != 'draft'"/>
                            <field name="lead_days" readonly="state != 'draft'"/>
                            <field name="review_days" readonly="state != 'draft'"/>
                            <field name="service_level" readonly="state != 'draft'"/>
                        </group>
                        <group string="Hasil hitung">
                            <field name="history_qty"/>
                            <field name="base_daily"/>
                            <field name="sigma_daily"/>
                            <field name="season_factor"/>
                            <field name="forecast_daily"/>
                        </group>
                        <group string="Min / Max">
                            <field name="current_min"/>
                            <field name="current_max"/>
                            <field name="proposed_min"/>
                            <field name="proposed_max"/>
                            <field name="approved_min" readonly="state != 'draft'"/>
                            <field name="approved_max" readonly="state != 'draft'"/>
                            <field name="orderpoint_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_at" invisible="not approved_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="efn_demand_forecast_view_search" model="ir.ui.view">
        <field name="name">efn.demand.forecast.search</field>
        <field name="model">efn.demand.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter name="draft" string="Menunggu persetujuan" domain="[('state', '=', 'draft')]"/>
                <filter name="applied" string="Diterapkan" domain="[('state', '=', 'applied')]"/>
                <group>
                    <filter name="by_wh" string="Gudang" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="efn_demand_forecast_action" model="ir.actions.act_window">
        <field name="name">Usulan Forecast</field>
        <field name="res_model">efn.demand.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>
    <record id="view_warehouse_efn_forecast" model="ir.ui.view">
        <field name="name">stock.warehouse.form.efn.forecast</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="efn_forecast_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
