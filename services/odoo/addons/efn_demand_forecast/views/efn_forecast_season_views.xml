<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_forecast_season_view_list" model="ir.ui.view">
        <field name="name">efn.forecast.season.list</field>
        <field name="model">efn.forecast.season</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="date_from" required="kind == 'period'" invisible="kind != 'period'"/>
                <field name="date_to" required="kind == 'period'" invisible="kind != 'period'"/>
                <field name="day_from" invisible="kind != 'monthly'"/>
                <field name="day_to" invisible="kind != 'monthly'"/>
                <field name="weekdays" invisible="kind != 'weekday'"/>
                <field name="factor"/>
                <field name="product_categ_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="efn_forecast_season_action" model="ir.actions.act_window">
        <field name="name">Kalender Musim</field>
        <field name="res_model">efn.forecast.season</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
