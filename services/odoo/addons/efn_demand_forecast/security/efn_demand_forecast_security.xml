<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="efn_demand_forecast_rule_company" model="ir.rule">
            <field name="name">EFN forecast: multi-company</field>
            <field name="model_id" ref="model_efn_demand_forecast"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="efn_forecast_season_rule_company" model="ir.rule">
            <field name="name">EFN musim forecast: global atau PT sendiri</field>
            <field name="model_id" ref="model_efn_forecast_season"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
