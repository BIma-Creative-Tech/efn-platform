<?xml version="1.0" encoding="utf-8"?>
<!-- G44 (docs/04 §28.3): perubahan kalender forecast teraudit efn_audit (nilai lama/baru, termasuk entri manual). -->
<odoo>
    <record id="audit_rule_efn_forecast_calendar" model="efn.audit.rule">
        <field name="name">EFN - Kalender forecast</field>
        <field name="model_id" ref="model_efn_forecast_calendar"/>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="capture_unlink_values" eval="True"/>
    </record>
</odoo>
