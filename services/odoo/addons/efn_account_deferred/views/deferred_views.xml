<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_deferred_entries_search" model="ir.ui.view">
        <field name="name">account.move.efn.deferred.search</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="efn_deferred_origin_move_id"/>
                <filter name="deferral" string="Penangguhan"
                        domain="[('efn_deferred_entry_type', '=', 'deferral')]"/>
                <filter name="recognition" string="Pengakuan"
                        domain="[('efn_deferred_entry_type', '=', 'recognition')]"/>
                <filter name="pending" string="Belum diposting"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="group_by_origin" string="Asal"
                        context="{'group_by': 'efn_deferred_origin_move_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_efn_deferred_entries" model="ir.actions.act_window">
        <field name="name">Entri Tangguhan</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="view_efn_deferred_entries_search"/>
        <field name="domain">[('efn_deferred_entry_type', '!=', False)]</field>
        <field name="context">{'search_default_group_by_origin': 1, 'create': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada entri tangguhan</p>
            <p>Isi Mulai/Selesai Tangguhan pada baris tagihan atau faktur; saat diposting nilainya dibagi per bulan
               lewat akun tangguhan.</p>
        </field>
    </record>

    <menuitem id="menu_efn_deferred_entries"
              name="Entri Tangguhan"
              action="action_efn_deferred_entries"
              parent="account.menu_finance_entries"
              sequence="14"
              groups="account.group_account_user"/>
</odoo>
