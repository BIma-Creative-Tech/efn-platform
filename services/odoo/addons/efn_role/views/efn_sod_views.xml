<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ efn.sod.rule -->
    <record id="efn_sod_rule_view_list" model="ir.ui.view">
        <field name="name">efn.sod.rule.list</field>
        <field name="model">efn.sod.rule</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="code"/>
                <field name="name"/>
                <field name="group_a_id"/>
                <field name="group_b_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="mode" decoration-danger="mode == 'block'" decoration-muted="mode == 'report_only'" widget="badge"/>
                <field name="violation_count"/>
            </list>
        </field>
    </record>

    <record id="efn_sod_rule_view_form" model="ir.ui.view">
        <field name="name">efn.sod.rule.form</field>
        <field name="model">efn.sod.rule</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="mode"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="group_a_id"/>
                            <field name="group_b_id"/>
                            <field name="company_id" groups="base.group_multi_company" placeholder="Global (semua company)"/>
                            <field name="violation_count"/>
                        </group>
                    </group>
                    <field name="rationale" placeholder="Alasan aturan (tanpa data pribadi)"/>
                    <field name="exception_ids" readonly="1" context="{'active_test': False}">
                        <list>
                            <field name="user_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="state" widget="badge"/>
                            <field name="granted_by_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="efn_sod_rule_view_search" model="ir.ui.view">
        <field name="name">efn.sod.rule.search</field>
        <field name="model">efn.sod.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="group_a_id"/>
                <field name="group_b_id"/>
                <filter name="block" string="Blokir" domain="[('mode', '=', 'block')]"/>
                <filter name="report_only" string="Laporan saja" domain="[('mode', '=', 'report_only')]"/>
                <separator/>
                <filter name="archived" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="efn_sod_rule_action" model="ir.actions.act_window">
        <field name="name">Aturan SoD</field>
        <field name="res_model">efn.sod.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="efn_sod_rule_view_search"/>
    </record>

    <!-- ======================================================= efn.sod.exception -->
    <record id="efn_sod_exception_view_list" model="ir.ui.view">
        <field name="name">efn.sod.exception.list</field>
        <field name="model">efn.sod.exception</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="rule_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge" decoration-success="state == 'effective'"
                       decoration-danger="state == 'expired'" decoration-muted="state == 'revoked'"/>
                <field name="granted_by_id"/>
            </list>
        </field>
    </record>

    <record id="efn_sod_exception_view_form" model="ir.ui.view">
        <field name="name">efn.sod.exception.form</field>
        <field name="model">efn.sod.exception</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <widget name="web_ribbon" title="Dicabut" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="rule_id" readonly="id"/>
                            <field name="user_id" readonly="id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state" widget="badge"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="id"/>
                            <field name="date_to" readonly="id"/>
                            <field name="granted_by_id"/>
                            <field name="revoked_by_id" invisible="active"/>
                            <field name="revoked_on" invisible="active"/>
                        </group>
                    </group>
                    <field name="reason" readonly="id"
                           placeholder="Alasan wajib (minimal 20 karakter), tanpa data pribadi. Maks. 90 hari."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="efn_sod_exception_view_search" model="ir.ui.view">
        <field name="name">efn.sod.exception.search</field>
        <field name="model">efn.sod.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="rule_id"/>
                <field name="user_id"/>
                <field name="granted_by_id"/>
                <filter name="archived" string="Dicabut" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_rule" string="Aturan" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_sod_exception_action" model="ir.actions.act_window">
        <field name="name">Pengecualian SoD</field>
        <field name="res_model">efn.sod.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="efn_sod_exception_view_search"/>
    </record>
</odoo>
