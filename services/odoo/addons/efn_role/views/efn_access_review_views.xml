<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= efn.access.review -->
    <record id="efn_access_review_view_list" model="ir.ui.view">
        <field name="name">efn.access.review.list</field>
        <field name="model">efn.access.review</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="period"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_review'"/>
                <field name="user_count"/>
                <field name="sod_violation_count" decoration-danger="sod_violation_count &gt; 0"/>
                <field name="exception_count"/>
                <field name="expired_exception_count" decoration-danger="expired_exception_count &gt; 0"/>
                <field name="direct_grant_count" optional="show"/>
                <field name="stale_login_count" optional="show"/>
                <field name="no_2fa_count" optional="show"/>
                <field name="users_without_role_count" optional="show"/>
                <field name="reviewer_id"/>
                <field name="reviewed_on"/>
            </list>
        </field>
    </record>

    <record id="efn_access_review_view_form" model="ir.ui.view">
        <field name="name">efn.access.review.form</field>
        <field name="model">efn.access.review</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_efn_snapshot" type="object" string="Ambil ulang snapshot"
                            invisible="state != 'draft' or not id"/>
                    <button name="action_efn_start_review" type="object" string="Mulai review" class="btn-primary"
                            invisible="state != 'draft' or not id" groups="efn_audit.group_auditor"/>
                    <button name="action_efn_done" type="object" string="Selesai &amp; tandatangani" class="btn-primary"
                            invisible="state != 'in_review'" groups="efn_audit.group_auditor"
                            confirm="Review akan menjadi read-only. Lanjutkan?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="period" readonly="state != 'draft'"/>
                            <field name="snapshot_date"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_on"/>
                        </group>
                        <group>
                            <field name="user_count"/>
                            <field name="sod_violation_count"/>
                            <field name="exception_count"/>
                            <field name="expired_exception_count"/>
                            <field name="direct_grant_count"/>
                            <field name="stale_login_count"/>
                            <field name="no_2fa_count"/>
                            <field name="users_without_role_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snapshot" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="user_login" optional="hide"/>
                                    <field name="role_names"/>
                                    <field name="privilege_name"/>
                                    <field name="group_full_name"/>
                                    <field name="source" widget="badge"/>
                                    <field name="sod_codes" decoration-danger="sod_unexcepted"/>
                                    <field name="exception_state" optional="show"/>
                                    <field name="sod_unexcepted" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan / Temuan" name="notes">
                            <field name="notes" readonly="state == 'done'"
                                   placeholder="Temuan auditor, tindak lanjut. Rekonsiliasi cermin efn-cs-approver (BFF) dicatat di sini."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="efn_access_review_view_search" model="ir.ui.view">
        <field name="name">efn.access.review.search</field>
        <field name="model">efn.access.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="period"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_review" string="Sedang direview" domain="[('state', '=', 'in_review')]"/>
                <filter name="done" string="Selesai" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_period" string="Periode" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_access_review_action" model="ir.actions.act_window">
        <field name="name">Review Akses</field>
        <field name="res_model">efn.access.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="efn_access_review_view_search"/>
    </record>

    <!-- =================================================== efn.access.review.line -->
    <record id="efn_access_review_line_view_list" model="ir.ui.view">
        <field name="name">efn.access.review.line.list</field>
        <field name="model">efn.access.review.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="review_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="user_id"/>
                <field name="user_login" optional="show"/>
                <field name="user_active" optional="hide"/>
                <field name="login_date" optional="show"/>
                <field name="totp_enabled" optional="show"/>
                <field name="role_names"/>
                <field name="has_company_role" optional="hide"/>
                <field name="privilege_name"/>
                <field name="group_full_name"/>
                <field name="source" widget="badge"/>
                <field name="via_role_name" optional="hide"/>
                <field name="sod_codes" decoration-danger="sod_unexcepted"/>
                <field name="exception_id" optional="show"/>
                <field name="exception_state" optional="show"/>
                <field name="sod_unexcepted" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="efn_access_review_line_view_pivot" model="ir.ui.view">
        <field name="name">efn.access.review.line.pivot</field>
        <field name="model">efn.access.review.line</field>
        <field name="arch" type="xml">
            <pivot string="User x Privilege">
                <field name="user_id" type="row"/>
                <field name="privilege_name" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="efn_access_review_line_view_graph" model="ir.ui.view">
        <field name="name">efn.access.review.line.graph</field>
        <field name="model">efn.access.review.line</field>
        <field name="arch" type="xml">
            <graph string="Sumber grup" type="bar">
                <field name="source"/>
            </graph>
        </field>
    </record>

    <record id="efn_access_review_line_view_search" model="ir.ui.view">
        <field name="name">efn.access.review.line.search</field>
        <field name="model">efn.access.review.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="review_id"/>
                <field name="user_id"/>
                <field name="user_login"/>
                <field name="group_full_name"/>
                <field name="privilege_name"/>
                <field name="role_names"/>
                <filter name="src_role" string="Dari peran" domain="[('source', '=', 'role')]"/>
                <filter name="src_direct" string="Langsung" domain="[('source', '=', 'direct')]"/>
                <filter name="src_implied" string="Tersirat" domain="[('source', '=', 'implied')]"/>
                <separator/>
                <filter name="sod" string="Melanggar SoD" domain="[('sod_rule_ids', '!=', False)]"/>
                <filter name="sod_open" string="SoD tanpa pengecualian efektif" domain="[('sod_unexcepted', '=', True)]"/>
                <filter name="exc_expired" string="Pengecualian kedaluwarsa" domain="[('exception_state', '=', 'expired')]"/>
                <filter name="no_role" string="User tanpa peran di PT" domain="[('has_company_role', '=', False)]"/>
                <separator/>
                <filter name="refund_approver" string="Cermin efn-cs-approver"
                        domain="[('group_full_name', 'ilike', 'cermin BFF')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_privilege" string="Privilege" context="{'group_by': 'privilege_name'}"/>
                    <filter name="group_source" string="Sumber" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_access_review_line_action" model="ir.actions.act_window">
        <field name="name">Snapshot Review Akses</field>
        <field name="res_model">efn.access.review.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="efn_access_review_line_view_search"/>
    </record>
</odoo>
