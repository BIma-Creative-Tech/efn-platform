<?xml version="1.0" encoding="utf-8"?>
<!-- Grup penanda efn_role (docs/08 §12.3): TANPA ACL, TANPA implied_ids. Dipakai peran (Kasir, Approver Refund CS)
     dan aturan SoD (SOD-01, SOD-02). Selalu termasuk himpunan grup terkelola peran: untuk user yang dikelola
     peran, hanya bisa didapat lewat penetapan peran. Tidak diberikan otomatis ke siapa pun. -->
<odoo>
    <record id="module_category_efn_role" model="ir.module.category">
        <field name="name">EFN Peran</field>
        <field name="sequence">92</field>
    </record>

    <record id="res_groups_privilege_efn_role" model="res.groups.privilege">
        <field name="name">EFN Peran</field>
        <field name="category_id" ref="module_category_efn_role"/>
    </record>

    <record id="group_role_cashier" model="res.groups">
        <field name="name">Kasir (penanda peran)</field>
        <field name="comment">EFN Peran: penanda jabatan Kasir untuk SoD SOD-02 (Kasir tidak boleh memegang POS Administrator). Tanpa hak akses.</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_role"/>
    </record>

    <record id="group_refund_approver" model="res.groups">
        <field name="name">Refund Approver (cermin BFF)</field>
        <field name="comment">EFN Peran: cermin grup host BFF efn-cs-approver untuk laporan &amp; SoD SOD-01. Sumber kebenaran = BFF; tanpa hak akses di Odoo.</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_role"/>
    </record>
</odoo>
