<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_efn_coretax_rounding" model="ir.ui.view">
        <field name="name">account.move.form.inherit.efn.coretax.rounding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_id_efaktur_coretax.account_move_efaktur_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_id_coretax_document']" position="after">
                <field name="efn_coretax_adjustment_move_id" invisible="not efn_coretax_adjustment_move_id"/>
                <field name="efn_coretax_rounding_diff" invisible="not efn_coretax_adjustment_move_id"/>
                <field name="efn_coretax_source_move_id" invisible="not efn_coretax_source_move_id"/>
            </xpath>
        </field>
    </record>
</odoo>
