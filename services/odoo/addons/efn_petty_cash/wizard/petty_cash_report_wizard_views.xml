<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_petty_cash_report_wizard_form" model="ir.ui.view">
        <field name="name">efn.petty.cash.report.wizard.form</field>
        <field name="model">efn.petty.cash.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="report_kind"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="type_ids" widget="many2many_tags"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="date_from" invisible="report_kind != 'statement'"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_xlsx" type="object" string="Unduh XLSX" class="btn-primary"/>
                    <button name="action_pdf" type="object" string="Cetak PDF"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_efn_petty_cash_report_statement" model="ir.actions.act_window">
        <field name="name">Kartu Uang Muka</field>
        <field name="res_model">efn.petty.cash.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'statement'}</field>
    </record>
    <record id="action_efn_petty_cash_report_outstanding" model="ir.actions.act_window">
        <field name="name">Outstanding Uang Muka</field>
        <field name="res_model">efn.petty.cash.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'outstanding'}</field>
    </record>
    <record id="action_efn_petty_cash_report_aging" model="ir.actions.act_window">
        <field name="name">Aging Uang Muka</field>
        <field name="res_model">efn.petty.cash.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'aging'}</field>
    </record>
</odoo>
