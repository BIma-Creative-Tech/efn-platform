<?xml version="1.0" encoding="utf-8"?>
<!-- Sequence umum (company_id kosong = dipakai semua PT; jenis boleh punya sequence sendiri). -->
<odoo noupdate="1">
    <record id="seq_efn_petty_cash_request" model="ir.sequence">
        <field name="name">EFN Pengajuan Kas Kecil / Uang Muka</field>
        <field name="code">efn.petty.cash.request</field>
        <field name="prefix">KK/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_efn_petty_cash_realization" model="ir.sequence">
        <field name="name">EFN Realisasi Kas Kecil / Uang Muka</field>
        <field name="code">efn.petty.cash.realization</field>
        <field name="prefix">KKR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
