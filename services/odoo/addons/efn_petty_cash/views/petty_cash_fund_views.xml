<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_petty_cash_fund_list" model="ir.ui.view">
        <field name="name">efn.petty.cash.fund.list</field>
        <field name="model">efn.petty.cash.fund</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="holder_partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="float_amount"/>
                <field name="balance"/>
                <field name="unreplenished_amount"/>
                <field name="last_replenish_date" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_efn_petty_cash_fund_form" model="ir.ui.view">
        <field name="name">efn.petty.cash.fund.form</field>
        <field name="model">efn.petty.cash.fund</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_replenishment" type="object" string="Ajukan Pengisian Ulang"
                            class="btn-primary" invisible="state != 'active' or unreplenished_amount &lt;= 0"/>
                    <button name="action_close_fund" type="object" string="Tutup Dana"
                            invisible="state != 'active'" groups="efn_petty_cash.group_petty_cash_finance"
                            confirm="Sisa saldo dikembalikan ke bank dan fund ditutup. Lanjutkan?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_realizations" type="object" class="oe_stat_button" icon="fa-list"
                                string="Realisasi"/>
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-money"
                                string="Pengajuan Dana"/>
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book"
                                string="Entri Jurnal" groups="efn_petty_cash.group_petty_cash_finance"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="mis. Kas Kecil PB Kemang"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="holder_partner_id"/>
                            <field name="holder_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="float_amount"/>
                            <field name="limit_per_transaction"/>
                            <field name="balance"/>
                            <field name="unreplenished_amount"/>
                            <field name="last_replenish_date"/>
                        </group>
                    </group>
                    <group string="Analitik Outlet" groups="efn_petty_cash.group_petty_cash_finance">
                        <field name="analytic_precision" invisible="1"/>
                        <field name="analytic_distribution" widget="analytic_distribution"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_efn_petty_cash_fund" model="ir.actions.act_window">
        <field name="name">Dana Kas Kecil</field>
        <field name="res_model">efn.petty.cash.fund</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada dana kas kecil</p>
            <p>Finance membuat satu dana imprest per outlet (Konfigurasi), lalu dana awal dicairkan lewat pengajuan.</p>
        </field>
    </record>
</odoo>
