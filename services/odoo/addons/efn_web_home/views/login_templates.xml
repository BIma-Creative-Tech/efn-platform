<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Gaya ringan halaman login (G56). Hanya menambah kelas body + logo EFN di atas logo company.
        Form autentikasi (web.login: field, CSRF, action /web/login, TOTP) TIDAK diubah.
        Struktur web.login_layout diverifikasi di source Odoo 19.0 addons/web/views/webclient_templates.xml.
    -->
    <template id="login_layout_efn" inherit_id="web.login_layout" name="EFN Login Layout">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'bg-100 o_efn_login'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div[hasclass('border-bottom')]" position="before">
            <div class="text-center o_efn_login_brand">
                <img src="/efn_web_home/static/src/img/efn_logo.png" alt="EFN" class="o_efn_login_logo"/>
            </div>
        </xpath>
    </template>
</odoo>
