<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Multi-company: reservasi & outbox hanya terlihat di company yang aktif. -->
    <record id="efn_pos_loyalty_reservation_rule_company" model="ir.rule">
        <field name="name">EFN POS loyalty reservation: multi-company</field>
        <field name="model_id" ref="model_efn_pos_loyalty_reservation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="efn_pos_loyalty_outbox_rule_company" model="ir.rule">
        <field name="name">EFN POS loyalty outbox: multi-company</field>
        <field name="model_id" ref="model_efn_pos_loyalty_outbox"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
