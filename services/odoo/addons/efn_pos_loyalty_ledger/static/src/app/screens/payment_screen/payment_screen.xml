<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Poin EFN: tombol hanya saat online, pelanggan dipilih, bukan refund (docs/08 §6.3 G). -->
    <t t-name="efn_pos_loyalty_ledger.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="efnShowCheckPoints" class="d-flex flex-column flex-sm-row gap-1 w-100 efn-loyalty-buttons">
                <button class="button btn btn-secondary btn-lg w-100 lh-lg efn-check-points" t-on-click="() => this.efnCheckPoints()">
                    <i class="fa fa-star-o me-2" />Cek Poin
                </button>
                <button t-if="efnShowRedeem" class="button btn btn-secondary btn-lg w-100 lh-lg efn-redeem-points" t-on-click="() => this.efnRedeemPoints()">
                    <i class="fa fa-star me-2" />Tukar Poin EFN
                </button>
            </div>
        </xpath>
    </t>
</templates>
