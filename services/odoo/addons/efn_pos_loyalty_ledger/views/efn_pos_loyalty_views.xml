<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservasi tukar poin (cermin BFF). bff_reservation_id hanya untuk admin sistem. -->
    <record id="view_efn_pos_loyalty_reservation_list" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.reservation.list</field>
        <field name="model">efn.pos.loyalty.reservation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="state == 'review'" decoration-muted="state in ('released', 'expired')">
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="order_id"/>
                <field name="member_ref_masked"/>
                <field name="points"/>
                <field name="value_idr"/>
                <field name="state"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_efn_pos_loyalty_reservation_form" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.reservation.form</field>
        <field name="model">efn.pos.loyalty.reservation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="order_uuid"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="member_ref_masked"/>
                        </group>
                        <group>
                            <field name="points"/>
                            <field name="value_idr"/>
                            <field name="expires_at"/>
                            <field name="note"/>
                            <field name="bff_reservation_id" groups="base.group_system"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_efn_pos_loyalty_reservation_search" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.reservation.search</field>
        <field name="model">efn.pos.loyalty.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_uuid"/>
                <field name="config_id"/>
                <filter string="Perlu review" name="review" domain="[('state', '=', 'review')]"/>
                <filter string="Masih ditahan" name="reserved" domain="[('state', '=', 'reserved')]"/>
            </search>
        </field>
    </record>

    <record id="action_efn_pos_loyalty_reservation" model="ir.actions.act_window">
        <field name="name">Reservasi Poin EFN</field>
        <field name="res_model">efn.pos.loyalty.reservation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Outbox: payload tidak disimpan; hanya kunci, status, kode error. -->
    <record id="view_efn_pos_loyalty_outbox_list" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.outbox.list</field>
        <field name="model">efn.pos.loyalty.outbox</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'failed'" decoration-warning="state == 'hold'" decoration-muted="state == 'skipped'">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="order_id"/>
                <field name="idempotency_key"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="last_error"/>
                <field name="points_delta"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_efn_pos_loyalty_outbox_form" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.outbox.form</field>
        <field name="model">efn.pos.loyalty.outbox</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <!-- SEC-60: keputusan supervisor atas reverse yang ditahan (cek grup & company di server). -->
                    <button name="action_efn_hold_approve" type="object" string="Setujui &amp; kirim reverse"
                            class="btn-primary" invisible="state != 'hold' or last_error == 'restore_value_mismatch'"
                            groups="point_of_sale.group_pos_manager"
                            confirm="Reverse akan dikirim apa adanya, termasuk pengembalian poin yang ditukar. Lanjutkan?"/>
                    <!-- L-26: BFF menolak nilai restore poin; supervisor menyetujui nilai (restore_approved). -->
                    <button name="action_efn_restore_approve" type="object" string="Setujui nilai restore"
                            class="btn-primary" invisible="state != 'hold' or last_error != 'restore_value_mismatch'"
                            groups="point_of_sale.group_pos_manager"
                            confirm="BFF menolak nilai pengembalian poin. Reverse dikirim ulang dengan persetujuan Anda (dibatasi sisa poin yang ditukar, tercatat). Lanjutkan?"/>
                    <button name="action_efn_hold_cancel" type="object" string="Batalkan reverse"
                            invisible="state != 'hold'" groups="point_of_sale.group_pos_manager"
                            confirm="Tidak ada clawback/restore otomatis; penyesuaian poin dilakukan manual. Lanjutkan?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="idempotency_key"/>
                            <field name="order_id"/>
                            <field name="original_order_id" invisible="not original_order_id"/>
                            <field name="reservation_id" invisible="not reservation_id"/>
                        </group>
                        <group>
                            <field name="eligible_amount"/>
                            <field name="refund_ratio" invisible="kind != 'reverse'"/>
                            <field name="points_restored_value" invisible="kind != 'reverse'"/>
                            <field name="restore_approved" invisible="kind != 'reverse'"/>
                            <field name="attempt_count"/>
                            <field name="next_attempt_at"/>
                            <field name="last_error"/>
                            <field name="points_delta"/>
                            <field name="done_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_efn_pos_loyalty_outbox_search" model="ir.ui.view">
        <field name="name">efn.pos.loyalty.outbox.search</field>
        <field name="model">efn.pos.loyalty.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="idempotency_key"/>
                <field name="order_id"/>
                <filter string="Gagal" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Ditahan (review)" name="hold" domain="[('state', '=', 'hold')]"/>
                <filter string="Menunggu" name="pending" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <record id="action_efn_pos_loyalty_outbox" model="ir.actions.act_window">
        <field name="name">Outbox Poin EFN</field>
        <field name="res_model">efn.pos.loyalty.outbox</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_efn_pos_loyalty_reservation"
              name="Reservasi Poin EFN"
              parent="point_of_sale.menu_point_of_sale"
              action="action_efn_pos_loyalty_reservation"
              sequence="92"
              groups="point_of_sale.group_pos_manager,account.group_account_manager"/>
    <menuitem id="menu_efn_pos_loyalty_outbox"
              name="Outbox Poin EFN"
              parent="point_of_sale.menu_point_of_sale"
              action="action_efn_pos_loyalty_outbox"
              sequence="93"
              groups="point_of_sale.group_pos_manager,account.group_account_manager"/>
</odoo>
