<?xml version="1.0" encoding="utf-8"?>
<!-- G54: wizard kesiapan POS hanya melihat company yang boleh diakses user (multi-company). Mode apply juga dicek
     server-side (point_of_sale.group_pos_manager + account.group_account_manager) di wizard/efn_pos_setup_wizard.py. -->
<odoo noupdate="1">
    <record id="efn_pos_setup_wizard_rule_company" model="ir.rule">
        <field name="name">EFN POS setup wizard: multi-company</field>
        <field name="model_id" ref="model_efn_pos_setup_wizard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="efn_pos_setup_wizard_line_rule_company" model="ir.rule">
        <field name="name">EFN POS setup wizard line: multi-company</field>
        <field name="model_id" ref="model_efn_pos_setup_wizard_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
