<?xml version="1.0" encoding="utf-8"?>
<!-- W-25 (Gelombang 18) — keputusan pemilik proyek 10 Okt 2026 #12 (P-9/Q-K1): kasir BOLEH mendaftarkan pelanggan/
     member di POS (pendaftaran member tetap lewat OTP), HP member lama tetap terkunci (SEC-07/SEC-44).

     Standar CE 19 (terverifikasi base/security/ir.model.access.csv): create/write res.partner hanya untuk
     base.group_partner_manager ("Contact Creation"); POS membuat pelanggan lewat form standar. Hak itu biner (buat DAN
     ubah semua partner), sehingga kunci HP member = efn_pos_otp_gate/models/res_partner.py (depends modul ini):
     mengubah/mengosongkan HP partner yang sudah dipakai OTP hanya POS Manager/Settings, juga lewat sudo (SEC-44).

     Grup EFN terpisah (bukan mengubah point_of_sale.group_pos_user) agar hak membuat kontak hanya diberikan ke akun
     kasir yang ditunjuk: akun perangkat KDS (efn_pos_kds, allowlist SEC-74), user teknis kanal online, dan user POS
     lain tidak ikut mendapat Contact Creation. Admin menambahkan user kasir ke grup ini (Settings -> Users).
     Data pribadi (UU PDP): kasir hanya mengisi nama + HP (+ consent lewat OTP); SOP onboarding di README. -->
<odoo>
    <record id="res_groups_privilege_efn_pos_cashier" model="res.groups.privilege">
        <field name="name">EFN Kasir</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
    </record>

    <record id="group_efn_cashier_contact_creation" model="res.groups">
        <field name="name">Kasir: boleh membuat pelanggan</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_pos_cashier"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Kasir POS yang boleh mendaftarkan pelanggan baru (W-25). Memberi hak Contact Creation standar; nomor HP partner yang sudah menjadi member (riwayat OTP) tetap hanya bisa diubah POS Manager (efn_pos_otp_gate, SEC-07/SEC-44). Jangan diberikan ke akun perangkat KDS atau user teknis kanal online.</field>
    </record>
</odoo>
