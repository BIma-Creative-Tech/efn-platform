<?xml version="1.0" encoding="utf-8"?>
<!-- W-25 (Gelombang 18) — keputusan pemilik proyek 10 Okt 2026 #12 (P-9/Q-K1): kasir BOLEH mendaftarkan pelanggan/
     member di POS (pendaftaran member tetap lewat OTP, E-34), HP member tetap terkunci (SEC-07/SEC-44/SEC-115,
     efn_pos_otp_gate).

     SEC-121 (review r11, keputusan lead L-25i): grup ini SEMPIT, tidak lagi mewarisi base.group_partner_manager
     ("Contact Creation" standar = create/write/unlink SEMUA partner termasuk partner bersama lintas PT, dan
     create/write res.partner.bank rekening vendor; base/security/ir.model.access.csv baris 75 & 78). Hak kasir:
     - ACL res.partner: baca + BUAT saja (tanpa ubah, tanpa hapus). POS CE 19 tidak menulis partner di alur kasir
       (diperiksa: point_of_sale, pos_loyalty, pos_restaurant, pos_hr, pos_self_order, l10n_id_pos models), pelanggan
       baru dibuat lewat form standar (point_of_sale.res_partner_action_edit_pos, web_save -> create). Mengedit pelanggan
       yang sudah ada = supervisor/back office.
     - Record rule (grup ini): yang boleh dibuat hanya partner INDIVIDU (is_company = False), tanpa induk, dengan
       company_id = company POS aktif (bukan partner bersama company kosong, bukan PT lain). Default company_id diisi
       models/res_partner.py (form POS tidak menampilkan field company untuk kasir).
     - res.partner.bank: tanpa ACL tambahan -> hanya baca (base.group_user), tidak bisa membuat/mengubah rekening.
     Rule grup di Odoo di-OR antar grup user; rule "semua partner" untuk base.group_partner_manager menjaga user
     Contact Creation standar yang (keliru) ikut diberi grup ini tetap tidak dibatasi. User dengan hak tulis partner
     dari grup lain (Sales/Purchase/Stock/MRP manager) yang ikut diberi grup ini justru dibatasi rule ini (gagal
     tertutup) -> grup hanya untuk akun kasir (README). Jangan diberikan ke akun perangkat KDS atau user teknis online.
     Data pribadi (UU PDP): kasir hanya mengisi nama + HP (+ consent & pernyataan usia lewat OTP). -->
<odoo>
    <record id="res_groups_privilege_efn_pos_cashier" model="res.groups.privilege">
        <field name="name">EFN Kasir</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
    </record>

    <record id="group_efn_cashier_contact_creation" model="res.groups">
        <field name="name">Kasir: boleh membuat pelanggan</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_pos_cashier"/>
        <!-- SEC-121: (6, 0, ...) agar implied base.group_partner_manager versi 19.0.1.6..1.8 terhapus saat upgrade. -->
        <field name="implied_ids" eval="[(6, 0, [ref('point_of_sale.group_pos_user')])]"/>
        <field name="comment">Kasir POS yang boleh mendaftarkan pelanggan baru (W-25, SEC-121): hanya membuat pelanggan individu milik company POS aktif; tidak bisa mengubah/menghapus pelanggan yang sudah ada, partner bersama lintas PT, atau rekening bank. Hanya untuk akun kasir (bukan perangkat KDS, user teknis online, atau staf back office).</field>
    </record>

    <record id="access_res_partner_efn_cashier_create" model="ir.model.access">
        <field name="name">res.partner kasir EFN: baca + buat</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_id" ref="group_efn_cashier_contact_creation"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_res_partner_efn_cashier_create" model="ir.rule">
        <field name="name">EFN kasir: hanya pelanggan individu di company POS aktif (SEC-121)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('group_efn_cashier_contact_creation')])]"/>
        <field name="domain_force">[('is_company', '=', False), ('parent_id', '=', False), ('company_id', '=', company_id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_res_partner_efn_partner_manager_all" model="ir.rule">
        <field name="name">EFN: Contact Creation standar tidak dibatasi rule kasir (SEC-121)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_partner_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
