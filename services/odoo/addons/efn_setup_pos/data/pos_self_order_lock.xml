     noupdate=0: dijalankan setiap install/upgrade -> default ditegakkan ulang dan config lama
     ber-mode mobile/QR menu dinormalkan (kecuali efn.pos.self_order_mobile_allowed benar). -->
<odoo>
    <function model="ir.default" name="set" eval="('pos.config', 'self_ordering_mode', 'nothing')"/>
    <function model="pos.config" name="_efn_normalize_self_order_mode"/>
</odoo>
