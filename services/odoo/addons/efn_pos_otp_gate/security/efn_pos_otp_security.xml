<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Multi-company: challenge OTP hanya terlihat di company yang aktif. -->
    <record id="efn_pos_otp_challenge_rule_company" model="ir.rule">
        <field name="name">EFN POS OTP challenge: multi-company</field>
        <field name="model_id" ref="model_efn_pos_otp_challenge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
