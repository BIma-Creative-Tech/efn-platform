<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- G58 §4.3: semua field template diaudit (efn_audit; pengganti pdp.audited.mixin sumber). -->
        <record id="audit_rule_efn_bank_import_template" model="efn.audit.rule">
            <field name="name">EFN - Template Impor Mutasi Bank</field>
            <field name="model_id" ref="model_efn_bank_import_template"/>
            <field name="log_create" eval="True"/>
            <field name="log_write" eval="True"/>
            <field name="log_unlink" eval="True"/>
            <field name="capture_unlink_values" eval="True"/>
        </record>
    </data>
    <!-- Contoh struktur per company (generik bertanda + BCA korporat), idempoten; bukan data klien. -->
    <function model="efn.bank.import.template" name="_efn_ensure_default_templates"/>
</odoo>
