<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efn_bank_import_wizard_form" model="ir.ui.view">
        <field name="name">efn.bank.import.wizard.form</field>
        <field name="model">efn.bank.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Impor Mutasi Bank">
                <group>
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="company_id" invisible="1"/>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="statement_name"/>
                </group>
                <p class="text-muted">
                    CSV saja (maks. 10 MB / 20.000 baris). Tanggal pada atau sebelum tanggal kunci menolak seluruh file.
                    Baris yang sudah pernah diimpor ke jurnal ini dilewati. File asli tidak disimpan.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Impor" class="btn-primary"/>
                    <button special="cancel" string="Batal"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_efn_bank_import_wizard" model="ir.actions.act_window">
        <field name="name">Impor Mutasi Bank</field>
        <field name="res_model">efn.bank.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
