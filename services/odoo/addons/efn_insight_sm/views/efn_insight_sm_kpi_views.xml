<?xml version="1.0" encoding="utf-8"?>
<!-- G47 (docs/04 §28.13.8c, fit-gap G47 §4.2). "Kembalikan ke default" = isi nilai default atau arsipkan baris
     (baris arsip tetap memakan slot unik; aktifkan kembali, jangan buat baru). -->
<odoo>
    <record id="efn_insight_sm_kpi_view_list" model="ir.ui.view">
        <field name="name">efn.insight.sm.kpi.list</field>
        <field name="model">efn.insight.sm.kpi</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active" decoration-info="not is_default">
                <field name="company_id" readonly="id" groups="base.group_multi_company"/>
                <field name="key" readonly="id"/>
                <field name="value"/>
                <field name="default_value"/>
                <field name="allowed_values"/>
                <field name="value_type" optional="hide"/>
                <field name="is_default" optional="show"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="efn_insight_sm_kpi_view_search" model="ir.ui.view">
        <field name="name">efn.insight.sm.kpi.search</field>
        <field name="model">efn.insight.sm.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="archived" string="Diarsipkan (= default)" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_company" string="PT" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_efn_insight_sm_kpi" model="ir.actions.act_window">
        <field name="name">Definisi KPI Insight (Supermarket)</field>
        <field name="res_model">efn.insight.sm.kpi</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="efn_insight_sm_kpi_view_search"/>
        <field name="context">{'search_default_group_company': 1}</field>
        <field name="help" type="html">
            <p>Definisi &amp; ambang KPI Insight per PT supermarket. Baris tidak ada atau diarsipkan = default kontrak.
                Perubahan berlaku di Insight setelah siklus ETL berikutnya (maks ±15 menit) dan ikut mengubah angka
                historis. Setiap perubahan tercatat di EFN Audit.</p>
        </field>
    </record>

    <!-- Parent Inventory > Configuration (stock.menu_stock_config_settings, terverifikasi 19.0). Menu induk berhak
         akses Inventory: pengelola KPI tanpa hak Inventory memakai tautan /odoo/action-efn_insight_sm.action_efn_insight_sm_kpi
         (README). -->
    <menuitem id="menu_efn_insight_sm_kpi" name="Definisi KPI Insight (Supermarket)"
              parent="stock.menu_stock_config_settings" action="action_efn_insight_sm_kpi" sequence="90"
              groups="group_insight_kpi_admin"/>
</odoo>
