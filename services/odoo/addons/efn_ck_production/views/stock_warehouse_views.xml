<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_efn_ck" model="ir.ui.view">
        <field name="name">stock.warehouse.form.efn.ck</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="efn_is_central_kitchen"/>
                <field name="efn_ck_supplier_wh_id" invisible="efn_is_central_kitchen"/>
                <field name="efn_ck_supply_route_id" invisible="not efn_ck_supplier_wh_id"/>
            </xpath>
        </field>
    </record>
</odoo>
