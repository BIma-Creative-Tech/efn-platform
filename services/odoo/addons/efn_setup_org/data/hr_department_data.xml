<?xml version="1.0" encoding="utf-8"?>
<!-- G21 W-31 (docs/04 §13.3 no. 1, keputusan 18-24): templat departemen hr CE per PT.

     noupdate="1": dimuat sekali saat install. Pengguna (HR/Superadmin) boleh mengganti nama, menyusun induk
     (parent_id), mengisi manajer (manager_id = karyawan), atau MENGARSIPKAN departemen yang tidak dipakai PT itu
     (mis. "Operasional Toko & Outlet" di Holding EFN) tanpa ditimpa saat upgrade. Jangan menghapus record yang
     dipakai efn_role (jabatan -> peran): arsipkan saja.

     Templat SAMA untuk 6 PT (keputusan klien belum ada tentang departemen mana yang berlaku per PT -> Q-ORG-1).
     company_id ditulis eksplisit: hr.department.company_id = compute stored readonly=False dari parent_id dengan
     default env.company (terverifikasi hr/models/hr_department.py 19.0) -> tanpa induk, nilai eksplisit dipakai.
     Nama orang TIDAK ada di data (18-24, 18-40): manajer & karyawan diisi klien lewat UI.
     Nama tanpa " / " karena complete_name 19.0 memakai " / " sebagai pemisah hierarki.

     xmlid: dept_<kode>_<pt>, pt = efn | gl | pb | bcr | bcf | wtz | farm (kode entitas 18-41; xmlid company lama
     company_rtl = GL, company_fnb = PB dipertahankan L-48). -->
<odoo noupdate="1">

    <!-- ===================== Holding EFN (EFN) ===================== -->
    <record id="dept_board_efn" model="hr.department">
        <field name="name">Direksi</field>
        <field name="company_id" ref="efn_setup_company.company_efn"/>
    </record>
