<?xml version="1.0" encoding="utf-8"?>
<!-- G42 (ADR-041 Proposed, docs/04 §26) + G52 (docs/04 §28.15.2-§28.15.3, ADR-041 §3.6 Proposed).
     Penetapan grup ke peran (efn_setup_role) menunggu Q-INS1; jangan otomatis. -->
<odoo>
    <record id="module_category_efn_insight" model="ir.module.category">
        <field name="name">EFN Dashboard Insight</field>
        <field name="sequence">94</field>
    </record>

    <record id="res_groups_privilege_efn_insight" model="res.groups.privilege">
        <field name="name">EFN Dashboard Insight</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <!-- G47: tampil pertama; privilege persona memakai sequence 20..70. -->
        <field name="sequence">10</field>
    </record>

    <!-- Cakupan = PT ber-kode ESB di company_ids user (PT arsip tidak ikut). -->
    <record id="group_insight_user" model="res.groups">
        <field name="name">Insight: pengguna</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_insight"/>
    </record>
    <!-- Holding/direksi/analis: semua kode ESB (PB, WTZ, BCF, BCR, IMD, CUP) tanpa melihat company_ids.
         User Holding (company EFN) TANPA grup ini mendapat 0 kode. -->
    <record id="group_insight_all_brands" model="res.groups">
        <field name="name">Insight: semua brand/Holding</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_insight"/>
        <field name="implied_ids" eval="[(4, ref('group_insight_user'))]"/>
    </record>

    <!-- ================================================================== persona (G52, L-239)
         Dipindah dari efn_insight_sm dengan NAMA XMLID TETAP (pre-migrate 19.0.3.0.0 di efn_insight dan efn_insight_sm
         mengganti ir_model_data.module): id grup dan keanggotaan user tidak berubah. Nama privilege tetap
         `res_groups_privilege_insight_sm_*` (historis).
         SATU privilege per grup: widget hak akses Odoo 19 (res_user_group_ids_field) menampilkan setiap privilege
         sebagai satu pilihan dan menulis Command.set; dua grup dalam satu privilege tidak bisa dipegang bersamaan.
         Persona = hak DATA saja (tidak meng-implies grup tindakan). F&B memakai exec/store/marketing; category/dc
         khusus supermarket. Sensitif (efn_role SENSITIVE_GROUP_XMLIDS): exec, category, dc, marketing (bukan store).
         group_insight_kpi_admin tetap di efn_insight_sm. -->
    <record id="res_groups_privilege_insight_sm_exec" model="res.groups.privilege">
        <field name="name">Insight: Direksi</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">20</field>
        <field name="placeholder">–</field>
        <field name="description">F&amp;B: PT penuh, halaman Eksekutif (margin kotor, YoY, MDR, peringkat cabang). Supermarket: semua toko dan DC, margin, GMROI, nilai stok, PO. Tidak memberi hak menyetujui apa pun.</field>
    </record>
    <record id="res_groups_privilege_insight_sm_category" model="res.groups.privilege">
        <field name="name">Insight: Category manager (supermarket)</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">30</field>
        <field name="placeholder">–</field>
        <field name="description">Supermarket saja: semua toko PT supermarket termasuk margin dan GMROI; filter awal = "Kategori dikelola (Insight)" di form user. Tidak berpengaruh di F&amp;B. Tidak memberi hak menyetujui apa pun.</field>
    </record>
    <record id="res_groups_privilege_insight_sm_store" model="res.groups.privilege">
        <field name="name">Insight: Kepala toko</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">40</field>
        <field name="placeholder">–</field>
        <field name="description">F&amp;B: hanya cabang di "Cabang ESB dikelola (Insight)", tanpa HPP/margin/MDR. Supermarket: hanya outlet di "Outlet dikelola (kepala toko)". Bersama Marketing/DC/Category (tanpa Direksi), Kepala toko diabaikan. Tidak memberi hak menyetujui usulan.</field>
    </record>
    <record id="res_groups_privilege_insight_sm_dc" model="res.groups.privilege">
        <field name="name">Insight: DC/logistik (supermarket)</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">50</field>
        <field name="placeholder">–</field>
        <field name="description">Supermarket saja: semua toko dan DC PT supermarket: fill rate, usulan, nilai stok, PO supplier; tanpa margin/GMROI. Tidak berpengaruh di F&amp;B. Tidak memberi hak menyetujui apa pun.</field>
    </record>
    <record id="res_groups_privilege_insight_sm_marketing" model="res.groups.privilege">
        <field name="name">Insight: Marketing</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">60</field>
        <field name="placeholder">–</field>
        <field name="description">F&amp;B: PT penuh, halaman Marketing (diskon, kanal bayar, porsi takeaway perkiraan). Supermarket: funnel pengunjung (agregat, k-anonim), segmen, kampanye, harga vs pasar. Tidak memberi hak kampanye di Odoo.</field>
    </record>

    <record id="group_insight_exec" model="res.groups">
        <field name="name">Insight: Direksi</field>
        <field name="comment">Persona exec. F&amp;B: PT ESB di company_ids. SMD: semua warehouse + baris tingkat PT (wids 0). Hak data saja.</field>
        <field name="privilege_id" ref="res_groups_privilege_insight_sm_exec"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>
    <record id="group_insight_category" model="res.groups">
        <field name="name">Insight: Category manager (supermarket)</field>
        <field name="comment">Persona category (SMD saja): semua warehouse PT supermarket + wids 0; cats = kategori dikelola. Hak data saja.</field>
        <field name="privilege_id" ref="res_groups_privilege_insight_sm_category"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>
    <record id="group_insight_store" model="res.groups">
        <field name="name">Insight: Kepala toko</field>
        <field name="comment">Persona store. F&amp;B: hanya cabang efn_insight_esb_branch_ids (brs). SMD: hanya outlet efn_outlet_warehouse_ids (tanpa wids 0). Hak data saja.</field>
        <field name="privilege_id" ref="res_groups_privilege_insight_sm_store"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>
    <record id="group_insight_dc" model="res.groups">
        <field name="name">Insight: DC/logistik (supermarket)</field>
        <field name="comment">Persona dc (SMD saja): semua warehouse PT supermarket + wids 0; nilai stok &amp; PO, tanpa margin/GMROI. Hak data saja.</field>
        <field name="privilege_id" ref="res_groups_privilege_insight_sm_dc"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>
    <record id="group_insight_marketing" model="res.groups">
        <field name="name">Insight: Marketing</field>
        <field name="comment">Persona marketing. F&amp;B: PT ESB di company_ids. SMD: semua warehouse + wids 0; funnel/segmen/kampanye agregat. Hak data saja.</field>
        <field name="privilege_id" ref="res_groups_privilege_insight_sm_marketing"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>

    <!-- ================================================================== production planning (G66)
         docs/04 §30.7, ADR-051 Proposed. Peran pp_planner / pp_warehouse di token eit3 (BUKAN persona: tidak masuk
         PERSONA_GROUPS / SQL_efn_personas). Satu privilege per grup (pola persona, widget hak akses Odoo 19).
         Tidak ikut sinkron jabatan (efn_role). Satu user boleh memegang keduanya; SoD ditegakkan per dokumen di
         services/prodplan, bukan di sini. -->
    <record id="res_groups_privilege_prodplan_planner" model="res.groups.privilege">
        <field name="name">Insight: Production planner CK</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">80</field>
        <field name="placeholder">–</field>
        <field name="description">F&amp;B (data ESB): halaman Produksi di Insight — membuat dan menyetujui rencana produksi Central Kitchen, mengajukan transfer dan memposting dokumen produksi ke ESB. Persetujuan tidak boleh atas dokumen buatan sendiri (ditegakkan aplikasi). Tidak berlaku untuk kepala toko yang dibatasi cabang.</field>
    </record>
    <record id="res_groups_privilege_prodplan_warehouse" model="res.groups.privilege">
        <field name="name">Insight: Kepala gudang (persetujuan transfer)</field>
        <field name="category_id" ref="module_category_efn_insight"/>
        <field name="sequence">90</field>
        <field name="placeholder">–</field>
        <field name="description">F&amp;B (data ESB): halaman Produksi di Insight — menyetujui transfer bahan antar-gudang yang diajukan planner. Tidak bisa menyetujui transfer yang diajukannya sendiri (ditegakkan aplikasi). Tidak berlaku untuk kepala toko yang dibatasi cabang.</field>
    </record>

    <record id="group_prodplan_planner" model="res.groups">
        <field name="name">Insight: Production planner CK</field>
        <field name="comment">Peran pp_planner (token eit3). Wajib PT ESB di cakupan dan tanpa cabang kepala toko (T9); selain itu peran dibuang saat membuka Insight.</field>
        <field name="privilege_id" ref="res_groups_privilege_prodplan_planner"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>
    <record id="group_prodplan_warehouse" model="res.groups">
        <field name="name">Insight: Kepala gudang (persetujuan transfer)</field>
        <field name="comment">Peran pp_warehouse (token eit3). Wajib PT ESB di cakupan dan tanpa cabang kepala toko (T9); selain itu peran dibuang saat membuka Insight.</field>
        <field name="privilege_id" ref="res_groups_privilege_prodplan_warehouse"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insight_user'))]"/>
    </record>

    <!-- ================================================================== record rule (G52) -->
    <data noupdate="1">
        <record id="efn_insight_esb_branch_rule_company" model="ir.rule">
            <field name="name">EFN Insight cabang ESB: multi-company</field>
            <field name="model_id" ref="model_efn_insight_esb_branch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
