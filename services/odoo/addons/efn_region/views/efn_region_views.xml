<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="efn_region_view_list" model="ir.ui.view">
        <field name="name">efn.region.list</field>
        <field name="model">efn.region</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="province_code"/>
                <field name="state_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="efn_region_view_form" model="ir.ui.view">
        <field name="name">efn.region.form</field>
        <field name="model">efn.region</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code" placeholder="31.71"/>
                            <field name="name"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="province_code"/>
                            <field name="state_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="source"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_region_view_search" model="ir.ui.view">
        <field name="name">efn.region.search</field>
        <field name="model">efn.region</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="province_code"/>
                <filter name="inactive" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="efn_region_action" model="ir.actions.act_window">
        <field name="name">Wilayah (Kab/Kota)</field>
        <field name="res_model">efn.region</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="efn_region_menu"
        name="Wilayah (Kab/Kota)"
        parent="contacts.res_partner_menu_config"
        action="efn_region_action"
        sequence="50"
    />
</odoo>
