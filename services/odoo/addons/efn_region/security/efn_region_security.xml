<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: wilayah referensi bersama (company kosong) terlihat semua PT; wilayah khusus PT hanya PT itu. -->
    <record id="efn_region_rule_company" model="ir.rule">
        <field name="name">EFN Wilayah: multi-company</field>
        <field name="model_id" ref="model_efn_region"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
