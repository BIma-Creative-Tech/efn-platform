<?xml version="1.0" encoding="utf-8"?>
<!-- Tiket KDS (baca-saja untuk manager POS). KPI waktu tunggu/SLA dilaporkan lewat ETL ->
     ClickHouse -> Metabase (docs/08 §7.3), bukan laporan Odoo. -->
<odoo>
    <record id="efn_kds_ticket_view_list" model="ir.ui.view">
        <field name="name">efn.kds.ticket.list</field>
        <field name="model">efn.kds.ticket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="sent_at"/>
                <field name="station_id"/>
                <field name="order_id"/>
                <field name="table_label"/>
                <field name="tracking_number"/>
                <field name="course_index" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="printed_offline" optional="hide"/>
                <field name="wait_seconds"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="efn_kds_ticket_view_form" model="ir.ui.view">
        <field name="name">efn.kds.ticket.form</field>
        <field name="model">efn.kds.ticket</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="station_id"/>
                            <field name="order_id"/>
                            <field name="table_label"/>
                            <field name="tracking_number"/>
                            <field name="preset_name"/>
                            <field name="course_index"/>
                            <field name="internal_note"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="started_at"/>
                            <field name="ready_at"/>
                            <field name="served_at"/>
                            <field name="cancelled_at"/>
                            <field name="wait_seconds"/>
                            <field name="printed_offline"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_name"/>
                            <field name="qty_delta"/>
                            <field name="attribute_text"/>
                            <field name="note"/>
                            <field name="combo_parent_name"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_kds_ticket_view_search" model="ir.ui.view">
        <field name="name">efn.kds.ticket.search</field>
        <field name="model">efn.kds.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="station_id"/>
                <field name="table_label"/>
                <filter name="active_tickets" string="Aktif" domain="[('state', 'in', ('new', 'in_progress', 'ready'))]"/>
                <filter name="group_station" string="Stasiun" context="{'group_by': 'station_id'}"/>
            </search>
        </field>
    </record>

    <record id="efn_kds_ticket_action" model="ir.actions.act_window">
        <field name="name">Tiket KDS</field>
        <field name="res_model">efn.kds.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_tickets': 1}</field>
    </record>

    <menuitem id="efn_kds_ticket_menu"
              name="Tiket KDS"
              parent="point_of_sale.menu_point_of_sale"
              action="efn_kds_ticket_action"
              groups="point_of_sale.group_pos_manager"
              sequence="50"/>
</odoo>
