<?xml version="1.0" encoding="utf-8"?>
<!-- efn_promo (docs/04 §18.1): Pengelola Promo (tim marketing) + user teknis BFF tanpa ACL dokumen; multi-company. -->
<odoo>
    <record id="res_groups_privilege_efn_promo" model="res.groups.privilege">
        <field name="name">EFN Promo Super-App</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_promo_manager" model="res.groups">
        <field name="name">Pengelola Promo</field>
        <field name="comment">Mengelola banner slider dan pop-up promo Super-App (web &amp; aplikasi), termasuk mengantrekan push.</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_promo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_promo_bff" model="res.groups">
        <field name="name">Layanan promo (user teknis BFF)</field>
        <field name="comment">User teknis BFF (/json/2 lewat odoo-rpc-gateway). Hanya Internal User + grup ini, tepat satu company. Tanpa akses dokumen langsung.</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_promo"/>
        <field name="api_key_duration">35</field>
    </record>

    <data noupdate="1">
        <record id="efn_promo_banner_rule_company" model="ir.rule">
            <field name="name">EFN banner promo: multi-company</field>
            <field name="model_id" ref="model_efn_promo_banner"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="efn_promo_popup_rule_company" model="ir.rule">
            <field name="name">EFN pop-up promo: multi-company</field>
            <field name="model_id" ref="model_efn_promo_popup"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
