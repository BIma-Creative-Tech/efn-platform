<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      G60-A: Payment Voucher (keluar) / Payment Receipt (masuk) pada account.payment.
      Port dari odoo-platform custom_levis_localization/reports/payment_*_templates.xml (ADR-049): rename xmlid,
      tanpa branding klien lain, + blok persetujuan EFN (disiapkan / diperiksa / disetujui) + masking rekening tujuan.

      Aman untuk wkhtmltopdf: style inline + layout <table>; angka lewat makro efn_voucher_money tanpa NBSP
      (widget monetary memancarkan U+00A0 yang tampil sebagai karakter liar di PDF).
    -->

    <!-- Angka format Indonesia ('.' ribuan, ',' desimal); desimal mengikuti mata uang (IDR -> 0).
         Butuh di scope: amount (float), currency (res.currency). -->
    <template id="efn_voucher_money">
        <t t-set="_dp" t-value="int(currency.decimal_places)"/>
        <t t-set="_raw" t-value="'{:,.{dp}f}'.format(abs(amount or 0.0), dp=_dp)"/>
        <t t-set="_raw" t-value="_raw.replace(',', '\x00').replace('.', ',').replace('\x00', '.')"/>
        <t t-set="_sign" t-value="'-' if (amount or 0.0) &lt; 0 else ''"/>
        <span style="white-space: nowrap;"><t t-out="_sign"/><t t-out="_raw"/></span>
    </template>

    <!-- Tanggal panjang Indonesia: "3 Juli 2026" (pemanggil set `d`). -->
    <template id="efn_voucher_id_date">
        <t t-set="_bulan" t-value="['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember']"/>
        <t t-if="d"><t t-out="d.day"/> <t t-out="_bulan[d.month]"/> <t t-out="d.year"/></t>
    </template>

    <!-- Badan bersama Payment Voucher & Payment Receipt. -->
    <template id="report_efn_payment_document">
        <t t-set="is_inbound" t-value="o.payment_type == 'inbound'"/>
        <t t-set="rows" t-value="o._efn_voucher_rows()"/>
        <t t-set="rbank" t-value="o._efn_voucher_recipient_bank()"/>
        <t t-set="ccur" t-value="o.company_id.currency_id"/>
        <t t-set="total_debit" t-value="sum([r['debit'] for r in rows])"/>
        <t t-set="total_credit" t-value="sum([r['credit'] for r in rows])"/>

        <div class="page" style="font-size: 11px;">
            <div t-if="o.efn_approval_state in ('to_approve', 'rejected') or (o.state == 'draft' and o.efn_needs_approval and o.efn_approval_state != 'approved')"
                 style="border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 4px; margin-bottom: 8px;">
                BELUM DISETUJUI
            </div>
            <div style="margin-bottom: 12px;">
                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 45px; max-width: 200px;" alt="Logo"/>
                <div style="font-weight: bold; font-size: 14px; margin-top: 4px;" t-out="o.company_id.name"/>
                <div style="font-weight: bold; font-size: 13px; letter-spacing: 1px;" t-out="doc_title"/>
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                <tr>
                    <td style="width: 13%; padding: 2px 4px; vertical-align: top;">Nomor Voucher</td>
                    <td style="width: 37%; padding: 2px 4px; vertical-align: top;">: <t t-out="o.name or 'Draft'"/></td>
                    <td style="width: 13%; padding: 2px 4px; vertical-align: top;">Bank</td>
                    <td style="width: 37%; padding: 2px 4px; vertical-align: top;">: <t t-out="o.journal_id.bank_account_id.bank_id.name or o.journal_id.name or ''"/></td>
                </tr>
                <tr>
                    <td style="padding: 2px 4px; vertical-align: top;">Tanggal</td>
                    <td style="padding: 2px 4px; vertical-align: top;">: <t t-call="efn_account_localization.efn_voucher_id_date"><t t-set="d" t-value="o.date"/></t></td>
                    <td style="padding: 2px 4px; vertical-align: top;">No. Rekening</td>
                    <td style="padding: 2px 4px; vertical-align: top;">: <t t-out="o._efn_voucher_source_bank_account()"/></td>
                </tr>
                <tr>
                    <td style="padding: 2px 4px;"/>
                    <td style="padding: 2px 4px;"/>
                    <td style="padding: 2px 4px; vertical-align: top;">Metode</td>
                    <td style="padding: 2px 4px; vertical-align: top;">: <t t-out="o.payment_method_line_id.name or ''"/><t t-if="o.journal_id"> (<t t-out="o.journal_id.name"/>)</t></td>
                </tr>
                <tr>
                    <td style="padding: 2px 4px;"/>
                    <td style="padding: 2px 4px;"/>
                    <td style="padding: 2px 4px; vertical-align: top;">Referensi</td>
                    <td style="padding: 2px 4px; vertical-align: top;">: <t t-out="o.payment_reference or ''"/></td>
                </tr>
            </table>

            <table style="width: 100%; border-collapse: collapse; font-size: 9px; margin-bottom: 8px;">
                <thead>
                    <tr style="background-color: #f3f3f3;">
                        <th style="width: 3%; border: 1px solid #000; padding: 3px; text-align: center;">No</th>
                        <th style="width: 12%; border: 1px solid #000; padding: 3px; text-align: left;">Akun (COA)</th>
                        <th style="width: 16%; border: 1px solid #000; padding: 3px; text-align: left;">Keterangan</th>
                        <th style="width: 11%; border: 1px solid #000; padding: 3px; text-align: left;">No. Dokumen</th>
                        <th style="width: 11%; border: 1px solid #000; padding: 3px; text-align: left;">Ref. Faktur Vendor</th>
                        <th style="width: 11%; border: 1px solid #000; padding: 3px; text-align: left;">Partner</th>
                        <th style="width: 4%; border: 1px solid #000; padding: 3px; text-align: center;">Mata Uang</th>
                        <th style="width: 9%; border: 1px solid #000; padding: 3px; text-align: right;">Nilai Asal</th>
                        <th style="width: 5%; border: 1px solid #000; padding: 3px; text-align: right;">Kurs</th>
                        <th style="width: 9%; border: 1px solid #000; padding: 3px; text-align: right;">DEBIT</th>
                        <th style="width: 9%; border: 1px solid #000; padding: 3px; text-align: right;">KREDIT</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="r">
                        <td style="border: 1px solid #000; padding: 3px; text-align: center;" t-out="r_index + 1"/>
                        <td style="border: 1px solid #000; padding: 3px;" t-out="r['coa']"/>
                        <td style="border: 1px solid #000; padding: 3px; white-space: pre-line;" t-out="r['desc']"/>
                        <td style="border: 1px solid #000; padding: 3px;" t-out="r['doc_ap']"/>
                        <td style="border: 1px solid #000; padding: 3px;" t-out="r['ref_vendor']"/>
                        <td style="border: 1px solid #000; padding: 3px;" t-out="r['vendor']"/>
                        <td style="border: 1px solid #000; padding: 3px; text-align: center;" t-out="r['currency']"/>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;"><t t-call="efn_account_localization.efn_voucher_money"><t t-set="amount" t-value="r['orig_amount']"/><t t-set="currency" t-value="o.currency_id"/></t></td>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;" t-out="'{:.2f}'.format(r['rate'])"/>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;"><t t-call="efn_account_localization.efn_voucher_money"><t t-set="amount" t-value="r['debit']"/><t t-set="currency" t-value="ccur"/></t></td>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;"><t t-call="efn_account_localization.efn_voucher_money"><t t-set="amount" t-value="r['credit']"/><t t-set="currency" t-value="ccur"/></t></td>
                    </tr>
                    <tr style="font-weight: bold; background-color: #f3f3f3;">
                        <td colspan="9" style="border: 1px solid #000; padding: 3px; text-align: right;">Total</td>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;"><t t-call="efn_account_localization.efn_voucher_money"><t t-set="amount" t-value="total_debit"/><t t-set="currency" t-value="ccur"/></t></td>
                        <td style="border: 1px solid #000; padding: 3px; text-align: right;"><t t-call="efn_account_localization.efn_voucher_money"><t t-set="amount" t-value="total_credit"/><t t-set="currency" t-value="ccur"/></t></td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-bottom: 12px;">
                <span style="font-weight: bold;">Terbilang :</span>
                <span style="font-style: italic;" t-out="o._efn_voucher_amount_in_words()"/>
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                <tr>
                    <td style="width: 13%; padding: 1px 4px; vertical-align: top;">Keterangan</td>
                    <td style="padding: 1px 4px;">: <t t-out="o.memo or ''"/></td>
                </tr>
                <tr>
                    <td style="padding: 1px 4px;">Bank Tujuan</td>
                    <td style="padding: 1px 4px;">: <t t-out="rbank['bank_name']"/></td>
                </tr>
                <tr>
                    <td style="padding: 1px 4px;">No. Rekening</td>
                    <td style="padding: 1px 4px;">: <t t-out="rbank['acc_number']"/></td>
                </tr>
                <tr>
                    <td style="padding: 1px 4px;" t-out="'Atas Nama' if not is_inbound else 'Dari Rekening'"/>
                    <td style="padding: 1px 4px;">: <t t-out="rbank['acc_holder']"/></td>
                </tr>
                <tr>
                    <td style="padding: 1px 4px;">Cabang</td>
                    <td style="padding: 1px 4px;">: <t t-out="rbank['branch']"/></td>
                </tr>
                <tr>
                    <td style="padding: 1px 4px;">Kode SWIFT</td>
                    <td style="padding: 1px 4px;">: <t t-out="rbank['swift']"/></td>
                </tr>
            </table>

            <table style="width: 100%; border-collapse: collapse; text-align: center;">
                <tr>
                    <td style="width: 25%; padding: 4px;">Disiapkan</td>
                    <td style="width: 25%; padding: 4px;">Diperiksa</td>
                    <td style="width: 25%; padding: 4px;">Disetujui</td>
                    <td style="width: 25%; padding: 4px;" t-out="'Dibayar oleh' if is_inbound else 'Diterima oleh'"/>
                </tr>
                <tr style="height: 55px;"><td/><td/><td/><td/></tr>
                <tr>
                    <td style="padding: 4px 4px 0; border-top: 1px solid #000;" t-out="o.create_uid.name or ''"/>
                    <td style="padding: 4px 4px 0; border-top: 1px solid #000;" t-out="o.efn_approval_requested_by_id.name or '(________________)'"/>
                    <td style="padding: 4px 4px 0; border-top: 1px solid #000;" t-out="(o.efn_approval_state == 'approved' and o.efn_approved_by_id.name) or '(________________)'"/>
                    <td style="padding: 4px 4px 0; border-top: 1px solid #000;">(________________)</td>
                </tr>
            </table>
        </div>
    </template>

    <!-- Wrapper mandiri: tanpa web.html_container (tidak ada callback aset report.url yang bisa menahan
         wkhtmltopdf); <main> wajib untuk _prepare_html. -->
    <template id="report_efn_payment_voucher">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    @page { margin: 15mm; }
                    * { box-sizing: border-box; }
                    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; margin: 0; padding: 0; }
                </style>
            </head>
            <body>
                <main>
                    <t t-foreach="docs" t-as="o">
                        <div t-if="not o_first" style="page-break-before: always;"></div>
                        <t t-set="doc_title">PAYMENT VOUCHER</t>
                        <t t-call="efn_account_localization.report_efn_payment_document"/>
                    </t>
                </main>
            </body>
        </html>
    </template>

    <template id="report_efn_payment_receipt">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    @page { margin: 15mm; }
                    * { box-sizing: border-box; }
                    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; margin: 0; padding: 0; }
                </style>
            </head>
            <body>
                <main>
                    <t t-foreach="docs" t-as="o">
                        <div t-if="not o_first" style="page-break-before: always;"></div>
                        <t t-set="doc_title">PAYMENT RECEIPT</t>
                        <t t-call="efn_account_localization.report_efn_payment_document"/>
                    </t>
                </main>
            </body>
        </html>
    </template>
</odoo>
