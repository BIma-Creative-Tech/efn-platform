<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- G60-A: tanpa field `attachment` -> PDF tidak disimpan di filestore (filestore belum terenkripsi;
         lihat efn_pii_account README §Batasan). -->
    <record id="action_report_efn_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher (EFN)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">efn_account_localization.report_efn_payment_voucher</field>
        <field name="report_file">efn_account_localization.report_efn_payment_voucher</field>
        <field name="print_report_name">'Payment Voucher - %s' % (object.name or 'Draft')</field>
        <field name="paperformat_id" ref="paperformat_efn_voucher_landscape"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_efn_payment_receipt" model="ir.actions.report">
        <field name="name">Payment Receipt (EFN)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">efn_account_localization.report_efn_payment_receipt</field>
        <field name="report_file">efn_account_localization.report_efn_payment_receipt</field>
        <field name="print_report_name">'Payment Receipt - %s' % (object.name or 'Draft')</field>
        <field name="paperformat_id" ref="paperformat_efn_voucher_landscape"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
