<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_efn_approval" model="ir.ui.view">
        <field name="name">account.payment.form.efn.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="before">
                <button name="action_efn_request_approval" string="Minta Persetujuan" type="object" class="oe_highlight"
                        groups="account.group_account_invoice"
                        invisible="state != 'draft' or not efn_needs_approval or efn_approval_state not in ('not_required', 'rejected')"/>
                <button name="action_efn_approve" string="Setujui &amp; Konfirmasi" type="object" class="oe_highlight"
                        groups="account.group_account_manager"
                        invisible="state != 'draft' or efn_approval_state != 'to_approve'"/>
                <button name="action_efn_reject" string="Tolak" type="object"
                        groups="account.group_account_manager"
                        invisible="state != 'draft' or efn_approval_state != 'to_approve'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="efn_needs_approval" invisible="1"/>
                <group name="efn_approval" string="Persetujuan pembayaran (4-eyes)"
                       invisible="efn_approval_state == 'not_required' and not efn_needs_approval">
                    <group>
                        <field name="efn_approval_state" widget="badge"
                               decoration-warning="efn_approval_state == 'to_approve'"
                               decoration-success="efn_approval_state == 'approved'"
                               decoration-danger="efn_approval_state == 'rejected'"/>
                        <field name="efn_approval_requested_by_id"/>
                    </group>
                    <group>
                        <field name="efn_approved_by_id"/>
                        <field name="efn_approved_at"/>
                        <field name="efn_approval_note" readonly="state != 'draft'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_efn_payments_to_approve" model="ir.actions.act_window">
        <field name="name">Pembayaran Menunggu Persetujuan</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('efn_approval_state', '=', 'to_approve')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_efn_payments_to_approve"
              name="Pembayaran Menunggu Persetujuan"
              parent="account.menu_finance_payables"
              action="action_efn_payments_to_approve"
              sequence="25"
              groups="account.group_account_manager"/>
</odoo>
