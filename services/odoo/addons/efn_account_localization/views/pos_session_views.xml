<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_efn_mdr_moves" model="ir.actions.act_window">
        <field name="name">Jurnal MDR</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('efn_mdr_pos_session_id', '=', active_id)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_pos_session_form_efn_mdr" model="ir.ui.view">
        <field name="name">pos.session.form.efn.mdr</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(efn_account_localization.action_efn_mdr_moves)d" type="action"
                        class="oe_stat_button" icon="fa-percent"
                        groups="account.group_account_readonly,account.group_account_manager"
                        invisible="not efn_mdr_move_count">
                    <field name="efn_mdr_move_count" widget="statinfo" string="Jurnal MDR"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
