<?xml version="1.0" encoding="utf-8"?>
<!-- G50 (docs/04 §28.7): klaim outbox yang tidak di-ack BFF dalam 10 menit kembali antre; 5 percobaan -> gagal. -->
<odoo noupdate="1">
    <record id="ir_cron_efn_campaign_outbox_reclaim" model="ir.cron">
        <field name="name">EFN kampanye: klaim outbox kedaluwarsa kembali antre</field>
        <field name="model_id" ref="model_efn_campaign_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_efn_reclaim()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
