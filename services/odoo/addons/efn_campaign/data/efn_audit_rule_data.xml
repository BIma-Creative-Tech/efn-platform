<?xml version="1.0" encoding="utf-8"?>
<!-- G50: kampanye teraudit efn_audit (nilai lama/baru: mode voucher, program, kanal, state, approval_rev, penyetuju).
     partner_ids (mode terikat member) dikecualikan: nama member tidak disalin ke log audit (minimisasi PDP); kartu
     per partner tetap tercatat di loyalty.card. Outbox tidak diaudit (payload memuat kode voucher bearer). -->
<odoo>
    <record id="audit_rule_efn_campaign" model="efn.audit.rule">
        <field name="name">EFN - Kampanye tertarget</field>
        <field name="model_id" ref="model_efn_campaign"/>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="capture_unlink_values" eval="True"/>
        <field name="excluded_field_ids" eval="[(6, 0, [ref('field_efn_campaign__partner_ids')])]"/>
    </record>
</odoo>
