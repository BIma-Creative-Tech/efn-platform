<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Outbox event reservasi -> BFF: dipicu segera (_trigger) saat event dibuat; jadwal ini cadangan. -->
    <record id="ir_cron_efn_booking_outbox" model="ir.cron">
        <field name="name">EFN Reservasi: kirim event ke BFF</field>
        <field name="model_id" ref="model_efn_booking_event_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_efn_booking_outbox_run()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Reservasi 'menunggu konfirmasi' yang melewati jam mulai -> batal (kedaluwarsa). 'Tidak datang' = staf. -->
    <record id="ir_cron_efn_booking_expire" model="ir.cron">
        <field name="name">EFN Reservasi: kedaluwarsakan permintaan yang tidak dikonfirmasi</field>
        <field name="model_id" ref="model_efn_table_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_efn_booking_expire()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
