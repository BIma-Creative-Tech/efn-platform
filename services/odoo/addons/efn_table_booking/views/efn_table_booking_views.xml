<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Reservasi ================= -->
    <record id="efn_table_booking_view_list" model="ir.ui.view">
        <field name="name">efn.table.booking.list</field>
        <field name="model">efn.table.booking</field>
        <field name="arch" type="xml">
            <list string="Reservasi meja" decoration-muted="state in ('cancelled', 'no_show', 'done')" decoration-info="state == 'requested'">
                <field name="start_at"/>
                <field name="name"/>
                <field name="outlet_id"/>
                <field name="party_size"/>
                <field name="table_label"/>
                <field name="guest_label"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="efn_table_booking_view_calendar" model="ir.ui.view">
        <field name="name">efn.table.booking.calendar</field>
        <field name="model">efn.table.booking</field>
        <field name="arch" type="xml">
            <calendar string="Reservasi meja" date_start="start_at" date_stop="end_at" color="outlet_id" mode="day" quick_create="0">
                <field name="table_label"/>
                <field name="party_size"/>
                <field name="guest_label"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="efn_table_booking_view_form" model="ir.ui.view">
        <field name="name">efn.table.booking.form</field>
        <field name="model">efn.table.booking</field>
        <field name="arch" type="xml">
            <form string="Reservasi meja" create="0">
                <header>
                    <button name="action_efn_confirm" type="object" string="Konfirmasi" class="btn-primary" invisible="state != 'requested'" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_efn_seat" type="object" string="Tamu datang" invisible="state not in ('requested', 'confirmed')" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_efn_done" type="object" string="Selesai" invisible="state != 'seated'" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_efn_no_show" type="object" string="Tidak datang" invisible="state not in ('requested', 'confirmed')" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_efn_cancel" type="object" string="Batalkan" invisible="state not in ('requested', 'confirmed')" groups="point_of_sale.group_pos_manager"
                            confirm="Batalkan reservasi ini? Pelanggan akan diberi tahu."/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,confirmed,seated,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="outlet_id"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="party_size"/>
                            <field name="table_label"/>
                        </group>
                        <group>
                            <field name="guest_label"/>
                            <field name="note"/>
                            <field name="cancel_reason" invisible="not cancel_reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_table_booking_view_search" model="ir.ui.view">
        <field name="name">efn.table.booking.search</field>
        <field name="model">efn.table.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="outlet_id"/>
                <filter name="active_bookings" string="Aktif" domain="[('state', 'in', ('requested', 'confirmed', 'seated'))]"/>
                <filter name="need_confirm" string="Perlu konfirmasi" domain="[('state', '=', 'requested')]"/>
                <separator/>
                <filter name="today" string="Hari ini" domain="[('start_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('start_at', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_outlet" string="Outlet" context="{'group_by': 'outlet_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="efn_table_booking_action" model="ir.actions.act_window">
        <field name="name">Reservasi meja</field>
        <field name="res_model">efn.table.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_active_bookings': 1}</field>
    </record>

    <!-- ================= Pengaturan ================= -->
    <record id="efn_booking_settings_view_list" model="ir.ui.view">
        <field name="name">efn.booking.settings.list</field>
        <field name="model">efn.booking.settings</field>
        <field name="arch" type="xml">
            <list string="Pengaturan reservasi">
                <field name="outlet_id"/>
                <field name="pos_config_id"/>
                <field name="calendar_id"/>
                <field name="duration_minutes"/>
                <field name="max_party"/>
                <field name="confirm_mode"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="efn_booking_settings_view_form" model="ir.ui.view">
        <field name="name">efn.booking.settings.form</field>
        <field name="model">efn.booking.settings</field>
        <field name="arch" type="xml">
            <form string="Pengaturan reservasi">
                <sheet>
                    <group>
                        <group string="Outlet">
                            <field name="outlet_id"/>
                            <field name="pos_config_id"/>
                            <field name="calendar_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Aturan">
                            <field name="slot_minutes"/>
                            <field name="duration_minutes"/>
                            <field name="lead_minutes"/>
                            <field name="horizon_days"/>
                            <field name="min_party"/>
                            <field name="max_party"/>
                            <field name="confirm_mode"/>
                            <field name="hold_minutes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="efn_booking_settings_action" model="ir.actions.act_window">
        <field name="name">Pengaturan reservasi</field>
        <field name="res_model">efn.booking.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_efn_table_booking" name="Reservasi meja" parent="point_of_sale.menu_point_of_sale"
              action="efn_table_booking_action" sequence="30" groups="point_of_sale.group_pos_user"/>
    <menuitem id="menu_efn_booking_settings" name="Pengaturan reservasi" parent="point_of_sale.menu_point_config_product"
              action="efn_booking_settings_action" sequence="90" groups="point_of_sale.group_pos_manager"/>
</odoo>
