<?xml version="1.0" encoding="utf-8"?>
<!-- efn_expiry_monitor (docs/04 §28.5a, Q-SM4): grup Markdown Manager & Supervisor override kedaluwarsa POS,
     rule multi-company (global) + cakupan outlet kepala toko (stock user: warehouse_id ∈ efn_outlet_warehouse_ids)
     + semua outlet di company user untuk Markdown Manager / supervisor override / Inventory Administrator. -->
<odoo>
    <!-- G47 (fit-gap docs/fit-gap/G47_INSIGHT_SM.md §8): satu privilege per grup (widget hak akses Odoo 19 = satu
         pilihan per privilege + Command.set; supervisor yang juga Markdown Manager kehilangan satu grup saat form user
         disimpan). Hak efektif dan keanggotaan grup tidak berubah; xmlid privilege lama dipakai Markdown Manager. -->
    <record id="res_groups_privilege_efn_expiry" model="res.groups.privilege">
        <field name="name">EFN Kedaluwarsa: Markdown Manager</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">63</field>
        <field name="placeholder">–</field>
        <field name="description">Markdown per lot di semua outlet PT sampai batas diskon manager; override penerimaan lot umur pendek.</field>
    </record>
    <record id="res_groups_privilege_efn_expiry_override" model="res.groups.privilege">
        <field name="name">EFN Kedaluwarsa: Supervisor override POS</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">64</field>
        <field name="placeholder">–</field>
        <field name="description">Menyetujui penjualan lot kedaluwarsa di POS (PIN); baca alert/markdown semua outlet.</field>
    </record>
    <record id="group_markdown_manager" model="res.groups">
        <field name="name">Markdown Manager</field>
        <field name="comment">Membuat dan mengaktifkan markdown per lot di semua outlet PT-nya sampai batas diskon manager (default 90 %), menerima ringkasan near-expiry, dan meng-override penerimaan lot bersisa umur pendek (alasan wajib, teraudit).</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_expiry"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_expiry_override" model="res.groups">
        <field name="name">Supervisor override kedaluwarsa POS</field>
        <field name="comment">Boleh menyetujui penjualan lot kedaluwarsa / lewat removal date di POS (sendiri sebagai kasir, atau dengan PIN persetujuan untuk kasir lain). Setiap override dicatat saat sync order.</field>
        <field name="privilege_id" ref="res_groups_privilege_efn_expiry_override"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Global (tanpa grup): multi-company. -->
        <record id="efn_expiry_alert_rule_company" model="ir.rule">
            <field name="name">EFN alert kedaluwarsa: multi-company</field>
            <field name="model_id" ref="model_efn_expiry_alert"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="efn_lot_markdown_rule_company" model="ir.rule">
            <field name="name">EFN markdown lot: multi-company</field>
            <field name="model_id" ref="model_efn_lot_markdown"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="efn_expiry_event_rule_company" model="ir.rule">
            <field name="name">EFN kejadian kedaluwarsa: multi-company</field>
            <field name="model_id" ref="model_efn_expiry_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="efn_expiry_pos_approval_rule_company" model="ir.rule">
            <field name="name">EFN persetujuan override POS: multi-company</field>
            <field name="model_id" ref="model_efn_expiry_pos_approval"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Cakupan outlet: kepala toko (stock user) hanya outlet di efn_outlet_warehouse_ids. -->
        <record id="efn_expiry_alert_rule_outlet" model="ir.rule">
            <field name="name">EFN alert kedaluwarsa: outlet kepala toko</field>
            <field name="model_id" ref="model_efn_expiry_alert"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="domain_force">[('warehouse_id', 'in', user.efn_outlet_warehouse_ids.ids)]</field>
        </record>
        <record id="efn_lot_markdown_rule_outlet" model="ir.rule">
            <field name="name">EFN markdown lot: outlet kepala toko</field>
            <field name="model_id" ref="model_efn_lot_markdown"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="domain_force">[('warehouse_id', 'in', user.efn_outlet_warehouse_ids.ids)]</field>
        </record>
        <!-- Semua outlet di company user (company dibatasi rule global di atas): tulis penuh hanya Markdown Manager
             dan Inventory Administrator. SEC-218: supervisor override hanya BACA semua outlet (rule terpisah, perm_read
             saja); bila ia juga stock user, tulis tetap terbatas outlet di efn_outlet_warehouse_ids. DB lama:
             migrations/19.0.1.1.0 mencabut grup override dari rule *_all_outlets (data noupdate). -->
        <record id="efn_expiry_alert_rule_all_outlets" model="ir.rule">
            <field name="name">EFN alert kedaluwarsa: semua outlet (Markdown Manager / Inventory Admin)</field>
            <field name="model_id" ref="model_efn_expiry_alert"/>
            <field name="groups" eval="[(4, ref('group_markdown_manager')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="efn_lot_markdown_rule_all_outlets" model="ir.rule">
            <field name="name">EFN markdown lot: semua outlet (Markdown Manager / Inventory Admin)</field>
            <field name="model_id" ref="model_efn_lot_markdown"/>
            <field name="groups" eval="[(4, ref('group_markdown_manager')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="efn_expiry_alert_rule_override_read" model="ir.rule">
            <field name="name">EFN alert kedaluwarsa: supervisor override baca semua outlet</field>
            <field name="model_id" ref="model_efn_expiry_alert"/>
            <field name="groups" eval="[(4, ref('group_expiry_override'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="efn_lot_markdown_rule_override_read" model="ir.rule">
            <field name="name">EFN markdown lot: supervisor override baca semua outlet</field>
            <field name="model_id" ref="model_efn_lot_markdown"/>
            <field name="groups" eval="[(4, ref('group_expiry_override'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
