<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- docs/04 §28.10: default false di semua env; menyalakan butuh ambang per kategori terisi (Q-SM28/Q-SM9).
             Hanya nilai persis "true"/"1" yang menyalakan. -->
        <record id="param_enabled" model="ir.config_parameter">
            <field name="key">efn_expiry_monitor.enabled</field>
            <field name="value">false</field>
        </record>
        <!-- Q-SM4 (default sampai klien menjawab): batas diskon efektif per peran (%). -->
        <record id="param_max_discount_store_head" model="ir.config_parameter">
            <field name="key">efn_expiry_monitor.max_discount_store_head</field>
            <field name="value">50</field>
        </record>
        <record id="param_max_discount_markdown_manager" model="ir.config_parameter">
            <field name="key">efn_expiry_monitor.max_discount_markdown_manager</field>
            <field name="value">90</field>
        </record>

        <record id="ir_cron_efn_expiry_scan" model="ir.cron">
            <field name="name">EFN expiry: alert near-expiry harian + markdown berakhir</field>
            <field name="model_id" ref="model_efn_expiry_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_efn_expiry_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
