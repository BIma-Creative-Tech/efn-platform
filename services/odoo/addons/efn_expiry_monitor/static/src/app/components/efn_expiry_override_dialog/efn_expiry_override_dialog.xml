<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="efn_expiry_monitor.EfnExpiryOverrideDialog">
        <Dialog title="props.title" size="'md'">
            <p class="efn-expiry-override-body">
                Lot <strong t-esc="props.lotName"/> sudah kedaluwarsa / melewati batas jual. Penjualan hanya boleh
                dengan persetujuan supervisor. PIN diketik sendiri oleh supervisor.
            </p>
            <div class="mb-3">
                <label class="form-label" for="efn_expiry_approver">Supervisor</label>
                <select id="efn_expiry_approver" class="form-select efn-expiry-approver" t-model="state.approverId">
                    <t t-foreach="props.approvers" t-as="approver" t-key="approver.id">
                        <option t-att-value="approver.id" t-esc="approver.name"/>
                    </t>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="efn_expiry_pin">PIN supervisor</label>
                <input id="efn_expiry_pin" type="password" inputmode="numeric" autocomplete="off" maxlength="8"
                       class="form-control efn-expiry-pin" t-model="state.pin"/>
            </div>
            <div class="mb-3">
                <label class="form-label" for="efn_expiry_reason">Alasan</label>
                <input id="efn_expiry_reason" type="text" maxlength="200" autocomplete="off"
                       class="form-control efn-expiry-reason" t-model="state.reason"
                       placeholder="Mis. dijual untuk pakan ternak sesuai SOP — tanpa data pelanggan"/>
            </div>
            <div t-if="state.error" class="alert alert-danger efn-expiry-error" role="alert" t-esc="state.error"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg efn-expiry-approve" t-att-disabled="!canSubmit"
                        t-on-click="confirm">Setujui</button>
                <button class="btn btn-secondary btn-lg lh-lg" t-on-click="props.close">Batal</button>
            </t>
        </Dialog>
    </t>
</templates>
